    private async Task OnPointerDown(PointerEventArgs e)
    {
        // Ensure container has focus for keyboard shortcuts
        await containerElement.FocusAsync();

        // Update SVG scale info in case window was resized
        await UpdateSvgScaleInfo();

        // Update input hint based on pointer type
        InputHint = $"{GetPointerType(e)} active";
        CurrentPressure = e.Pressure > 0 ? e.Pressure : 1.0;

        // Transform pointer coordinates from element space to SVG viewBox space
        var (px, py) = TransformToSvgCoords(e.OffsetX, e.OffsetY);

        // Handle selection tool
        if (CurrentTool == DrawingTool.Select)
        {
            var clickX = px;
            var clickY = py;

            // Check if clicking on a resize handle (works for single or group selection)
            if (SelectedElements.Count > 0)
            {
                var handle = GetResizeHandleAt(clickX, clickY);
                if (handle != null)
                {
                    SaveUndoState();
                    IsResizing = true;
                    ResizeHandle = handle;
                    DragStart = new Point(clickX, clickY);
                    OriginalBounds = GetGroupBounds();
                    // Store original bounds and snapshots for each element (for group scaling)
                    OriginalElementBounds = SelectedElements.ToDictionary(el => el.Id, el => el.GetBounds());
                    OriginalElementSnapshots = SelectedElements
                        .Select(el => (el.Id, Clone: CloneElement(el)))
                        .Where(x => x.Clone != null)
                        .ToDictionary(x => x.Id, x => x.Clone!);
                    if (SelectedElements.Count == 1)
                    {
                        OriginalElementSnapshot = CloneElement(SelectedElements[0]);
                    }
                    return;
                }
            }

            // Check if clicking on an already-selected element (for moving)
            if (SelectedElements.Count > 0)
            {
                foreach (var sel in SelectedElements)
                {
                    if (sel.HitTest(clickX, clickY))
                    {
                        // Start moving
                        SaveUndoState();
                        IsMoving = true;
                        MoveTotalDeltaX = 0;
                        MoveTotalDeltaY = 0;
                        DragStart = new Point(clickX, clickY);
                        return;
                    }
                }
            }

            // Try to hit-test an element (reverse order for top-most first, skip locked layers)
            VectorElement? hitElement = null;
            for (int i = Layers.Count - 1; i >= 0; i--)
            {
                var layer = Layers[i];
                if (!layer.IsVisible || layer.IsLocked) continue;

                for (int j = layer.Elements.Count - 1; j >= 0; j--)
                {
                    if (layer.Elements[j].HitTest(clickX, clickY))
                    {
                        hitElement = layer.Elements[j];
                        break;
                    }
                }
                if (hitElement != null) break;
            }

            if (hitElement != null)
            {
                // If not holding shift, clear previous selection
                if (!e.ShiftKey)
                    ClearSelection();

                hitElement.IsSelected = !hitElement.IsSelected;
                if (hitElement.IsSelected)
                {
                    SelectedElements.Add(hitElement);
                    // Also select all elements in the same group
                    SelectGroupMembers(hitElement);
                }
                else
                {
                    SelectedElements.Remove(hitElement);
                }

                UpdateSelectionHint();

                // Start moving immediately after selecting
                if (hitElement.IsSelected)
                {
                    SaveUndoState();
                    IsMoving = true;
                    MoveTotalDeltaX = 0;
                    MoveTotalDeltaY = 0;
                    DragStart = new Point(clickX, clickY);
                }
            }
            else
            {
                // Start area selection
                if (!e.ShiftKey)
                    ClearSelection();
                IsSelecting = true;
                SelectionStart = new Point(clickX, clickY);
                SelectionEnd = SelectionStart;
            }
            return;
        }

        // Don't allow drawing on locked layers
        if (CurrentLayer.IsLocked)
        {
            InputHint = "Layer is locked - unlock to draw";
            return;
        }

        // Handle text tool - show input modal
        if (CurrentTool == DrawingTool.Text)
        {
            TextPosition = new Point(px, py);
            TextInputValue = "";
            ShowTextInput = true;
            return;
        }

        // Handle arc tool - 3-click mode: Start → End → Middle
        if (CurrentTool == DrawingTool.Arc)
        {
            if (ArcClickPhase == 0)
            {
                // First click - start point (use chain point if available)
                if (ChainMode && ChainLastPoint != null)
                {
                    ArcStartX = ChainLastPoint.X;
                    ArcStartY = ChainLastPoint.Y;
                }
                else
                {
                    ArcStartX = px;
                    ArcStartY = py;
                    if (ChainMode && ChainStartPoint == null)
                        ChainStartPoint = new Point(ArcStartX, ArcStartY);
                }
                ArcClickPhase = 1;
                InputHint = "Arc: Click END point";
                StateHasChanged();
                return;
            }
            else if (ArcClickPhase == 1)
            {
                // Second click - end point
                ArcEndX = px;
                ArcEndY = py;
                ArcClickPhase = 2;
                // Set initial mid point to midpoint of line (will update on mouse move)
                ArcMidX = (ArcStartX + ArcEndX) / 2;
                ArcMidY = (ArcStartY + ArcEndY) / 2;
                InputHint = "Arc: Click MIDDLE point (curve bends through here)";
                StateHasChanged();
                return;
            }
            else if (ArcClickPhase == 2)
            {
                // Third click - middle/control point, finalize
                SaveUndoState();
                var arc = new ArcElement
                {
                    X1 = ArcStartX, Y1 = ArcStartY,
                    MidX = px, MidY = py,
                    X2 = ArcEndX, Y2 = ArcEndY,
                    ShowArrow = ArcShowArrow,
                    Stroke = StrokeColor, StrokeWidth = StrokeWidth
                };
                CurrentLayer.Elements.Add(arc);
                RecordAction(ActionType.CreateElement, arc);

                // Update chain mode endpoint
                if (ChainMode)
                    ChainLastPoint = new Point(arc.X2, arc.Y2);

                ArcClickPhase = 0;
                InputHint = ChainMode ? "Arc: Click START (chained from end)" : "Arc: Click START point";
                StateHasChanged();
                return;
            }
        }

        IsDrawing = true;

        // Chain mode: use last endpoint as start, or clicked point for first element
        double startX, startY;
        if (ChainMode && ChainLastPoint != null)
        {
            startX = ChainLastPoint.X;
            startY = ChainLastPoint.Y;
        }
        else
        {
            startX = px;
            startY = py;
            // Record the original start point for closing the chain
            if (ChainMode && ChainStartPoint == null)
            {
                ChainStartPoint = new Point(startX, startY);
            }
        }
        StartPoint = new Point(startX, startY);

        CurrentElement = CurrentTool switch
        {
            DrawingTool.Line => new LineElement
            {
                X1 = startX, Y1 = startY,
                X2 = px, Y2 = py,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth
            },
            DrawingTool.Pencil => new PathElement
            {
                Points = new List<Point> { StartPoint },
                Stroke = StrokeColor,
                StrokeWidth = StrokeWidth * CurrentPressure, // Apply pressure
                Pressure = CurrentPressure
            },
            DrawingTool.Rectangle => new RectElement
            {
                X = startX, Y = startY,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth, Fill = GetFill()
            },
            DrawingTool.Circle => new CircleElement
            {
                Cx = startX, Cy = startY,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth, Fill = GetFill()
            },
            DrawingTool.Ellipse => new EllipseElement
            {
                Cx = startX, Cy = startY,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth, Fill = GetFill()
            },
            DrawingTool.Triangle => new TriangleElement
            {
                X1 = startX, Y1 = startY,
                X2 = startX, Y2 = startY,
                X3 = startX, Y3 = startY,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth, Fill = GetFill()
            },
            DrawingTool.Polygon => new PolygonElement
            {
                Cx = startX, Cy = startY,
                Sides = PolygonSides,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth, Fill = GetFill()
            },
            DrawingTool.Star => new StarElement
            {
                Cx = startX, Cy = startY,
                Points = StarPoints,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth, Fill = GetFill()
            },
            DrawingTool.Arrow => new ArrowElement
            {
                X1 = startX, Y1 = startY,
                X2 = px, Y2 = py,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth
            },
            _ => null
        };
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        // Transform pointer coordinates from element space to SVG viewBox space
        var (px, py) = TransformToSvgCoords(e.OffsetX, e.OffsetY);

        // Update arc preview position
        if (CurrentTool == DrawingTool.Arc && ArcClickPhase > 0)
        {
            ArcPreviewX = px;
            ArcPreviewY = py;
            if (ArcClickPhase == 2)
            {
                // Update mid point to follow mouse
                ArcMidX = px;
                ArcMidY = py;
            }
            StateHasChanged();
        }

        // Handle moving selected elements
        if (IsMoving && DragStart != null)
        {
            var dx = px - DragStart.X;
            var dy = py - DragStart.Y;
            MoveTotalDeltaX += dx;
            MoveTotalDeltaY += dy;

            // Collect all elements to move (selected + their group members)
            var elementsToMove = new HashSet<VectorElement>(SelectedElements);
            foreach (var sel in SelectedElements)
            {
                if (!string.IsNullOrEmpty(sel.GroupId))
                {
                    foreach (var layer in Layers)
                    {
                        foreach (var el in layer.Elements)
                        {
                            if (el.GroupId == sel.GroupId)
                                elementsToMove.Add(el);
                        }
                    }
                }
            }

            foreach (var el in elementsToMove)
                MoveElement(el, dx, dy);
            DragStart = new Point(px, py);
            return;
        }

        // Handle resizing (single or group)
        if (IsResizing && DragStart != null && OriginalBounds != null && SelectedElements.Count > 0)
        {
            if (SelectedElements.Count == 1)
            {
                ResizeElement(SelectedElements[0], px, py);
            }
            else
            {
                ResizeGroup(px, py);
            }
            return;
        }

        // Handle area selection
        if (IsSelecting && SelectionStart != null)
        {
            SelectionEnd = new Point(px, py);
            return;
        }

        if (!IsDrawing || CurrentElement == null || StartPoint == null) return;

        // Update pressure for pen input
        if (e.Pressure > 0)
            CurrentPressure = e.Pressure;

        switch (CurrentElement)
        {
            case LineElement line:
                line.X2 = px;
                line.Y2 = py;
                break;
            case PathElement path:
                path.Points.Add(new Point(px, py));
                // Optionally adjust stroke width based on pressure for pen
                if (e.PointerType == "pen" && e.Pressure > 0)
                {
                    path.StrokeWidth = StrokeWidth * e.Pressure;
                }
                break;
            case RectElement rect:
                rect.X = Math.Min(StartPoint.X, px);
                rect.Y = Math.Min(StartPoint.Y, py);
                rect.Width = Math.Abs(px - StartPoint.X);
                rect.Height = Math.Abs(py - StartPoint.Y);
                break;
            case CircleElement circle:
                var dx = px - StartPoint.X;
                var dy = py - StartPoint.Y;
                circle.Radius = Math.Sqrt(dx * dx + dy * dy);
                break;
            case EllipseElement ellipse:
                ellipse.Cx = (StartPoint.X + px) / 2;
                ellipse.Cy = (StartPoint.Y + py) / 2;
                ellipse.Rx = Math.Abs(px - StartPoint.X) / 2;
                ellipse.Ry = Math.Abs(py - StartPoint.Y) / 2;
                break;
            case TriangleElement triangle:
                // Isoceles triangle: base at bottom, apex at top center
                var midX = (StartPoint.X + px) / 2;
                triangle.X1 = midX; // Top apex
                triangle.Y1 = Math.Min(StartPoint.Y, py);
                triangle.X2 = StartPoint.X; // Bottom left
                triangle.Y2 = Math.Max(StartPoint.Y, py);
                triangle.X3 = px; // Bottom right
                triangle.Y3 = Math.Max(StartPoint.Y, py);
                break;
            case PolygonElement polygon:
                var pdx = px - StartPoint.X;
                var pdy = py - StartPoint.Y;
                polygon.Radius = Math.Sqrt(pdx * pdx + pdy * pdy);
                break;
            case StarElement star:
                var sdx = px - StartPoint.X;
                var sdy = py - StartPoint.Y;
                star.OuterRadius = Math.Sqrt(sdx * sdx + sdy * sdy);
                star.InnerRadius = star.OuterRadius * 0.4;
                break;
            case ArrowElement arrow:
                arrow.X2 = px;
                arrow.Y2 = py;
                var length = Math.Sqrt(Math.Pow(arrow.X2 - arrow.X1, 2) + Math.Pow(arrow.Y2 - arrow.Y1, 2));
                arrow.HeadSize = Math.Max(10, Math.Min(25, length * 0.15));
                break;
            // Arc uses direct SVG preview, not CurrentElement
        }
    }

    private void OnPointerUp(PointerEventArgs e)
    {
        // Update hint based on selection state, not just "ready"
        if (SelectedElements.Count > 0)
            UpdateSelectionHint();
        else
            InputHint = $"{GetPointerType(e)} ready";

        // Finish moving
        if (IsMoving)
        {
            // Record the move for all selected elements
            if (Math.Abs(MoveTotalDeltaX) > 0.1 || Math.Abs(MoveTotalDeltaY) > 0.1)
            {
                foreach (var el in SelectedElements)
                {
                    RecordAction(ActionType.MoveElement, el, deltaX: MoveTotalDeltaX, deltaY: MoveTotalDeltaY);
                }
            }
            IsMoving = false;
            DragStart = null;
            return;
        }

        // Finish resizing
        if (IsResizing)
        {
            IsResizing = false;
            DragStart = null;
            ResizeHandle = null;
            OriginalBounds = null;
            OriginalElementSnapshot = null;
            OriginalElementBounds = null;
            OriginalElementSnapshots = null;
            return;
        }

        // Finish area selection (skip locked layers)
        if (IsSelecting && SelectionStart != null && SelectionEnd != null)
        {
            var x = Math.Min(SelectionStart.X, SelectionEnd.X);
            var y = Math.Min(SelectionStart.Y, SelectionEnd.Y);
            var w = Math.Abs(SelectionEnd.X - SelectionStart.X);
            var h = Math.Abs(SelectionEnd.Y - SelectionStart.Y);

            int selectedCount = 0;
            int checkedCount = 0;
            int layerCount = 0;

            // Log selection rectangle for debugging
            _ = JS.InvokeVoidAsync("console.log", $"Selection: start=({SelectionStart.X:F2},{SelectionStart.Y:F2}) end=({SelectionEnd.X:F2},{SelectionEnd.Y:F2}) rect=({x:F2},{y:F2}) size={w:F2}x{h:F2}");

            // Check all layers that are visible and unlocked
            foreach (var layer in Layers)
            {
                // Skip invisible or locked layers
                if (!layer.IsVisible || layer.IsLocked)
                {
                    _ = JS.InvokeVoidAsync("console.log", $"  Skipping layer '{layer.Name}' - visible:{layer.IsVisible} locked:{layer.IsLocked}");
                    continue;
                }

                layerCount++;
                _ = JS.InvokeVoidAsync("console.log", $"  Checking layer '{layer.Name}' with {layer.Elements.Count} elements");

                foreach (var el in layer.Elements)
                {
                    checkedCount++;
                    var bounds = el.GetBounds();
                    var intersects = el.IntersectsRect(x, y, w, h);

                    if (intersects || checkedCount <= 5) // Log first 5 and all intersecting
                        _ = JS.InvokeVoidAsync("console.log", $"    {el.GetType().Name}: bounds=({bounds.X:F2},{bounds.Y:F2},{bounds.Width:F2},{bounds.Height:F2}) intersects={intersects}");

                    // Check if element intersects with selection rectangle
                    if (intersects)
                    {
                        if (!el.IsSelected)
                        {
                            el.IsSelected = true;
                            SelectedElements.Add(el);
                            selectedCount++;
                        }
                    }
                }
            }

            _ = JS.InvokeVoidAsync("console.log", $"Area select: {selectedCount} of {checkedCount} elements in {layerCount} layers");
            UpdateSelectionHint();
            IsSelecting = false;
            SelectionStart = null;
            SelectionEnd = null;
            return;
        }

        if (IsDrawing && CurrentElement != null)
        {
            SaveUndoState();
            CurrentLayer.Elements.Add(CurrentElement);
            RecordAction(ActionType.CreateElement, CurrentElement);

            // Array mode: create additional copies
            if (ArrayMode && ArrayCount > 1)
            {
                for (int i = 1; i < ArrayCount; i++)
                {
                    var clone = CloneElement(CurrentElement);
                    if (clone != null)
                    {
                        double offsetX = ArrayHorizontal ? i * ArraySpacing : 0;
                        double offsetY = ArrayHorizontal ? 0 : i * ArraySpacing;
                        MoveElement(clone, offsetX, offsetY);
                        CurrentLayer.Elements.Add(clone);
                        RecordAction(ActionType.CreateElement, clone);
                    }
                }
            }

            // Chain mode: continue from endpoint
            if (ChainMode)
            {
                var endpoint = GetElementEndpoint(CurrentElement);
                if (endpoint != null)
                {
                    // Check if clicked near start point to close the chain
                    if (ChainStartPoint != null && IsNearPoint(endpoint.X, endpoint.Y, ChainStartPoint.X, ChainStartPoint.Y))
                    {
                        EndChainMode();
                    }
                    else
                    {
                        ChainLastPoint = endpoint;
                    }
                }
            }

            CurrentElement = null;
        }
        IsDrawing = false;
        StartPoint = null;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        // Don't handle shortcuts if in text input
        if (ShowTextInput) return;

        // Handle Ctrl shortcuts
        if (e.CtrlKey)
        {
            switch (e.Key.ToLower())
            {
                case "d":
                case "v": DuplicateSelected(); break; // Ctrl+D or Ctrl+V = duplicate selected
                case "z": OnUndoClick(); StateHasChanged(); break;
                case "a": SelectAll(); break; // Ctrl+A = select all
            }
            return;
        }

        // Tool shortcuts (single key)
        switch (e.Key.ToLower())
        {
            case "s": CurrentToolIndex = 0; ChainMode = false; break; // Select
            case "l": CurrentToolIndex = 1; break; // Line
            case "p": CurrentToolIndex = 2; break; // Pencil
            case "r": CurrentToolIndex = 3; break; // Rectangle
            case "c": CurrentToolIndex = 4; break; // Circle
            case "e": CurrentToolIndex = 5; break; // Ellipse
            case "t": CurrentToolIndex = 6; break; // Triangle
            case "g": CurrentToolIndex = 7; break; // polyGon
            // Star has no shortcut (use toolbar)
            case "a": CurrentToolIndex = 9; break; // Arrow
            case "u": CurrentToolIndex = 10; ArcClickPhase = 0; break; // arcU (curve)
            case "x": CurrentToolIndex = 11; break; // teXt
            case "k":
                // Chain mode toggle
                ChainMode = !ChainMode;
                if (ChainMode)
                {
                    ChainStartPoint = null;
                    ChainLastPoint = null;
                    InputHint = "Chain mode ON - click to start, clicks continue from endpoint, click start or ESC to end";
                }
                else
                {
                    EndChainMode();
                }
                break;
            case "delete":
            case "backspace":
                DeleteSelected();
                break;
            case "escape":
                // Cancel arc drawing
                if (ArcClickPhase > 0)
                {
                    ArcClickPhase = 0;
                    InputHint = "Arc cancelled";
                }
                else if (ChainMode)
                {
                    EndChainMode();
                }
                else if (IsDrawing)
                {
                    // Cancel current drawing operation
                    IsDrawing = false;
                    StartPoint = null;
                    CurrentElement = null;
                    InputHint = "Drawing cancelled";
                }
                else
                {
                    ClearSelection();
                }
                break;
        }
        StateHasChanged();
    }

    private void SelectAll()
    {
        foreach (var el in SelectedElements)
            el.IsSelected = false;
        SelectedElements.Clear();

        foreach (var layer in Layers.Where(l => l.IsVisible && !l.IsLocked))
        {
            foreach (var el in layer.Elements)
            {
                el.IsSelected = true;
                SelectedElements.Add(el);
            }
        }
        UpdateSelectionHint();
    }

    private void ClearSelection()
    {
        foreach (var el in SelectedElements)
            el.IsSelected = false;
        SelectedElements.Clear();
        InputHint = "Selection cleared";
    }

    private void UpdateSelectionHint()
    {
        if (SelectedElements.Count == 0)
        {
            InputHint = "Nothing selected";
            return;
        }

        // Count elements by type
        var counts = SelectedElements
            .GroupBy(el => el.GetType().Name.Replace("Element", "").ToLower())
            .Select(g => $"{g.Count()} {g.Key}{(g.Count() > 1 ? "s" : "")}")
            .ToList();

        InputHint = $"Selected: {string.Join(", ", counts)}";
    }

    private void DeleteSelected()
    {
        if (SelectedElements.Count == 0) return;
        SaveUndoState();
        foreach (var el in SelectedElements)
        {
            RecordAction(ActionType.DeleteElement, el);
            // Remove from whichever layer contains it
            foreach (var layer in Layers)
                layer.Elements.Remove(el);
        }
        SelectedElements.Clear();
    }

    private void ToggleChainMode()
    {
        ChainMode = !ChainMode;
        if (ChainMode)
        {
            ChainStartPoint = null;
            ChainLastPoint = null;
            InputHint = "Chain mode ON - click to start, clicks continue from endpoint, click start or ESC to end";
        }
        else
        {
            EndChainMode();
        }
    }

    private void EndChainMode()
    {
        ChainMode = false;
        ChainStartPoint = null;
        ChainLastPoint = null;
        InputHint = "Chain mode OFF";
    }

    private bool IsNearPoint(double x1, double y1, double x2, double y2, double threshold = 10)
    {
        return Math.Abs(x1 - x2) < threshold && Math.Abs(y1 - y2) < threshold;
    }

    private Point? GetElementEndpoint(VectorElement el)
    {
        return el switch
        {
            LineElement line => new Point(line.X2, line.Y2),
            ArrowElement arrow => new Point(arrow.X2, arrow.Y2),
            ArcElement arc => new Point(arc.X2, arc.Y2),
            PathElement path => path.Points.LastOrDefault(),
            RectElement rect => new Point(rect.X + rect.Width, rect.Y + rect.Height),
            CircleElement circle => new Point(circle.Cx + circle.Radius, circle.Cy),
            EllipseElement ellipse => new Point(ellipse.Cx + ellipse.Rx, ellipse.Cy),
            TriangleElement tri => new Point(tri.X3, tri.Y3),
            PolygonElement poly => new Point(poly.Cx + poly.Radius, poly.Cy),
            StarElement star => new Point(star.Cx + star.OuterRadius, star.Cy),
            _ => null
        };
    }

    private void CloseTextInput()
    {
        ShowTextInput = false;
        TextInputValue = "";
        TextPosition = null;
    }

    private void ConfirmTextInput()
    {
        if (!string.IsNullOrWhiteSpace(TextInputValue) && TextPosition != null)
        {
            var textElement = new TextElement
            {
                X = TextPosition.X,
                Y = TextPosition.Y,
                Text = TextInputValue,
                FontSize = FontSize,
                Fill = UseFill ? FillColor : StrokeColor,
                Stroke = StrokeColor,
                StrokeWidth = StrokeWidth > 2 ? 0.5 : 0
            };
            CurrentLayer.Elements.Add(textElement);
        }
        CloseTextInput();
    }

    // Helper to check if point is on a resize handle (works for single or group selection)
    private string? GetResizeHandleAt(double x, double y)
    {
        if (SelectedElements.Count == 0) return null;
        var b = GetGroupBounds(); // Use group bounds for both single and multi-selection
        var handleSize = 12; // Slightly larger hit area
        var hs = handleSize / 2.0;

        // Check corners
        if (IsInRect(x, y, b.X - 4 - hs, b.Y - 4 - hs, handleSize, handleSize)) return "nw";
        if (IsInRect(x, y, b.X + b.Width + 4 - hs, b.Y - 4 - hs, handleSize, handleSize)) return "ne";
        if (IsInRect(x, y, b.X - 4 - hs, b.Y + b.Height + 4 - hs, handleSize, handleSize)) return "sw";
        if (IsInRect(x, y, b.X + b.Width + 4 - hs, b.Y + b.Height + 4 - hs, handleSize, handleSize)) return "se";
        // Check edges
        if (IsInRect(x, y, b.X + b.Width / 2 - hs, b.Y - 4 - hs, handleSize, handleSize)) return "n";
        if (IsInRect(x, y, b.X + b.Width / 2 - hs, b.Y + b.Height + 4 - hs, handleSize, handleSize)) return "s";
        if (IsInRect(x, y, b.X - 4 - hs, b.Y + b.Height / 2 - hs, handleSize, handleSize)) return "w";
        if (IsInRect(x, y, b.X + b.Width + 4 - hs, b.Y + b.Height / 2 - hs, handleSize, handleSize)) return "e";
        return null;
    }

    private bool IsInRect(double px, double py, double rx, double ry, double rw, double rh) =>
        px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;

    // Helper to get combined bounding box of all selected elements
    private BoundingBox GetGroupBounds()
    {
        if (SelectedElements.Count == 0) return new BoundingBox(0, 0, 0, 0);
        if (SelectedElements.Count == 1) return SelectedElements[0].GetBounds();

        double minX = double.MaxValue, minY = double.MaxValue;
        double maxX = double.MinValue, maxY = double.MinValue;

        foreach (var el in SelectedElements)
        {
            var b = el.GetBounds();
            minX = Math.Min(minX, b.X);
            minY = Math.Min(minY, b.Y);
            maxX = Math.Max(maxX, b.X + b.Width);
            maxY = Math.Max(maxY, b.Y + b.Height);
        }

        return new BoundingBox(minX, minY, maxX - minX, maxY - minY);
    }

    // Move element by delta
    private void MoveElement(VectorElement el, double dx, double dy)
    {
        switch (el)
        {
            case LineElement line:
                line.X1 += dx; line.Y1 += dy;
                line.X2 += dx; line.Y2 += dy;
                break;
            case PathElement path:
                path.Points = path.Points.Select(p => new Point(p.X + dx, p.Y + dy)).ToList();
                break;
            case RectElement rect:
                rect.X += dx; rect.Y += dy;
                break;
            case CircleElement circle:
                circle.Cx += dx; circle.Cy += dy;
                break;
            case EllipseElement ellipse:
                ellipse.Cx += dx; ellipse.Cy += dy;
                break;
            case TriangleElement tri:
                tri.X1 += dx; tri.Y1 += dy;
                tri.X2 += dx; tri.Y2 += dy;
                tri.X3 += dx; tri.Y3 += dy;
                break;
            case PolygonElement poly:
                poly.Cx += dx; poly.Cy += dy;
                break;
            case StarElement star:
                star.Cx += dx; star.Cy += dy;
                break;
            case ArrowElement arrow:
                arrow.X1 += dx; arrow.Y1 += dy;
                arrow.X2 += dx; arrow.Y2 += dy;
                break;
            case ImageElement img:
                img.X += dx; img.Y += dy;
                break;
            case TextElement txt:
                txt.X += dx; txt.Y += dy;
                break;
            case SvgPathElement svgPath:
                // Translate the SVG path D attribute
                svgPath.D = TranslateSvgPath(svgPath.D, dx, dy);
                break;
        }
    }

    // Translate all coordinates in an SVG path by (dx, dy)
    // Handles common commands: M, L, H, V, C, S, Q, T, A, Z
    private string TranslateSvgPath(string d, double dx, double dy)
    {
        if (string.IsNullOrEmpty(d)) return d;

        // Use regex to extract commands and numbers
        var pattern = @"([MLHVCSQTAZmlhvcsqtaz])|(-?[\d.]+)";
        var matches = System.Text.RegularExpressions.Regex.Matches(d, pattern);

        var result = new System.Text.StringBuilder();
        char currentCmd = ' ';
        int numIndex = 0;  // Number index within current command

        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            var token = match.Value;

            if (token.Length == 1 && char.IsLetter(token[0]))
            {
                // It's a command
                currentCmd = token[0];
                numIndex = 0;
                result.Append(token);
            }
            else if (double.TryParse(token, System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var num))
            {
                // It's a number - decide whether to translate and how to format
                var translated = num;
                var upperCmd = char.ToUpper(currentCmd);
                bool isArcFlag = false;  // Arc flags must be integers (0 or 1)

                switch (upperCmd)
                {
                    case 'M': // M x y
                    case 'L': // L x y
                    case 'T': // T x y
                        translated = num + (numIndex % 2 == 0 ? dx : dy);
                        break;
                    case 'H': // H x
                        translated = num + dx;
                        break;
                    case 'V': // V y
                        translated = num + dy;
                        break;
                    case 'C': // C x1 y1 x2 y2 x y
                    case 'S': // S x2 y2 x y
                    case 'Q': // Q x1 y1 x y
                        translated = num + (numIndex % 2 == 0 ? dx : dy);
                        break;
                    case 'A': // A rx ry rotation large-arc sweep x y
                        // Indices 3 and 4 are flags (must stay as integers)
                        // Indices 5 and 6 are x, y (translate these)
                        var arcIdx = numIndex % 7;
                        if (arcIdx == 3 || arcIdx == 4)
                            isArcFlag = true;
                        else if (arcIdx == 5)
                            translated = num + dx;
                        else if (arcIdx == 6)
                            translated = num + dy;
                        break;
                    // Z has no numbers
                }

                result.Append(" ");
                if (isArcFlag)
                    result.Append(((int)translated).ToString());  // Keep flags as integers
                else
                    result.Append(translated.ToString("F2", System.Globalization.CultureInfo.InvariantCulture));
                numIndex++;
            }
        }

        return result.ToString();
    }

    // Resize element based on handle being dragged
    private void ResizeElement(VectorElement el, double mouseX, double mouseY)
    {
        if (DragStart == null || OriginalBounds == null || ResizeHandle == null) return;

        var ob = OriginalBounds;
        var dx = mouseX - DragStart.X;
        var dy = mouseY - DragStart.Y;

        double newX = ob.X, newY = ob.Y, newW = ob.Width, newH = ob.Height;

        // Calculate new bounds based on handle
        switch (ResizeHandle)
        {
            case "nw": newX = ob.X + dx; newY = ob.Y + dy; newW = ob.Width - dx; newH = ob.Height - dy; break;
            case "ne": newY = ob.Y + dy; newW = ob.Width + dx; newH = ob.Height - dy; break;
            case "sw": newX = ob.X + dx; newW = ob.Width - dx; newH = ob.Height + dy; break;
            case "se": newW = ob.Width + dx; newH = ob.Height + dy; break;
            case "n": newY = ob.Y + dy; newH = ob.Height - dy; break;
            case "s": newH = ob.Height + dy; break;
            case "w": newX = ob.X + dx; newW = ob.Width - dx; break;
            case "e": newW = ob.Width + dx; break;
        }

        // Ensure minimum size
        if (newW < 10) { newW = 10; if (ResizeHandle.Contains('w')) newX = ob.X + ob.Width - 10; }
        if (newH < 10) { newH = 10; if (ResizeHandle.Contains('n')) newY = ob.Y + ob.Height - 10; }

        // Calculate scale factors from ORIGINAL bounds
        var scaleX = ob.Width > 0 ? newW / ob.Width : 1;
        var scaleY = ob.Height > 0 ? newH / ob.Height : 1;

        // Apply resize based on element type, using ORIGINAL element snapshot
        switch (el)
        {
            case RectElement rect:
                rect.X = newX; rect.Y = newY; rect.Width = newW; rect.Height = newH;
                break;
            case CircleElement circle:
                circle.Cx = newX + newW / 2; circle.Cy = newY + newH / 2;
                circle.Radius = Math.Min(newW, newH) / 2;
                break;
            case EllipseElement ellipse:
                ellipse.Cx = newX + newW / 2; ellipse.Cy = newY + newH / 2;
                ellipse.Rx = newW / 2; ellipse.Ry = newH / 2;
                break;
            case PolygonElement poly:
                poly.Cx = newX + newW / 2; poly.Cy = newY + newH / 2;
                poly.Radius = Math.Min(newW, newH) / 2;
                break;
            case StarElement star:
                star.Cx = newX + newW / 2; star.Cy = newY + newH / 2;
                star.OuterRadius = Math.Min(newW, newH) / 2;
                star.InnerRadius = star.OuterRadius * 0.4;
                break;
            case ImageElement img:
                img.X = newX; img.Y = newY; img.Width = newW; img.Height = newH;
                break;
            case LineElement line when OriginalElementSnapshot is LineElement origLine:
                // Use ORIGINAL line coords for scaling
                line.X1 = newX + (origLine.X1 - ob.X) * scaleX;
                line.Y1 = newY + (origLine.Y1 - ob.Y) * scaleY;
                line.X2 = newX + (origLine.X2 - ob.X) * scaleX;
                line.Y2 = newY + (origLine.Y2 - ob.Y) * scaleY;
                break;
            case ArrowElement arrow when OriginalElementSnapshot is ArrowElement origArrow:
                arrow.X1 = newX + (origArrow.X1 - ob.X) * scaleX;
                arrow.Y1 = newY + (origArrow.Y1 - ob.Y) * scaleY;
                arrow.X2 = newX + (origArrow.X2 - ob.X) * scaleX;
                arrow.Y2 = newY + (origArrow.Y2 - ob.Y) * scaleY;
                break;
            case TriangleElement tri when OriginalElementSnapshot is TriangleElement origTri:
                tri.X1 = newX + (origTri.X1 - ob.X) * scaleX;
                tri.Y1 = newY + (origTri.Y1 - ob.Y) * scaleY;
                tri.X2 = newX + (origTri.X2 - ob.X) * scaleX;
                tri.Y2 = newY + (origTri.Y2 - ob.Y) * scaleY;
                tri.X3 = newX + (origTri.X3 - ob.X) * scaleX;
                tri.Y3 = newY + (origTri.Y3 - ob.Y) * scaleY;
                break;
            case PathElement path when OriginalElementSnapshot is PathElement origPath:
                path.Points = origPath.Points.Select(p => new Point(
                    newX + (p.X - ob.X) * scaleX,
                    newY + (p.Y - ob.Y) * scaleY
                )).ToList();
                break;
            case ArcElement arc when OriginalElementSnapshot is ArcElement origArc:
                arc.X1 = newX + (origArc.X1 - ob.X) * scaleX;
                arc.Y1 = newY + (origArc.Y1 - ob.Y) * scaleY;
                arc.X2 = newX + (origArc.X2 - ob.X) * scaleX;
                arc.Y2 = newY + (origArc.Y2 - ob.Y) * scaleY;
                arc.MidX = newX + (origArc.MidX - ob.X) * scaleX;
                arc.MidY = newY + (origArc.MidY - ob.Y) * scaleY;
                break;
            case TextElement txt:
                txt.X = newX; txt.Y = newY + newH; // Text baseline
                txt.FontSize = Math.Max(8, newH * 0.8);
                break;
        }
    }

    // Resize a group of elements proportionally
    private void ResizeGroup(double mouseX, double mouseY)
    {
        if (DragStart == null || OriginalBounds == null || ResizeHandle == null || OriginalElementBounds == null || OriginalElementSnapshots == null) return;

        var ob = OriginalBounds;
        var dx = mouseX - DragStart.X;
        var dy = mouseY - DragStart.Y;

        double newX = ob.X, newY = ob.Y, newW = ob.Width, newH = ob.Height;

        // Calculate new group bounds based on handle
        switch (ResizeHandle)
        {
            case "nw": newX = ob.X + dx; newY = ob.Y + dy; newW = ob.Width - dx; newH = ob.Height - dy; break;
            case "ne": newY = ob.Y + dy; newW = ob.Width + dx; newH = ob.Height - dy; break;
            case "sw": newX = ob.X + dx; newW = ob.Width - dx; newH = ob.Height + dy; break;
            case "se": newW = ob.Width + dx; newH = ob.Height + dy; break;
            case "n": newY = ob.Y + dy; newH = ob.Height - dy; break;
            case "s": newH = ob.Height + dy; break;
            case "w": newX = ob.X + dx; newW = ob.Width - dx; break;
            case "e": newW = ob.Width + dx; break;
        }

        // Ensure minimum size
        if (newW < 20) { newW = 20; if (ResizeHandle.Contains('w')) newX = ob.X + ob.Width - 20; }
        if (newH < 20) { newH = 20; if (ResizeHandle.Contains('n')) newY = ob.Y + ob.Height - 20; }

        // Calculate scale factors
        var scaleX = ob.Width > 0 ? newW / ob.Width : 1;
        var scaleY = ob.Height > 0 ? newH / ob.Height : 1;

        // Apply scaling to each element relative to original group bounds
        foreach (var el in SelectedElements)
        {
            if (!OriginalElementBounds.TryGetValue(el.Id, out var elOb)) continue;
            if (!OriginalElementSnapshots.TryGetValue(el.Id, out var origEl)) continue;

            // Calculate new element bounds
            var elNewX = newX + (elOb.X - ob.X) * scaleX;
            var elNewY = newY + (elOb.Y - ob.Y) * scaleY;
            var elNewW = elOb.Width * scaleX;
            var elNewH = elOb.Height * scaleY;

            // Apply to element based on type, using ORIGINAL snapshot for point-based elements
            switch (el)
            {
                case RectElement rect:
                    rect.X = elNewX; rect.Y = elNewY; rect.Width = Math.Max(1, elNewW); rect.Height = Math.Max(1, elNewH);
                    break;
                case CircleElement circle:
                    circle.Cx = elNewX + elNewW / 2; circle.Cy = elNewY + elNewH / 2;
                    circle.Radius = Math.Max(1, Math.Min(elNewW, elNewH) / 2);
                    break;
                case EllipseElement ellipse:
                    ellipse.Cx = elNewX + elNewW / 2; ellipse.Cy = elNewY + elNewH / 2;
                    ellipse.Rx = Math.Max(1, elNewW / 2); ellipse.Ry = Math.Max(1, elNewH / 2);
                    break;
                case PolygonElement poly:
                    poly.Cx = elNewX + elNewW / 2; poly.Cy = elNewY + elNewH / 2;
                    poly.Radius = Math.Max(1, Math.Min(elNewW, elNewH) / 2);
                    break;
                case StarElement star:
                    star.Cx = elNewX + elNewW / 2; star.Cy = elNewY + elNewH / 2;
                    star.OuterRadius = Math.Max(1, Math.Min(elNewW, elNewH) / 2);
                    star.InnerRadius = star.OuterRadius * 0.4;
                    break;
                case ImageElement img:
                    img.X = elNewX; img.Y = elNewY; img.Width = Math.Max(1, elNewW); img.Height = Math.Max(1, elNewH);
                    break;
                case LineElement line when origEl is LineElement origLine:
                    line.X1 = newX + (origLine.X1 - ob.X) * scaleX;
                    line.Y1 = newY + (origLine.Y1 - ob.Y) * scaleY;
                    line.X2 = newX + (origLine.X2 - ob.X) * scaleX;
                    line.Y2 = newY + (origLine.Y2 - ob.Y) * scaleY;
                    break;
                case ArrowElement arrow when origEl is ArrowElement origArrow:
                    arrow.X1 = newX + (origArrow.X1 - ob.X) * scaleX;
                    arrow.Y1 = newY + (origArrow.Y1 - ob.Y) * scaleY;
                    arrow.X2 = newX + (origArrow.X2 - ob.X) * scaleX;
                    arrow.Y2 = newY + (origArrow.Y2 - ob.Y) * scaleY;
                    break;
                case TriangleElement tri when origEl is TriangleElement origTri:
                    tri.X1 = newX + (origTri.X1 - ob.X) * scaleX;
                    tri.Y1 = newY + (origTri.Y1 - ob.Y) * scaleY;
                    tri.X2 = newX + (origTri.X2 - ob.X) * scaleX;
                    tri.Y2 = newY + (origTri.Y2 - ob.Y) * scaleY;
                    tri.X3 = newX + (origTri.X3 - ob.X) * scaleX;
                    tri.Y3 = newY + (origTri.Y3 - ob.Y) * scaleY;
                    break;
                case PathElement path when origEl is PathElement origPath:
                    path.Points = origPath.Points.Select(p => new Point(
                        newX + (p.X - ob.X) * scaleX,
                        newY + (p.Y - ob.Y) * scaleY
                    )).ToList();
                    break;
                case ArcElement arc when origEl is ArcElement origArc:
                    arc.X1 = newX + (origArc.X1 - ob.X) * scaleX;
                    arc.Y1 = newY + (origArc.Y1 - ob.Y) * scaleY;
                    arc.X2 = newX + (origArc.X2 - ob.X) * scaleX;
                    arc.Y2 = newY + (origArc.Y2 - ob.Y) * scaleY;
                    arc.MidX = newX + (origArc.MidX - ob.X) * scaleX;
                    arc.MidY = newY + (origArc.MidY - ob.Y) * scaleY;
                    break;
                case TextElement txt:
                    txt.X = elNewX; txt.Y = elNewY + elNewH;
                    txt.FontSize = Math.Max(8, elNewH * 0.8);
                    break;
            }
        }
    }

    // Property panel helpers
    private string GetSelectedStroke() => SelectedElements.FirstOrDefault()?.Stroke ?? "#000000";
    private string GetSelectedFill()
    {
        var fill = SelectedElements.FirstOrDefault()?.Fill ?? "none";
        return fill == "none" ? "#ffffff" : fill;
    }
    private int GetSelectedStrokeWidthIndex()
    {
        var sw = SelectedElements.FirstOrDefault()?.StrokeWidth ?? 2;
        return sw switch { 1 => 0, 2 => 1, 4 => 2, 6 => 3, 8 => 4, 12 => 5, _ => 1 };
    }

    private void OnSelectedStrokeChange(ChangeEventArgs e)
    {
        SaveUndoState();
        var color = e.Value?.ToString() ?? "#000000";
        foreach (var el in SelectedElements)
            el.Stroke = color;
    }

    private void OnSelectedStrokeWidthChange(ChangeEventArgs e)
    {
        SaveUndoState();
        var index = int.Parse(e.Value?.ToString() ?? "1");
        var width = index switch { 0 => 1.0, 1 => 2.0, 2 => 4.0, 3 => 6.0, 4 => 8.0, 5 => 12.0, _ => 2.0 };
        foreach (var el in SelectedElements)
            el.StrokeWidth = width;
    }

    private void OnSelectedFillChange(ChangeEventArgs e)
    {
        SaveUndoState();
        var color = e.Value?.ToString() ?? "#ffffff";
        foreach (var el in SelectedElements)
            el.Fill = color;
    }

    private void ClearSelectedFill()
    {
        SaveUndoState();
        foreach (var el in SelectedElements)
            el.Fill = "none";
    }

    private void BringToFront()
    {
        SaveUndoState();
        foreach (var el in SelectedElements)
        {
            // Find which layer contains this element and move within that layer
            foreach (var layer in Layers)
            {
                if (layer.Elements.Remove(el))
                {
                    layer.Elements.Add(el);
                    break;
                }
            }
        }
    }

    private void SendToBack()
    {
        SaveUndoState();
        var toMove = SelectedElements.ToList();
        foreach (var el in toMove)
        {
            foreach (var layer in Layers)
            {
                var idx = layer.Elements.IndexOf(el);
                if (idx >= 0)
                {
                    layer.Elements.RemoveAt(idx);
                    layer.Elements.Insert(0, el);
                    break;
                }
            }
        }
    }

    private void BringForward()
    {
        SaveUndoState();
        foreach (var layer in Layers)
        {
            var layerSelected = SelectedElements.Where(e => layer.Elements.Contains(e)).ToList();
            var sortedByIndex = layerSelected
                .Select(el => (el, index: layer.Elements.IndexOf(el)))
                .OrderByDescending(x => x.index)
                .ToList();

            foreach (var (el, index) in sortedByIndex)
            {
                if (index < layer.Elements.Count - 1)
                {
                    layer.Elements.RemoveAt(index);
                    layer.Elements.Insert(index + 1, el);
                }
            }
        }
    }

    private void SendBackward()
    {
        SaveUndoState();
        foreach (var layer in Layers)
        {
            var layerSelected = SelectedElements.Where(e => layer.Elements.Contains(e)).ToList();
            var sortedByIndex = layerSelected
                .Select(el => (el, index: layer.Elements.IndexOf(el)))
                .OrderBy(x => x.index)
                .ToList();

            foreach (var (el, index) in sortedByIndex)
            {
                if (index > 0)
                {
                    layer.Elements.RemoveAt(index);
                    layer.Elements.Insert(index - 1, el);
                }
            }
        }
    }

    // Alignment methods
    private void AlignLeft()
    {
        if (SelectedElements.Count < 2) return;
        SaveUndoState();
        var minX = SelectedElements.Min(e => e.GetBounds().X);
        foreach (var el in SelectedElements)
        {
            var bounds = el.GetBounds();
            var dx = minX - bounds.X;
            if (Math.Abs(dx) > 0.01) MoveElement(el, dx, 0);
        }
        StateHasChanged();
    }

    private void AlignCenterH()
    {
        if (SelectedElements.Count < 2) return;
        SaveUndoState();
        var centerX = SelectedElements.Average(e => { var b = e.GetBounds(); return b.X + b.Width / 2; });
        foreach (var el in SelectedElements)
        {
            var bounds = el.GetBounds();
            var dx = centerX - (bounds.X + bounds.Width / 2);
            if (Math.Abs(dx) > 0.01) MoveElement(el, dx, 0);
        }
        StateHasChanged();
    }

    private void AlignRight()
    {
        if (SelectedElements.Count < 2) return;
        SaveUndoState();
        var maxRight = SelectedElements.Max(e => { var b = e.GetBounds(); return b.X + b.Width; });
        foreach (var el in SelectedElements)
        {
            var bounds = el.GetBounds();
            var dx = maxRight - (bounds.X + bounds.Width);
            if (Math.Abs(dx) > 0.01) MoveElement(el, dx, 0);
        }
        StateHasChanged();
    }

    private void AlignTop()
    {
        if (SelectedElements.Count < 2) return;
        SaveUndoState();
        var minY = SelectedElements.Min(e => e.GetBounds().Y);
        foreach (var el in SelectedElements)
