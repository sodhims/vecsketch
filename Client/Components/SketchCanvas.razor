                        @foreach (var step in CascadeStepResults)
                        {
                            @* Auto-expand running steps or steps with content *@
                            var isExpanded = ExpandedCascadeStep == step.StepId ||
                                             step.Status == CascadeStepStatus.Running ||
                                             (step.Status == CascadeStepStatus.Completed && CascadeStepResults.IndexOf(step) == CascadeStepResults.Count - 1);
                            <div class="cascade-progress-step @step.Status.ToString().ToLower() @(isExpanded ? "expanded" : "")">
                                <div class="step-header" @onclick="() => ToggleCascadeStep(step.StepId)">
                                    <span class="step-status-icon">@GetStatusIcon(step.Status)</span>
                                    <span class="step-name">@step.StepName</span>
                                    <span class="step-time">@(step.ElapsedMs > 0 ? $"{step.ElapsedMs}ms" : "...")</span>
                                    @if (!string.IsNullOrEmpty(step.Output) || !string.IsNullOrEmpty(step.Input) || !string.IsNullOrEmpty(step.Error))
