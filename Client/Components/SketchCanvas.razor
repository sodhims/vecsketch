    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Focus container for keyboard shortcuts
            await containerElement.FocusAsync();

            await JS.InvokeVoidAsync("setupPasteHandler", DotNetObjectReference.Create(this));
            // Load saved theme
            var savedTheme = await JS.InvokeAsync<string>("localStorage.getItem", "vecsketch-theme");
            if (!string.IsNullOrEmpty(savedTheme))
            {
                CurrentTheme = savedTheme;
                // Set appropriate stroke color for loaded theme
                if (CurrentTheme == "darkish")
                {
                    StrokeColor = "#ffffff";
                }
            }
            // Initialize SVG scale info
            await UpdateSvgScaleInfo();

            // Subscribe to cascade step progress for real-time updates
            CascadeService.OnStepProgress += HandleCascadeStepProgress;

            StateHasChanged();
        }
    }

    private void HandleCascadeStepProgress(CascadeStepProgress stepProgress)
    {
        // Find existing step or add new one by StepId
        var existing = CascadeStepResults.FirstOrDefault(s => s.StepId == stepProgress.StepId);
        if (existing != null)
        {
            // Update existing step
            var index = CascadeStepResults.IndexOf(existing);
            CascadeStepResults[index] = stepProgress;
        }
        else
        {
            // Add new step
            CascadeStepResults.Add(stepProgress);
        }

        // Trigger UI update on the UI thread
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CascadeService.OnStepProgress -= HandleCascadeStepProgress;
    }

    private async Task UpdateSvgScaleInfo()
    {
        try
        {
            var scaleInfo = await JS.InvokeAsync<SvgScaleInfo>("getSvgScaleInfo", svgElement);
            if (scaleInfo != null && scaleInfo.ScaleX > 0 && scaleInfo.ScaleY > 0)
            {
                SvgScaleX = scaleInfo.ScaleX;
                SvgScaleY = scaleInfo.ScaleY;
                SvgOffsetX = scaleInfo.ViewBoxOffsetX;
                SvgOffsetY = scaleInfo.ViewBoxOffsetY;
            }
        }
        catch { /* Ignore errors during scale info update */ }
    }

    private record SvgScaleInfo(double ScaleX, double ScaleY, double ViewBoxOffsetX, double ViewBoxOffsetY);

    // Transform element-relative offset coordinates to SVG viewBox coordinates
    // offsetX/offsetY are from pointer events (relative to the SVG element)
    private (double X, double Y) TransformToSvgCoords(double offsetX, double offsetY)
    {
        if (SvgScaleX <= 0 || SvgScaleY <= 0)
            return (offsetX, offsetY);

        // Formula: svg_coord = (offset - viewBoxOffset) / scale
        // viewBoxOffset accounts for centering due to preserveAspectRatio="xMidYMid meet"
        var svgX = (offsetX - SvgOffsetX) / SvgScaleX;
        var svgY = (offsetY - SvgOffsetY) / SvgScaleY;

        return (svgX, svgY);
    }

