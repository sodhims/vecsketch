    private async Task RefreshOllamaModels()
    {
        OllamaModelsLoading = true;
        OllamaStatus = "Connecting...";
        OllamaStatusIsError = false;
        StateHasChanged();

        var result = await AiService.GetOllamaModelsAsync();

        if (result.Success)
        {
            AvailableOllamaModels = result.Models;
            if (AvailableOllamaModels.Count > 0)
            {
                // If current model isn't in list, select first available
                if (!AvailableOllamaModels.Contains(AiService.OllamaModel))
                {
                    AiService.OllamaModel = AvailableOllamaModels[0];
                }
                OllamaStatus = $"Found {AvailableOllamaModels.Count} model(s)";
                OllamaStatusIsError = false;
            }
            else
            {
                OllamaStatus = "No models found - run 'ollama pull <model>'";
                OllamaStatusIsError = true;
            }
        }
        else
        {
            AvailableOllamaModels.Clear();
            OllamaStatus = result.Error ?? "Connection failed";
            OllamaStatusIsError = true;
        }

        OllamaModelsLoading = false;
        StateHasChanged();

        // Clear success status after 3 seconds
        if (!OllamaStatusIsError && AvailableOllamaModels.Count > 0)
        {
            await Task.Delay(3000);
            if (OllamaStatus?.StartsWith("Found") == true)
            {
                OllamaStatus = null;
                StateHasChanged();
            }
        }
    }

    private async Task RefreshCascadeSlotOllamaModels(int slot)
    {
        var slotData = slot switch
        {
            1 => CascadeService.CurrentMatrix.Slot1,
            2 => CascadeService.CurrentMatrix.Slot2,
            3 => CascadeService.CurrentMatrix.Slot3,
            _ => null
        };

        if (slotData == null) return;

        switch (slot)
        {
            case 1: CascadeSlot1Loading = true; break;
            case 2: CascadeSlot2Loading = true; break;
            case 3: CascadeSlot3Loading = true; break;
        }
        StateHasChanged();

        try
        {
            OllamaModelsResult result;

            // For OllamaLocal, call directly from browser to localhost
            if (slotData.Provider == "OllamaLocal")
            {
                result = await CascadeService.GetLocalOllamaModelsAsync();
            }
            else
            {
                // For remote Ollama, go through server
                var endpoint = slotData.Endpoint;
                if (string.IsNullOrEmpty(endpoint))
                    endpoint = "http://localhost:11434";
                else if (!endpoint.StartsWith("http"))
                    endpoint = "http://" + endpoint;

                result = await AiService.GetOllamaModelsAsync(endpoint);
            }

            var models = result.Success ? result.Models : new List<string>();

            switch (slot)
            {
                case 1:
                    CascadeSlot1OllamaModels = models;
                    if (models.Count > 0 && string.IsNullOrEmpty(CascadeService.CurrentMatrix.Slot1.Model))
                        CascadeService.CurrentMatrix.Slot1.Model = models[0];
                    break;
                case 2:
                    CascadeSlot2OllamaModels = models;
                    if (models.Count > 0 && string.IsNullOrEmpty(CascadeService.CurrentMatrix.Slot2.Model))
                        CascadeService.CurrentMatrix.Slot2.Model = models[0];
                    break;
                case 3:
                    CascadeSlot3OllamaModels = models;
                    if (models.Count > 0 && string.IsNullOrEmpty(CascadeService.CurrentMatrix.Slot3.Model))
                        CascadeService.CurrentMatrix.Slot3.Model = models[0];
                    break;
            }
        }
        finally
        {
            switch (slot)
            {
                case 1: CascadeSlot1Loading = false; break;
                case 2: CascadeSlot2Loading = false; break;
                case 3: CascadeSlot3Loading = false; break;
            }
            StateHasChanged();
        }
    }

    private async Task GenerateFromAi()
    {
        if (string.IsNullOrWhiteSpace(AiPrompt) || AiGenerating) return;

        // Only require API key for Anthropic
        if (AiService.Provider == AiProvider.Anthropic && string.IsNullOrEmpty(AiService.ApiKey)) return;

        AiGenerating = true;
        AiError = null;
        AiThinking = null;
        AiResult = null;
        StateHasChanged();

        try
        {
            // Clear canvas if option is checked
            if (AiClearBeforeGenerate)
            {
                foreach (var layer in Layers) layer.Elements.Clear();
                ClearSelection();
            }

            var result = await AiService.GenerateAsync(AiPrompt);

            if (!result.Success)
            {
                AiError = result.Error;
                return;
            }

            AiThinking = result.Thinking;

            if (result.Response?.Commands != null && result.Response.Commands.Count > 0)
            {
                AiResult = ExecuteCommands(result.Response.Commands);
                if (!AiResult.Success)
                {
                    AiError = AiResult.Error;
                }
            }
            else
            {
                AiError = "No drawing commands returned";
            }
        }
        catch (Exception ex)
        {
            AiError = $"Error: {ex.Message}";
        }
        finally
        {
            AiGenerating = false;
            StateHasChanged();
        }
    }

    private async Task GenerateWithCascade()
    {
        if (string.IsNullOrWhiteSpace(AiPrompt) || AiGenerating) return;
        if (!CanRunCascade) return;

        AiGenerating = true;
        AiError = null;
        AiThinking = null;
        AiResult = null;
        CascadeStepResults.Clear();
        CascadeTotalMs = 0;
        StateHasChanged();

        try
        {
            // Clear canvas if option is checked
            if (AiClearBeforeGenerate)
            {
                foreach (var layer in Layers) layer.Elements.Clear();
                ClearSelection();
            }

            // Build API keys dictionary (Anthropic shares with AiService.ApiKey, DeepSeek/Ollama don't need keys)
            var apiKeys = new Dictionary<string, string>();
            if (!string.IsNullOrEmpty(AiService.ApiKey))
                apiKeys["anthropic"] = AiService.ApiKey;
            if (!string.IsNullOrEmpty(CascadeOpenAIKey))
                apiKeys["openai"] = CascadeOpenAIKey;

            var result = await CascadeService.ExecuteAsync(AiPrompt, apiKeys, CascadeReverse);

            // Update progress display
            CascadeStepResults = result.StepResults;
            CascadeTotalMs = result.TotalElapsedMs;

            if (!result.Success)
            {
                AiError = result.Error;
                return;
            }

            AiThinking = result.Thinking;

            if (result.DrawingResponse?.Commands != null && result.DrawingResponse.Commands.Count > 0)
            {
                AiResult = ExecuteCommands(result.DrawingResponse.Commands);
                if (!AiResult.Success)
                {
                    AiError = AiResult.Error;
                }
            }
            else
            {
                AiError = "No drawing commands returned from cascade";
            }
        }
        catch (Exception ex)
        {
            AiError = $"Cascade error: {ex.Message}";
        }
        finally
        {
            AiGenerating = false;
            StateHasChanged();
        }
    }

    // =====================================================
    // Command Execution API
    // =====================================================
    private readonly CommandExecutor _commandExecutor = new();
    private string _canvasFill = "white";

    /// <summary>
    /// Execute a list of draw commands programmatically.
    /// Creates a new layer for AI-generated content.
    /// </summary>
    public CommandResult ExecuteCommands(List<DrawCommand> commands)
    {
        SaveUndoState();

        // Create a new layer for AI-generated content
        var aiLayer = new Layer { Name = $"AI Drawing {Layers.Count}" };
        Layers.Add(aiLayer);
        CurrentLayerIndex = Layers.Count - 1;

        var width = (double)CanvasWidth;
        var height = (double)CanvasHeight;
        var result = _commandExecutor.Execute(commands, aiLayer.Elements, ref width, ref height, ref _canvasFill);

        // Only update canvas size if not locked
        if (!LockCanvasSize)
        {
            CanvasWidth = (int)width;
            CanvasHeight = (int)height;
        }
        StateHasChanged();
        return result;
    }

    /// <summary>
    /// Execute a JSON drawing response string.
    /// Creates a new layer for AI-generated content.
    /// </summary>
    public CommandResult ExecuteJson(string json)
    {
        SaveUndoState();

        // Create a new layer for AI-generated content
        var aiLayer = new Layer { Name = $"AI Drawing {Layers.Count}" };
        Layers.Add(aiLayer);
        CurrentLayerIndex = Layers.Count - 1;

        var width = (double)CanvasWidth;
        var height = (double)CanvasHeight;
        var result = _commandExecutor.ExecuteJson(json, aiLayer.Elements, ref width, ref height, ref _canvasFill);

        // Only update canvas size if not locked
        if (!LockCanvasSize)
        {
            CanvasWidth = (int)width;
            CanvasHeight = (int)height;
        }
        StateHasChanged();
        return result;
    }

    /// <summary>
    /// Execute a single draw command.
    /// </summary>
    public CommandResult ExecuteCommand(DrawCommand command)
    {
        return ExecuteCommands(new List<DrawCommand> { command });
    }

    /// <summary>
    /// Get current canvas state as a list of elements for serialization.
    /// </summary>
    public IReadOnlyList<VectorElement> GetElements() => Elements.AsReadOnly();

    /// <summary>
    /// Get canvas dimensions.
    /// </summary>
    public (int Width, int Height) GetCanvasSize() => (CanvasWidth, CanvasHeight);

    /// <summary>
    /// Get element by ID.
    /// </summary>
    public VectorElement? GetElementById(string id) => Elements.FirstOrDefault(e => e.Id == id);
}
