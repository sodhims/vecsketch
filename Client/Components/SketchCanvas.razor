    private PathElement DeserializePathElement(System.Text.Json.JsonElement root)
    {
        var pathElement = new PathElement
        {
            Id = root.GetProperty("Id").GetString() ?? Guid.NewGuid().ToString(),
            Stroke = root.GetProperty("Stroke").GetString() ?? "#000000",
            StrokeWidth = root.GetProperty("StrokeWidth").GetDouble(),
            Fill = root.GetProperty("Fill").GetString() ?? "none",
            GroupId = root.TryGetProperty("GroupId", out var gid) ? gid.GetString() : null
        };

        // Deserialize Points array
        if (root.TryGetProperty("Points", out var pointsArray))
        {
            foreach (var pointEl in pointsArray.EnumerateArray())
            {
                var x = pointEl.GetProperty("X").GetDouble();
                var y = pointEl.GetProperty("Y").GetDouble();
                pathElement.Points.Add(new Point(x, y));
            }
        }

        return pathElement;
    }

    private void DiscardRecording()
    {
        CurrentRecording = null;
        RecordingStopwatch = null;
        InputHint = "Recording discarded";
        StateHasChanged();
    }

    private void DeleteRecording(Recording recording)
    {
        SavedRecordings.Remove(recording);
        _ = JS.InvokeVoidAsync("localStorage.removeItem", $"vecsketch-recording-{recording.Id}");
        var recordingIds = SavedRecordings.Select(r => r.Id).ToList();
        _ = JS.InvokeVoidAsync("localStorage.setItem", "vecsketch-recordings",
            System.Text.Json.JsonSerializer.Serialize(recordingIds));
        StateHasChanged();
    }

    private async Task ReplaySelected()
    {
        if (string.IsNullOrEmpty(SelectedReplayId)) return;
        var recording = SavedRecordings.FirstOrDefault(r => r.Id == SelectedReplayId);
        if (recording != null)
        {
            await StartReplay(recording);
        }
    }

    private async Task ExportRecordingJson(Recording recording)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(recording, new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true
        });
        var fileName = $"{recording.Name.Replace(" ", "_")}_{DateTime.Now:yyyyMMdd_HHmmss}.json";
        await JS.InvokeVoidAsync("downloadTextFile", fileName, json, "application/json");
        InputHint = $"Exported '{recording.Name}' as {fileName}";
    }

    private async Task ImportRecordingJson(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
            using var reader = new System.IO.StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var recording = System.Text.Json.JsonSerializer.Deserialize<Recording>(json);
            if (recording == null)
            {
                InputHint = "Failed to parse recording JSON";
                return;
            }

            // Generate new ID to avoid conflicts
            recording.Id = Guid.NewGuid().ToString();

            // Add to saved recordings
            SavedRecordings.Add(recording);
            _ = JS.InvokeVoidAsync("localStorage.setItem", $"vecsketch-recording-{recording.Id}",
                System.Text.Json.JsonSerializer.Serialize(recording));

            var recordingIds = SavedRecordings.Select(r => r.Id).ToList();
            _ = JS.InvokeVoidAsync("localStorage.setItem", "vecsketch-recordings",
                System.Text.Json.JsonSerializer.Serialize(recordingIds));

            InputHint = $"Imported recording '{recording.Name}' ({recording.Actions.Count} actions)";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            InputHint = $"Import failed: {ex.Message}";
        }
    }

    // Recording Editor Methods
    private void OpenRecordingEditor(Recording recording)
    {
        // Deep clone the recording for editing
        var json = System.Text.Json.JsonSerializer.Serialize(recording);
        EditingRecording = System.Text.Json.JsonSerializer.Deserialize<Recording>(json);
        SelectedActionIndex = -1;
        CheckedActionIndices.Clear();
        ShowRecordingEditor = true;
        StateHasChanged();
    }

    private void CloseRecordingEditor()
    {
        ShowRecordingEditor = false;
        EditingRecording = null;
        SelectedActionIndex = -1;
        CheckedActionIndices.Clear();
        StateHasChanged();
    }

    private void SelectAction(int index)
    {
        SelectedActionIndex = index;
        StateHasChanged();
    }

    private void ToggleActionChecked(int index)
    {
        if (CheckedActionIndices.Contains(index))
            CheckedActionIndices.Remove(index);
        else
            CheckedActionIndices.Add(index);
        StateHasChanged();
    }

    private void ToggleAllChecked()
    {
        if (EditingRecording == null) return;

        if (CheckedActionIndices.Count == EditingRecording.Actions.Count)
        {
            // All checked, uncheck all
            CheckedActionIndices.Clear();
        }
        else
        {
            // Not all checked, check all
            CheckedActionIndices = Enumerable.Range(0, EditingRecording.Actions.Count).ToHashSet();
        }
        StateHasChanged();
    }

