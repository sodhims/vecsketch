@namespace VecSketch.Client.Components
@using VecSketch.Client.Models
@using VecSketch.Client.Services
@using VecSketch.Shared
@using DrawingTool = VecSketch.Client.Models.DrawingTool
@using VectorElement = VecSketch.Client.Models.VectorElement
@using Point = VecSketch.Client.Models.Point
@using DrawCommand = VecSketch.Client.Models.DrawCommand
@using CommandResult = VecSketch.Client.Models.CommandResult
@inject IJSRuntime JS
@inject AiDrawingService AiService
@inject CascadeService CascadeService

<div class="sketch-container" @ref="containerElement" tabindex="0" @onkeydown="OnKeyDown">
    <div class="toolbar">
        <div class="tool-group">
            <label>Tool:</label>
            <select @bind="CurrentToolIndex" class="tool-select">
                <option value="0">Select</option>
                <option value="1">Line</option>
                <option value="2">Pencil</option>
                <option value="3">Rectangle</option>
                <option value="4">Circle</option>
                <option value="5">Ellipse</option>
                <option value="6">Triangle</option>
                <option value="7">Polygon</option>
                <option value="8">Star</option>
                <option value="9">Arrow</option>
                <option value="10">Text</option>
            </select>
        </div>

        @if (CurrentTool == DrawingTool.Polygon)
        {
            <div class="tool-group">
                <label>Sides:</label>
                <select @bind="PolygonSides" class="width-select">
                    <option value="3">3</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                    <option value="8">8</option>
                    <option value="10">10</option>
                    <option value="12">12</option>
                </select>
            </div>
        }

        @if (CurrentTool == DrawingTool.Star)
        {
            <div class="tool-group">
                <label>Points:</label>
                <select @bind="StarPoints" class="width-select">
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                    <option value="8">8</option>
                </select>
            </div>
        }

        @if (CurrentTool == DrawingTool.Text)
        {
            <div class="tool-group">
                <label>Size:</label>
                <select @bind="FontSizeIndex" class="width-select">
                    <option value="0">12px</option>
                    <option value="1">16px</option>
                    <option value="2">20px</option>
                    <option value="3">24px</option>
                    <option value="4">32px</option>
                    <option value="5">48px</option>
                </select>
            </div>
        }

        <div class="tool-group">
            <label>Stroke:</label>
            <input type="color" @bind="StrokeColor" class="color-picker" />
        </div>

        <div class="tool-group">
            <label>Width:</label>
            <select @bind="StrokeWidthIndex" class="width-select">
                <option value="0">1px</option>
                <option value="1">2px</option>
                <option value="2">4px</option>
                <option value="3">6px</option>
                <option value="4">8px</option>
                <option value="5">12px</option>
            </select>
        </div>

        <div class="tool-group">
            <label>Fill:</label>
            <input type="checkbox" @bind="UseFillToggle" />
            <input type="color" @bind="FillColor" class="color-picker" />
        </div>

        <div class="tool-group">
            <label>Touch:</label>
            <input type="checkbox" checked="@TouchEnabled" @onchange="OnTouchToggleChange" title="Uncheck to disable touch for pen drawing" />
        </div>

        <div class="tool-group actions">
            <button class="btn btn-sm btn-outline-light" @onclick="OnPasteClick">Paste</button>
            <button class="btn btn-sm btn-outline-light" @onclick="OnClearClick">Clear</button>
            <button class="btn btn-sm btn-outline-light" @onclick="OnUndoClick">Undo</button>
            <button class="btn btn-sm btn-outline-light" @onclick="OnExportClick">Export</button>
            <button class="btn btn-sm btn-outline-light" @onclick="OnImportClick" disabled="@IsImporting">
                @(IsImporting ? "Importing..." : "Import")
            </button>
        </div>
    </div>

    <input type="file" @ref="fileInputElement" accept=".ai,.pdf,.png,.jpg,.jpeg,.gif,.webp,.bmp,.svg" style="display: none;" @onchange="OnFileSelected" />

    <div class="canvas-info">
        <span>@Elements.Count/@MaxElements</span>
        <div class="progress" style="width: 80px; height: 8px;">
            <div class="progress-bar" role="progressbar" style="width: @GetProgressPercent()%"></div>
        </div>
        <span class="input-hint">@InputHint</span>
    </div>

    <svg @ref="svgElement"
         width="100%"
         height="100%"
         viewBox="0 0 @CanvasWidth @CanvasHeight"
         preserveAspectRatio="xMidYMid meet"
         class="canvas"
         @onpointerdown="OnPointerDown"
         @onpointermove="OnPointerMove"
         @onpointerup="OnPointerUp"
         @onpointerleave="OnPointerUp"
         @onpointercancel="OnPointerUp"
         @oncontextmenu:preventDefault="true">

        <defs>
            <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#eee" stroke-width="0.5"/>
            </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />

        @foreach (var element in Elements)
        {
            @((MarkupString)element.ToSvg())
        }

        @if (IsDrawing && CurrentElement != null)
        {
            @((MarkupString)CurrentElement.ToSvg())
        }

        @if (IsSelecting && SelectionStart != null && SelectionEnd != null)
        {
            var x = Math.Min(SelectionStart.X, SelectionEnd.X);
            var y = Math.Min(SelectionStart.Y, SelectionEnd.Y);
            var w = Math.Abs(SelectionEnd.X - SelectionStart.X);
            var h = Math.Abs(SelectionEnd.Y - SelectionStart.Y);
            <rect x="@x" y="@y" width="@w" height="@h" fill="rgba(0,102,255,0.1)" stroke="#0066ff" stroke-width="1" stroke-dasharray="4 2" />
        }

        @foreach (var el in SelectedElements)
        {
            var b = el.GetBounds();
            <!-- Selection box -->
            <rect x="@(b.X - 4)" y="@(b.Y - 4)" width="@(b.Width + 8)" height="@(b.Height + 8)" fill="none" stroke="#0066ff" stroke-width="1" stroke-dasharray="4 2" />
            <!-- Resize handles (only show for single selection) -->
            @if (SelectedElements.Count == 1)
            {
                var handleSize = 8;
                var hs = handleSize / 2.0;
                <!-- Corner handles -->
                <rect x="@(b.X - 4 - hs)" y="@(b.Y - 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="nw" />
                <rect x="@(b.X + b.Width + 4 - hs)" y="@(b.Y - 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="ne" />
                <rect x="@(b.X - 4 - hs)" y="@(b.Y + b.Height + 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="sw" />
                <rect x="@(b.X + b.Width + 4 - hs)" y="@(b.Y + b.Height + 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="se" />
                <!-- Edge handles -->
                <rect x="@(b.X + b.Width / 2 - hs)" y="@(b.Y - 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="n" />
                <rect x="@(b.X + b.Width / 2 - hs)" y="@(b.Y + b.Height + 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="s" />
                <rect x="@(b.X - 4 - hs)" y="@(b.Y + b.Height / 2 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="w" />
                <rect x="@(b.X + b.Width + 4 - hs)" y="@(b.Y + b.Height / 2 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="e" />
            }
        }

        @if (ChainMode)
        {
            <!-- Chain mode indicators -->
            @if (ChainStartPoint != null)
            {
                <!-- Start point marker (click here to close) -->
                <circle cx="@ChainStartPoint.X" cy="@ChainStartPoint.Y" r="8" fill="none" stroke="#00cc00" stroke-width="2" stroke-dasharray="3 2" />
                <circle cx="@ChainStartPoint.X" cy="@ChainStartPoint.Y" r="3" fill="#00cc00" />
            }
            @if (ChainLastPoint != null)
            {
                <!-- Last endpoint marker (next shape starts here) -->
                <circle cx="@ChainLastPoint.X" cy="@ChainLastPoint.Y" r="6" fill="@StrokeColor" stroke="#fff" stroke-width="2" />
            }
        }
    </svg>

    @if (ShowTextInput)
    {
        <div class="text-input-overlay" @onclick="CloseTextInput">
            <div class="text-input-modal" @onclick:stopPropagation="true">
                <h3>Enter Text</h3>
                <textarea @bind="TextInputValue"
                          @ref="textInputElement"
                          rows="3"
                          placeholder="Type your text here..."></textarea>
                <div class="text-input-actions">
                    <button class="btn btn-secondary" @onclick="CloseTextInput">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmTextInput">Add Text</button>
                </div>
            </div>
        </div>
    }

    @if (SelectedElements.Count > 0)
    {
        <div class="properties-panel">
            <h4>Properties (@SelectedElements.Count selected)</h4>
            <div class="prop-row">
                <label>Stroke:</label>
                <input type="color" value="@GetSelectedStroke()" @onchange="OnSelectedStrokeChange" />
            </div>
            <div class="prop-row">
                <label>Width:</label>
                <select value="@GetSelectedStrokeWidthIndex()" @onchange="OnSelectedStrokeWidthChange">
                    <option value="0">1px</option>
                    <option value="1">2px</option>
                    <option value="2">4px</option>
                    <option value="3">6px</option>
                    <option value="4">8px</option>
                    <option value="5">12px</option>
                </select>
            </div>
            <div class="prop-row">
                <label>Fill:</label>
                <input type="color" value="@GetSelectedFill()" @onchange="OnSelectedFillChange" />
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelectedFill">None</button>
            </div>
            <div class="prop-row">
                <button class="btn btn-sm btn-outline-primary" @onclick="BringToFront">To Front</button>
                <button class="btn btn-sm btn-outline-primary" @onclick="BringForward">Forward</button>
            </div>
            <div class="prop-row">
                <button class="btn btn-sm btn-outline-primary" @onclick="SendBackward">Backward</button>
                <button class="btn btn-sm btn-outline-primary" @onclick="SendToBack">To Back</button>
            </div>
            <div class="prop-row">
                <button class="btn btn-sm btn-outline-danger" @onclick="DeleteSelected">Delete</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="DuplicateSelected">Duplicate</button>
            </div>
        </div>
    }

    <div class="ai-panel" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @onkeydown:stopPropagation="true">
        <div class="ai-header" @onclick="ToggleAiPanel">
            <span>AI Draw</span>
            <span class="ai-toggle">@(ShowAiPanel ? "▼" : "▶")</span>
        </div>
        @if (ShowAiPanel)
        {
            <div class="ai-content">
                <!-- Mode Toggle -->
                <div class="ai-mode-toggle">
                    <button class="mode-btn @(!UseCascadeMode ? "active" : "")" @onclick="() => UseCascadeMode = false">Single</button>
                    <button class="mode-btn @(UseCascadeMode ? "active" : "")" @onclick="() => UseCascadeMode = true">Cascade</button>
                </div>

                @if (!UseCascadeMode)
                {
                    <!-- Single Provider Mode (existing UI) -->
                    <div class="ai-provider-section">
                        <label>Provider:</label>
                        <select @bind="SelectedProvider" class="provider-select">
                            <option value="OllamaLocal">Ollama (localhost)</option>
                            <option value="Ollama">Ollama (Remote)</option>
                            <option value="Anthropic">Anthropic (Claude)</option>
                        </select>
                    </div>

                    @if (AiService.Provider == AiProvider.Ollama)
                    {
                        <div class="ai-key-section">
                            <label>Ollama Endpoint:</label>
                            <div class="endpoint-row">
                                <input type="text" @bind="OllamaEndpointInput" @bind:event="oninput" placeholder="http://10.10.48.219:11434" />
                                <button class="btn btn-sm btn-outline-primary" @onclick="RefreshOllamaModels" disabled="@OllamaModelsLoading">
                                    @(OllamaModelsLoading ? "..." : "Connect")
                                </button>
                            </div>
                            <label style="margin-top: 8px;">Model:</label>
                            @if (AvailableOllamaModels.Count > 0)
                            {
                                <select @bind="AiService.OllamaModel" class="model-select">
                                    @foreach (var model in AvailableOllamaModels)
                                    {
                                        <option value="@model">@model</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="text" @bind="AiService.OllamaModel" @bind:event="oninput" placeholder="deepseek-r1:14b" />
                            }
                            @if (!string.IsNullOrEmpty(OllamaStatus))
                            {
                                <span class="key-status @(OllamaStatusIsError ? "key-error" : "key-valid")">@OllamaStatus</span>
                            }
                        </div>
                    }
                    else if (AiService.Provider == AiProvider.OllamaLocal)
                    {
                        <div class="ai-key-section">
                            <div class="endpoint-row">
                                <label>Model:</label>
                                <button class="btn btn-sm btn-outline-primary" @onclick="RefreshOllamaModels" disabled="@OllamaModelsLoading" style="margin-left: auto;">
                                    @(OllamaModelsLoading ? "..." : "Refresh")
                                </button>
                            </div>
                            @if (AvailableOllamaModels.Count > 0)
                            {
                                <select @bind="AiService.OllamaModel" class="model-select">
                                    @foreach (var model in AvailableOllamaModels)
                                    {
                                        <option value="@model">@model</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="text" @bind="AiService.OllamaModel" @bind:event="oninput" placeholder="llama3.2" />
                            }
                            @if (!string.IsNullOrEmpty(OllamaStatus))
                            {
                                <span class="key-status @(OllamaStatusIsError ? "key-error" : "key-valid")">@OllamaStatus</span>
                            }
                            else
                            {
                                <span class="key-status key-valid" style="margin-top: 6px;">Using localhost:11434</span>
                            }
                        </div>
                    }
                    else if (AiService.Provider == AiProvider.Anthropic)
                    {
                        <div class="ai-key-section">
                            <label>API Key:</label>
                            <div class="api-key-row">
                                <input type="text" @bind="ApiKeyInput" @bind:event="oninput" placeholder="Paste Anthropic API key here..." disabled="@ApiKeyTesting" />
                                <button class="btn btn-sm btn-primary" @onclick="SaveApiKey" disabled="@ApiKeyTesting">
                                    @(ApiKeyTesting ? "Testing..." : "Set Key")
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(ApiKeyStatus))
                            {
                                <span class="key-status @(ApiKeyStatus == "Key valid!" ? "key-valid" : ApiKeyStatus == "Testing key..." ? "key-testing" : "key-error")">@ApiKeyStatus</span>
                            }
                            else if (!string.IsNullOrEmpty(AiService.ApiKey))
                            {
                                <span class="key-status key-valid">Key saved</span>
                            }
                        </div>
                    }
                }
                else
                {
                    <!-- Matrix-Based Cascade Mode UI -->
                    <div class="cascade-config-section">
                        <label>Preset:</label>
                        <select class="cascade-select" @bind="SelectedPresetIndex">
                            @for (int i = 0; i < CascadeService.Presets.Count; i++)
                            {
                                <option value="@i">@CascadeService.Presets[i].Name</option>
                            }
                        </select>

                        <!-- Matrix Slots -->
                        <div class="cascade-matrix">
                            <div class="matrix-slot @(!CascadeService.CurrentMatrix.Slot1.IsEmpty ? "active" : "")">
                                <span class="slot-number">#1</span>
                                <select @bind="Slot1Provider" class="slot-provider">
                                    <option value="">-- None --</option>
                                    <option value="Ollama">Ollama</option>
                                    <option value="Anthropic">Anthropic</option>
                                    <option value="OpenAI">OpenAI</option>
                                    <option value="DeepSeek">DeepSeek</option>
                                </select>
                                @if (!CascadeService.CurrentMatrix.Slot1.IsEmpty)
                                {
                                    <input type="text" @bind="CascadeService.CurrentMatrix.Slot1.Model" placeholder="Model" class="slot-model" />
                                    @if (CascadeService.CurrentMatrix.Slot1.Provider == "Ollama")
                                    {
                                        <input type="text" @bind="CascadeService.CurrentMatrix.Slot1.Endpoint" placeholder="localhost:11434" class="slot-endpoint" />
                                    }
                                }
                            </div>

                            <div class="matrix-slot @(!CascadeService.CurrentMatrix.Slot2.IsEmpty ? "active" : "")">
                                <span class="slot-number">#2</span>
                                <select @bind="Slot2Provider" class="slot-provider">
                                    <option value="">-- None --</option>
                                    <option value="Ollama">Ollama</option>
                                    <option value="Anthropic">Anthropic</option>
                                    <option value="OpenAI">OpenAI</option>
                                    <option value="DeepSeek">DeepSeek</option>
                                </select>
                                @if (!CascadeService.CurrentMatrix.Slot2.IsEmpty)
                                {
                                    <input type="text" @bind="CascadeService.CurrentMatrix.Slot2.Model" placeholder="Model" class="slot-model" />
                                    @if (CascadeService.CurrentMatrix.Slot2.Provider == "Ollama")
                                    {
                                        <input type="text" @bind="CascadeService.CurrentMatrix.Slot2.Endpoint" placeholder="localhost:11434" class="slot-endpoint" />
                                    }
                                }
                            </div>

                            <div class="matrix-slot @(!CascadeService.CurrentMatrix.Slot3.IsEmpty ? "active" : "")">
                                <span class="slot-number">#3</span>
                                <select @bind="Slot3Provider" class="slot-provider">
                                    <option value="">-- None --</option>
                                    <option value="Ollama">Ollama</option>
                                    <option value="Anthropic">Anthropic</option>
                                    <option value="OpenAI">OpenAI</option>
                                    <option value="DeepSeek">DeepSeek</option>
                                </select>
                                @if (!CascadeService.CurrentMatrix.Slot3.IsEmpty)
                                {
                                    <input type="text" @bind="CascadeService.CurrentMatrix.Slot3.Model" placeholder="Model" class="slot-model" />
                                    @if (CascadeService.CurrentMatrix.Slot3.Provider == "Ollama")
                                    {
                                        <input type="text" @bind="CascadeService.CurrentMatrix.Slot3.Endpoint" placeholder="localhost:11434" class="slot-endpoint" />
                                    }
                                }
                            </div>
                        </div>

                        <!-- Routing description -->
                        <div class="cascade-routing">
                            @CascadeService.GetRoutingDescription()
                        </div>

                        <!-- API Keys for cascade (shares keys with Single mode) -->
                        <div class="cascade-keys">
                            @if (CascadeNeedsAnthropicKey && string.IsNullOrEmpty(AiService.ApiKey))
                            {
                                <div class="cascade-key-row">
                                    <label>Anthropic Key:</label>
                                    <input type="password" @bind="CascadeAnthropicKeyInput" placeholder="sk-ant-..." />
                                    <span class="key-hint">(or set in Single mode)</span>
                                </div>
                            }
                            else if (CascadeNeedsAnthropicKey)
                            {
                                <div class="cascade-key-row">
                                    <span class="key-status key-valid">Using Anthropic key from Single mode</span>
                                </div>
                            }
                            @if (CascadeNeedsOpenAIKey)
                            {
                                <div class="cascade-key-row">
                                    <label>OpenAI Key:</label>
                                    <input type="password" @bind="CascadeOpenAIKey" placeholder="sk-..." />
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="ai-prompt-section">
                    <label>Prompt:</label>
                    <textarea @bind="AiPrompt" @bind:event="oninput" placeholder="Describe what to draw...&#10;e.g., 'a red house with a blue roof and green grass'" rows="4"></textarea>

                    <div class="ai-options">
                        <label><input type="checkbox" @bind="AiClearBeforeGenerate" /> Clear canvas first</label>
                        <label><input type="checkbox" @bind="LockCanvasSize" /> Lock canvas size</label>
                        @if (UseCascadeMode)
                        {
                            <label><input type="checkbox" @bind="CascadeReverse" /> Reverse order</label>
                        }
                    </div>

                    @if (UseCascadeMode)
                    {
                        <button class="btn btn-primary ai-generate-btn" @onclick="GenerateWithCascade" disabled="@(AiGenerating || !CanRunCascade)">
                            @(AiGenerating ? "Running Cascade..." : (CascadeReverse ? "Run Cascade (Reverse)" : "Run Cascade"))
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary ai-generate-btn" @onclick="GenerateFromAi" disabled="@(AiGenerating || (AiService.Provider == AiProvider.Anthropic && string.IsNullOrEmpty(AiService.ApiKey)))">
                            @(AiGenerating ? "Generating..." : "Generate Drawing")
                        </button>
                    }
                </div>

                <!-- Cascade Progress -->
                @if (UseCascadeMode && CascadeStepResults.Count > 0)
                {
                    <div class="cascade-progress">
                        @foreach (var step in CascadeStepResults)
                        {
                            <div class="cascade-progress-step @step.Status.ToString().ToLower() @(ExpandedCascadeStep == step.StepId ? "expanded" : "")">
                                <div class="step-header" @onclick="() => ToggleCascadeStep(step.StepId)">
                                    <span class="step-status-icon">@GetStatusIcon(step.Status)</span>
                                    <span class="step-name">@step.StepName</span>
                                    <span class="step-time">@(step.ElapsedMs)ms</span>
                                    @if (!string.IsNullOrEmpty(step.Output) || !string.IsNullOrEmpty(step.Error))
                                    {
                                        <span class="step-expand-icon">@(ExpandedCascadeStep == step.StepId ? "▼" : "▶")</span>
                                    }
                                </div>
                                @if (ExpandedCascadeStep == step.StepId && !string.IsNullOrEmpty(step.Output))
                                {
                                    <div class="step-output">
                                        <pre>@TruncateOutput(step.Output, 2000)</pre>
                                    </div>
                                }
                                @if (ExpandedCascadeStep == step.StepId && !string.IsNullOrEmpty(step.Error))
                                {
                                    <div class="step-error">
                                        <pre>@step.Error</pre>
                                    </div>
                                }
                            </div>
                        }
                        @if (CascadeTotalMs > 0)
                        {
                            <div class="cascade-total-time">Total: @CascadeTotalMs ms</div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(AiThinking))
                {
                    <div class="ai-thinking">@AiThinking</div>
                }
                @if (!string.IsNullOrEmpty(AiError))
                {
                    <div class="ai-error">@AiError</div>
                }
                @if (AiResult != null)
                {
                    <div class="ai-result">
                        Created @AiResult.ElementsCreated elements
                    </div>
                }
            </div>
        }
    </div>
</div>

@inject HttpClient Http

@code {
    private ElementReference svgElement;
    private ElementReference containerElement;
    private ElementReference textInputElement;
    private ElementReference fileInputElement;
    private List<VectorElement> Elements = new();
    private bool IsImporting = false;
    private string? ImportMessage;
    private VectorElement? CurrentElement;
    private bool IsDrawing;
    private Point? StartPoint;

    // Fill toggle state
    private bool UseFillToggle = false;

    private int CurrentToolIndex = 2; // Pencil default
    private int StrokeWidthIndex = 1; // 2px default
    private int FontSizeIndex = 1; // 16px default
    private int PolygonSides = 6;
    private int StarPoints = 5;
    private string StrokeColor = "#000000";
    private string FillColor = "#3498db";
    private int CanvasWidth = 1400;
    private int CanvasHeight = 900;
    private const int MaxElements = 500;
    private bool TouchEnabled = true;

    // Text input modal
    private bool ShowTextInput = false;
    private string TextInputValue = "";
    private Point? TextPosition;

    // Input detection
    private string InputHint = "Mouse ready [S=Select, P=Pencil, L=Line, R=Rect, C=Circle, E=Ellipse, T=Triangle, G=Polygon, A=Arrow, X=Text, K=Chain]";
    private double CurrentPressure = 1.0;

    // Selection state
    private List<VectorElement> SelectedElements = new();
    private bool IsSelecting = false;
    private Point? SelectionStart;
