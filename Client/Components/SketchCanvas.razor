            ActionType.GroupElements => $"{svgStart}<rect x=\"1\" y=\"1\" width=\"6\" height=\"6\" rx=\"1\"/><rect x=\"9\" y=\"9\" width=\"6\" height=\"6\" rx=\"1\"/><path d=\"M7 4h2M12 7v2\" stroke-dasharray=\"1\"/>{svgEnd}",
