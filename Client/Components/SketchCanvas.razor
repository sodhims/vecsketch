    }

    private static readonly string[] ImageExtensions = { ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp" };
    private static readonly string[] VectorExtensions = { ".svg" };

    private async Task OnFileSelected(ChangeEventArgs e)
    {
        var fileInput = e.Value?.ToString();
        if (string.IsNullOrEmpty(fileInput)) return;

        IsImporting = true;
        ImportMessage = null;
        StateHasChanged();

        try
        {
            // Get the file from JavaScript
            var fileData = await JS.InvokeAsync<FileData>("getSelectedFile", fileInputElement);
            if (fileData == null || fileData.Data == null)
            {
                ImportMessage = "Could not read file";
                return;
            }

            var extension = Path.GetExtension(fileData.Name).ToLowerInvariant();

            // Handle image files directly (no server needed)
            if (ImageExtensions.Contains(extension))
            {
                await ImportImageFile(fileData, extension);
                return;
            }

            // Handle SVG files - parse as vector elements
            if (VectorExtensions.Contains(extension))
            {
                await ImportSvgFile(fileData);
                return;
            }

            // Handle AI/PDF files via server
            using var content = new MultipartFormDataContent();
            var bytes = Convert.FromBase64String(fileData.Data);
            var fileContent = new ByteArrayContent(bytes);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/octet-stream");
            content.Add(fileContent, "file", fileData.Name);

            var response = await Http.PostAsync("api/import/ai", content);
            var result = await response.Content.ReadFromJsonAsync<ImportResult>();

            if (result != null && result.Success && result.Elements.Count > 0)
            {
                // Calculate bounding box of all imported elements
                var allBounds = CalculateImportBounds(result.Elements);

                // Calculate scale to fit canvas with padding
                var padding = 50.0;
                var availableWidth = CanvasWidth - padding * 2;
                var availableHeight = CanvasHeight - padding * 2;
                var scaleX = allBounds.Width > 0 ? availableWidth / allBounds.Width : 1;
                var scaleY = allBounds.Height > 0 ? availableHeight / allBounds.Height : 1;
                var scale = Math.Min(scaleX, scaleY);
                scale = Math.Min(scale, 2.0); // Don't scale up more than 2x

                // Calculate offset to center
                var offsetX = padding - allBounds.MinX * scale + (availableWidth - allBounds.Width * scale) / 2;
                var offsetY = padding - allBounds.MinY * scale + (availableHeight - allBounds.Height * scale) / 2;

                // Add imported elements with transformation
                foreach (var el in result.Elements)
                {
                    var element = ConvertImportedElement(el, scale, offsetX, offsetY);
                    if (element != null)
                        CurrentLayer.Elements.Add(element);
                }
                ImportMessage = result.Message;
            }
            else
            {
                ImportMessage = result?.Message ?? "Import failed";
            }
        }
        catch (Exception ex)
        {
            ImportMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsImporting = false;
            StateHasChanged();
        }
    }

    private async Task ImportImageFile(FileData fileData, string extension)
    {
        try
        {
            // Get image dimensions from JavaScript
            var mimeType = extension switch
            {
                ".png" => "image/png",
                ".jpg" or ".jpeg" => "image/jpeg",
                ".gif" => "image/gif",
                ".webp" => "image/webp",
                ".bmp" => "image/bmp",
                ".svg" => "image/svg+xml",
                _ => "image/png"
            };

            var dataUrl = $"data:{mimeType};base64,{fileData.Data}";
            var dimensions = await JS.InvokeAsync<ImageDimensions>("getImageDimensions", dataUrl);

            if (dimensions == null || dimensions.Width == 0 || dimensions.Height == 0)
            {
                ImportMessage = "Could not read image dimensions";
                return;
            }

            // Scale image to fit canvas if too large
            var scale = 1.0;
            var maxWidth = CanvasWidth * 0.8;
            var maxHeight = CanvasHeight * 0.8;

            if (dimensions.Width > maxWidth)
                scale = maxWidth / dimensions.Width;
            if (dimensions.Height * scale > maxHeight)
                scale = maxHeight / dimensions.Height;

            var scaledWidth = dimensions.Width * scale;
            var scaledHeight = dimensions.Height * scale;

            var imageElement = new ImageElement
            {
                X = (CanvasWidth - scaledWidth) / 2,
                Y = (CanvasHeight - scaledHeight) / 2,
                Width = scaledWidth,
                Height = scaledHeight,
                DataUrl = dataUrl
            };

            CurrentLayer.Elements.Add(imageElement);
            ImportMessage = $"Imported {fileData.Name}";
        }
        finally
        {
            IsImporting = false;
            StateHasChanged();
        }
    }

    private async Task ImportSvgFile(FileData fileData)
    {
        try
        {
            // Decode base64 SVG content
            var svgBytes = Convert.FromBase64String(fileData.Data);
            var svgContent = System.Text.Encoding.UTF8.GetString(svgBytes);

            // Parse SVG using JavaScript (browser's DOMParser)
            var elements = await JS.InvokeAsync<List<SvgImportElement>>("parseSvgContent", svgContent);

            if (elements == null || elements.Count == 0)
            {
                ImportMessage = "No vector elements found in SVG";
                return;
            }

            // Calculate bounds of all elements
            double minX = double.MaxValue, minY = double.MaxValue;
            double maxX = double.MinValue, maxY = double.MinValue;

            foreach (var el in elements)
            {
                minX = Math.Min(minX, el.X);
                minY = Math.Min(minY, el.Y);
                maxX = Math.Max(maxX, el.X + el.Width);
                maxY = Math.Max(maxY, el.Y + el.Height);
            }

            var importWidth = maxX - minX;
            var importHeight = maxY - minY;

            // Scale to fit canvas
            var scale = 1.0;
            var maxWidth = CanvasWidth * 0.8;
            var maxHeight = CanvasHeight * 0.8;

            if (importWidth > maxWidth)
                scale = maxWidth / importWidth;
            if (importHeight * scale > maxHeight)
                scale = maxHeight / importHeight;

            // Center offset
            var offsetX = (CanvasWidth - importWidth * scale) / 2 - minX * scale;
            var offsetY = (CanvasHeight - importHeight * scale) / 2 - minY * scale;

            // Convert and add elements
            int count = 0;
            foreach (var el in elements)
            {
                var element = ConvertSvgElement(el, scale, offsetX, offsetY);
                if (element != null)
                {
                    CurrentLayer.Elements.Add(element);
                    count++;
                }
            }

            ImportMessage = $"Imported {count} elements from {fileData.Name}";
        }
        catch (Exception ex)
        {
            ImportMessage = $"SVG import error: {ex.Message}";
        }
        finally
        {
            IsImporting = false;
            StateHasChanged();
        }
    }

    private VectorElement? ConvertSvgElement(SvgImportElement el, double scale, double offsetX, double offsetY)
    {
        var stroke = string.IsNullOrEmpty(el.Stroke) || el.Stroke == "none" ? "#000000" : el.Stroke;
        var fill = string.IsNullOrEmpty(el.Fill) ? "none" : el.Fill;
        var strokeWidth = el.StrokeWidth > 0 ? el.StrokeWidth * scale : 2;

        switch (el.Type)
        {
            case "rect":
                return new RectElement
                {
                    X = el.X * scale + offsetX,
                    Y = el.Y * scale + offsetY,
                    Width = el.Width * scale,
                    Height = el.Height * scale,
                    Stroke = stroke,
                    StrokeWidth = strokeWidth,
                    Fill = fill
                };

            case "circle":
                return new CircleElement
                {
                    Cx = el.Cx * scale + offsetX,
                    Cy = el.Cy * scale + offsetY,
                    Radius = el.R * scale,
                    Stroke = stroke,
                    StrokeWidth = strokeWidth,
                    Fill = fill
                };

            case "ellipse":
                return new EllipseElement
                {
                    Cx = el.Cx * scale + offsetX,
                    Cy = el.Cy * scale + offsetY,
                    Rx = el.Rx * scale,
                    Ry = el.Ry * scale,
                    Stroke = stroke,
                    StrokeWidth = strokeWidth,
                    Fill = fill
                };

            case "line":
                return new LineElement
                {
                    X1 = el.X1 * scale + offsetX,
                    Y1 = el.Y1 * scale + offsetY,
                    X2 = el.X2 * scale + offsetX,
                    Y2 = el.Y2 * scale + offsetY,
                    Stroke = stroke,
                    StrokeWidth = strokeWidth
                };

            case "path":
                if (string.IsNullOrEmpty(el.D)) return null;
                return new SvgPathElement
                {
                    D = ScaleSvgPathData(el.D, scale, offsetX, offsetY),
                    Stroke = stroke,
                    StrokeWidth = strokeWidth,
                    Fill = fill
                };

            case "polygon":
            case "polyline":
                if (string.IsNullOrEmpty(el.Points)) return null;
                var pathD = ConvertPointsToPath(el.Points, el.Type == "polygon", scale, offsetX, offsetY);
                return new SvgPathElement
                {
                    D = pathD,
                    Stroke = stroke,
                    StrokeWidth = strokeWidth,
                    Fill = el.Type == "polygon" ? fill : "none"
                };

            default:
                return null;
        }
    }

    private string ScaleSvgPathData(string d, double scale, double offsetX, double offsetY)
    {
        // Simple path scaling - handles M, L, C, Q, Z commands
        var result = new System.Text.StringBuilder();
        var parts = System.Text.RegularExpressions.Regex.Split(d, @"(?=[MLCQZmlcqzHVhvSsTtAa])");

        foreach (var part in parts)
        {
            if (string.IsNullOrWhiteSpace(part)) continue;

            var cmd = part[0];
            var coords = part.Substring(1).Trim();

            if (cmd == 'Z' || cmd == 'z')
            {
                result.Append(cmd);
                continue;
            }

            var numbers = System.Text.RegularExpressions.Regex.Matches(coords, @"-?[\d.]+");
            var values = numbers.Cast<System.Text.RegularExpressions.Match>()
                .Select(m => double.TryParse(m.Value, System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0)
                .ToList();

            result.Append(cmd);

            // Scale coordinates based on command type
            bool isRelative = char.IsLower(cmd);
            for (int i = 0; i < values.Count; i++)
            {
                if (i > 0) result.Append(' ');

                var val = values[i];
                if (isRelative)
                {
                    // Relative commands - just scale
                    result.Append((val * scale).ToString("F2", System.Globalization.CultureInfo.InvariantCulture));
                }
                else
                {
                    // Absolute commands - scale and offset
                    bool isX = (i % 2 == 0);
                    var offset = isX ? offsetX : offsetY;
                    result.Append((val * scale + offset).ToString("F2", System.Globalization.CultureInfo.InvariantCulture));
                }
            }
        }

        return result.ToString();
    }

    private string ConvertPointsToPath(string points, bool closePath, double scale, double offsetX, double offsetY)
    {
        var result = new System.Text.StringBuilder();
        var coords = System.Text.RegularExpressions.Regex.Matches(points, @"-?[\d.]+");
        var values = coords.Cast<System.Text.RegularExpressions.Match>()
            .Select(m => double.TryParse(m.Value, System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0)
            .ToList();

        for (int i = 0; i < values.Count - 1; i += 2)
        {
            var x = values[i] * scale + offsetX;
            var y = values[i + 1] * scale + offsetY;
            result.Append(i == 0 ? "M " : " L ");
            result.Append(x.ToString("F2", System.Globalization.CultureInfo.InvariantCulture));
            result.Append(' ');
            result.Append(y.ToString("F2", System.Globalization.CultureInfo.InvariantCulture));
        }

        if (closePath) result.Append(" Z");
        return result.ToString();
    }

    private class SvgImportElement
    {
        public string Type { get; set; } = "";
        public double X { get; set; }
        public double Y { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
        public double Cx { get; set; }
        public double Cy { get; set; }
        public double R { get; set; }
        public double Rx { get; set; }
        public double Ry { get; set; }
        public double X1 { get; set; }
        public double Y1 { get; set; }
        public double X2 { get; set; }
        public double Y2 { get; set; }
        public string? D { get; set; }
        public string? Points { get; set; }
        public string? Stroke { get; set; }
        public string? Fill { get; set; }
        public double StrokeWidth { get; set; }
    }

    private class ImageDimensions
    {
        public int Width { get; set; }
        public int Height { get; set; }
    }

    private (double MinX, double MinY, double Width, double Height) CalculateImportBounds(List<ImportedElement> elements)
    {
        double minX = double.MaxValue, minY = double.MaxValue;
        double maxX = double.MinValue, maxY = double.MinValue;

        foreach (var el in elements)
        {
            if (el.Type == "path" && !string.IsNullOrEmpty(el.D))
            {
                var pathBounds = ParsePathBoundsSimple(el.D);
                minX = Math.Min(minX, pathBounds.minX);
                minY = Math.Min(minY, pathBounds.minY);
                maxX = Math.Max(maxX, pathBounds.maxX);
                maxY = Math.Max(maxY, pathBounds.maxY);
            }
            else if (el.Type == "rect" || el.Type == "image")
            {
                minX = Math.Min(minX, el.X);
                minY = Math.Min(minY, el.Y);
                maxX = Math.Max(maxX, el.X + el.Width);
                maxY = Math.Max(maxY, el.Y + el.Height);
            }
        }

        if (minX == double.MaxValue) return (0, 0, 100, 100);
        return (minX, minY, maxX - minX, maxY - minY);
    }

    private (double minX, double minY, double maxX, double maxY) ParsePathBoundsSimple(string d)
    {
        double minX = double.MaxValue, minY = double.MaxValue;
        double maxX = double.MinValue, maxY = double.MinValue;

        // Simple regex to find all numbers in the path
        var numbers = System.Text.RegularExpressions.Regex.Matches(d, @"-?\d+\.?\d*");
        for (int i = 0; i < numbers.Count - 1; i += 2)
        {
            if (double.TryParse(numbers[i].Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var x) &&
                double.TryParse(numbers[i + 1].Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var y))
            {
                minX = Math.Min(minX, x);
                minY = Math.Min(minY, y);
                maxX = Math.Max(maxX, x);
                maxY = Math.Max(maxY, y);
            }
        }

        if (minX == double.MaxValue) return (0, 0, 100, 100);
        return (minX, minY, maxX, maxY);
    }

    private VectorElement? ConvertImportedElement(ImportedElement el, double scale, double offsetX, double offsetY)
    {
        return el.Type switch
        {
            "path" when !string.IsNullOrEmpty(el.D) => new SvgPathElement
            {
                D = TransformPath(el.D, scale, offsetX, offsetY),
                Stroke = el.Stroke,
                StrokeWidth = el.StrokeWidth * scale,
                Fill = el.Fill
            },
            "rect" => new RectElement
            {
                X = el.X * scale + offsetX,
                Y = el.Y * scale + offsetY,
                Width = el.Width * scale,
                Height = el.Height * scale,
                Stroke = el.Stroke,
                StrokeWidth = el.StrokeWidth * scale,
                Fill = el.Fill
            },
            "image" when !string.IsNullOrEmpty(el.DataUrl) => new ImageElement
            {
                X = el.X * scale + offsetX,
                Y = el.Y * scale + offsetY,
                Width = el.Width * scale,
                Height = el.Height * scale,
                DataUrl = el.DataUrl
            },
            _ => null
        };
    }

    private string TransformPath(string d, double scale, double offsetX, double offsetY)
    {
        // Transform all coordinates in the path
        var result = System.Text.RegularExpressions.Regex.Replace(d, @"(-?\d+\.?\d*)\s+(-?\d+\.?\d*)", match =>
        {
            if (double.TryParse(match.Groups[1].Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var x) &&
                double.TryParse(match.Groups[2].Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var y))
            {
                var newX = x * scale + offsetX;
                var newY = y * scale + offsetY;
                return $"{newX:F2} {newY:F2}";
            }
            return match.Value;
        });
        return result;
    }

