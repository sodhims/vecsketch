                    GroupId = root.TryGetProperty("GroupId", out var gid2) ? gid2.GetString() : null
                },
                "Circle" => new CircleElement
                {
                    Id = root.GetProperty("Id").GetString() ?? Guid.NewGuid().ToString(),
                    Cx = root.GetProperty("Cx").GetDouble(),
                    Cy = root.GetProperty("Cy").GetDouble(),
                    Radius = root.GetProperty("Radius").GetDouble(),
                    Stroke = root.GetProperty("Stroke").GetString() ?? "#000000",
                    StrokeWidth = root.GetProperty("StrokeWidth").GetDouble(),
                    Fill = root.GetProperty("Fill").GetString() ?? "none",
                    GroupId = root.TryGetProperty("GroupId", out var gid3) ? gid3.GetString() : null
                },
                "Ellipse" => new EllipseElement
                {
                    Id = root.GetProperty("Id").GetString() ?? Guid.NewGuid().ToString(),
