        }

        CloseRecordingEditor();
    }

    private void DuplicateAction(int index)
    {
        if (EditingRecording == null || index < 0 || index >= EditingRecording.Actions.Count) return;

        var original = EditingRecording.Actions[index];
        var json = System.Text.Json.JsonSerializer.Serialize(original);
        var duplicate = System.Text.Json.JsonSerializer.Deserialize<RecordedAction>(json);
        if (duplicate != null)
        {
            // Generate new element ID if it's a create action
            if (duplicate.Type == ActionType.CreateElement && !string.IsNullOrEmpty(duplicate.ElementId))
            {
                duplicate.ElementId = Guid.NewGuid().ToString();
                // Update the ID in the ElementJson as well
                if (!string.IsNullOrEmpty(duplicate.ElementJson))
                {
                    duplicate.ElementJson = duplicate.ElementJson.Replace(original.ElementId!, duplicate.ElementId);
                }
            }
            // Insert after original with 100ms offset
            duplicate.TimestampMs = original.TimestampMs + 100;
            EditingRecording.Actions.Insert(index + 1, duplicate);
            // Re-sort by timestamp
            EditingRecording.Actions = EditingRecording.Actions.OrderBy(a => a.TimestampMs).ToList();
            SelectedActionIndex = EditingRecording.Actions.IndexOf(duplicate);
            StateHasChanged();
        }
    }

    private void ReverseActions()
    {
        if (EditingRecording == null || EditingRecording.Actions.Count < 2) return;

        if (CheckedActionIndices.Count >= 2)
        {
            // Reverse only checked actions - swap their timestamps
            var checkedIndices = CheckedActionIndices.OrderBy(i => i).ToList();
            var checkedTimestamps = checkedIndices.Select(i => EditingRecording.Actions[i].TimestampMs).ToList();

            // Assign timestamps in reverse order to checked actions
            for (int i = 0; i < checkedIndices.Count; i++)
            {
                EditingRecording.Actions[checkedIndices[i]].TimestampMs = checkedTimestamps[checkedIndices.Count - 1 - i];
            }

            // Re-sort by timestamp
            EditingRecording.Actions = EditingRecording.Actions.OrderBy(a => a.TimestampMs).ToList();
            CheckedActionIndices.Clear();
        }
        else
        {
            // Reverse all actions
            var timestamps = EditingRecording.Actions.Select(a => a.TimestampMs).ToList();
            EditingRecording.Actions.Reverse();
            for (int i = 0; i < EditingRecording.Actions.Count; i++)
            {
                EditingRecording.Actions[i].TimestampMs = timestamps[i];
            }
        }

        SelectedActionIndex = -1;
        StateHasChanged();
    }

    private void AddDelayAction()
    {
        if (EditingRecording == null) return;

        // Determine where to insert delay
        var insertIndex = SelectedActionIndex >= 0 ? SelectedActionIndex : EditingRecording.Actions.Count - 1;
        if (insertIndex < 0) insertIndex = 0;

        var insertTime = insertIndex < EditingRecording.Actions.Count
            ? EditingRecording.Actions[insertIndex].TimestampMs
            : EditingRecording.DurationMs;

        // Shift all subsequent actions by 1000ms (1 second delay)
        for (int i = insertIndex + 1; i < EditingRecording.Actions.Count; i++)
        {
            EditingRecording.Actions[i].TimestampMs += 1000;
        }

        StateHasChanged();
    }

    private void ClearAllActions()
    {
        if (EditingRecording == null) return;
        EditingRecording.Actions.Clear();
        SelectedActionIndex = -1;
        CheckedActionIndices.Clear();
        StateHasChanged();
    }

    private void DeleteCheckedActions()
    {
        if (EditingRecording == null || CheckedActionIndices.Count == 0) return;

        // Remove in reverse order to maintain indices
        foreach (var idx in CheckedActionIndices.OrderByDescending(i => i))
        {
            if (idx >= 0 && idx < EditingRecording.Actions.Count)
            {
                EditingRecording.Actions.RemoveAt(idx);
            }
        }
        CheckedActionIndices.Clear();
        SelectedActionIndex = -1;
        StateHasChanged();
    }

    private async Task PreviewChecked()
    {
        if (EditingRecording == null || IsReplaying || CheckedActionIndices.Count == 0) return;

        // Create a temporary recording with only checked actions
        var tempRecording = new Recording
        {
            Id = EditingRecording.Id,
            Name = EditingRecording.Name,
            CanvasWidth = EditingRecording.CanvasWidth,
            CanvasHeight = EditingRecording.CanvasHeight,
            CanvasFill = EditingRecording.CanvasFill,
            Actions = new List<RecordedAction>()
        };

        var checkedIndices = CheckedActionIndices.OrderBy(i => i).ToList();
        var startTime = EditingRecording.Actions[checkedIndices[0]].TimestampMs;

        foreach (var idx in checkedIndices)
        {
            if (idx >= 0 && idx < EditingRecording.Actions.Count)
            {
                var json = System.Text.Json.JsonSerializer.Serialize(EditingRecording.Actions[idx]);
                var action = System.Text.Json.JsonSerializer.Deserialize<RecordedAction>(json);
                if (action != null)
                {
                    action.TimestampMs = EditingRecording.Actions[idx].TimestampMs - startTime;
                    tempRecording.Actions.Add(action);
                }
            }
        }

        await StartReplay(tempRecording);
    }

    private async Task PreviewFromSelected()
    {
        if (EditingRecording == null || IsReplaying || SelectedActionIndex < 0) return;

        // Create a temporary recording with only actions from selected index onward
        var tempRecording = new Recording
        {
            Id = EditingRecording.Id,
            Name = EditingRecording.Name,
            CanvasWidth = EditingRecording.CanvasWidth,
            CanvasHeight = EditingRecording.CanvasHeight,
            CanvasFill = EditingRecording.CanvasFill,
            Actions = new List<RecordedAction>()
        };

        // Calculate time offset (start from 0)
        var startTime = EditingRecording.Actions[SelectedActionIndex].TimestampMs;

        for (int i = SelectedActionIndex; i < EditingRecording.Actions.Count; i++)
        {
            var json = System.Text.Json.JsonSerializer.Serialize(EditingRecording.Actions[i]);
            var action = System.Text.Json.JsonSerializer.Deserialize<RecordedAction>(json);
            if (action != null)
            {
                action.TimestampMs = EditingRecording.Actions[i].TimestampMs - startTime;
                tempRecording.Actions.Add(action);
            }
        }

        await StartReplay(tempRecording);
    }

    private void CopySelected()
    {
        if (SelectedElements.Count == 0) return;

        Clipboard.Clear();
        foreach (var el in SelectedElements)
        {
            var clone = CloneElement(el);
            if (clone != null)
                Clipboard.Add(clone);
        }
        PasteCount = 0; // Reset paste offset counter
        InputHint = $"Copied {Clipboard.Count} element(s) to clipboard";
        StateHasChanged();
    }

    private void PasteFromClipboard()
    {
        // If we have internal clipboard items, paste those
        if (Clipboard.Count > 0)
        {
            SaveUndoState();
            PasteCount++;
            var offset = PasteCount * 20; // Cascade offset for multiple pastes

            ClearSelection();
            foreach (var el in Clipboard)
            {
                var clone = CloneElement(el);
                if (clone != null)
                {
                    MoveElement(clone, offset, offset);
                    CurrentLayer.Elements.Add(clone);
                    clone.IsSelected = true;
                    SelectedElements.Add(clone);
                }
            }
            InputHint = $"Pasted {Clipboard.Count} element(s)";
            StateHasChanged();
        }
        else
        {
            // Fall back to system clipboard for images/text
            _ = JS.InvokeVoidAsync("pasteFromClipboard");
        }
    }

    private VectorElement? CloneElement(VectorElement el)
    {
        return el switch
        {
            LineElement line => new LineElement { X1 = line.X1, Y1 = line.Y1, X2 = line.X2, Y2 = line.Y2, Stroke = line.Stroke, StrokeWidth = line.StrokeWidth, Fill = line.Fill },
            PathElement path => new PathElement { Points = path.Points.ToList(), Stroke = path.Stroke, StrokeWidth = path.StrokeWidth, Fill = path.Fill, Pressure = path.Pressure },
            RectElement rect => new RectElement { X = rect.X, Y = rect.Y, Width = rect.Width, Height = rect.Height, Stroke = rect.Stroke, StrokeWidth = rect.StrokeWidth, Fill = rect.Fill },
            CircleElement circle => new CircleElement { Cx = circle.Cx, Cy = circle.Cy, Radius = circle.Radius, Stroke = circle.Stroke, StrokeWidth = circle.StrokeWidth, Fill = circle.Fill },
            EllipseElement ellipse => new EllipseElement { Cx = ellipse.Cx, Cy = ellipse.Cy, Rx = ellipse.Rx, Ry = ellipse.Ry, Stroke = ellipse.Stroke, StrokeWidth = ellipse.StrokeWidth, Fill = ellipse.Fill },
            TriangleElement tri => new TriangleElement { X1 = tri.X1, Y1 = tri.Y1, X2 = tri.X2, Y2 = tri.Y2, X3 = tri.X3, Y3 = tri.Y3, Stroke = tri.Stroke, StrokeWidth = tri.StrokeWidth, Fill = tri.Fill },
            PolygonElement poly => new PolygonElement { Cx = poly.Cx, Cy = poly.Cy, Radius = poly.Radius, Sides = poly.Sides, Stroke = poly.Stroke, StrokeWidth = poly.StrokeWidth, Fill = poly.Fill },
            StarElement star => new StarElement { Cx = star.Cx, Cy = star.Cy, OuterRadius = star.OuterRadius, InnerRadius = star.InnerRadius, Points = star.Points, Stroke = star.Stroke, StrokeWidth = star.StrokeWidth, Fill = star.Fill },
            ArrowElement arrow => new ArrowElement { X1 = arrow.X1, Y1 = arrow.Y1, X2 = arrow.X2, Y2 = arrow.Y2, HeadSize = arrow.HeadSize, Stroke = arrow.Stroke, StrokeWidth = arrow.StrokeWidth, Fill = arrow.Fill },
            ImageElement img => new ImageElement { X = img.X, Y = img.Y, Width = img.Width, Height = img.Height, DataUrl = img.DataUrl, Stroke = img.Stroke, StrokeWidth = img.StrokeWidth, Fill = img.Fill },
            TextElement txt => new TextElement { X = txt.X, Y = txt.Y, Text = txt.Text, FontSize = txt.FontSize, FontFamily = txt.FontFamily, Stroke = txt.Stroke, StrokeWidth = txt.StrokeWidth, Fill = txt.Fill },
            SvgPathElement svgPath => new SvgPathElement { D = svgPath.D, Stroke = svgPath.Stroke, StrokeWidth = svgPath.StrokeWidth, Fill = svgPath.Fill },
            _ => null
        };
    }

