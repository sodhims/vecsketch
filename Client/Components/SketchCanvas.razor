    private void AddLayer()
    {
        SaveUndoState();
        var newLayer = new Layer { Name = $"Layer {Layers.Count + 1}" };
        Layers.Add(newLayer);
        CurrentLayerIndex = Layers.Count - 1;
    }

    private void ShowDeleteLayerConfirm()
    {
        if (Layers.Count <= 1) return;
        ShowDeleteLayerDialog = true;
    }

    private void DeleteLayerTransferDown()
    {
        if (Layers.Count <= 1 || CurrentLayerIndex <= 0) return;
        SaveUndoState();

        // Transfer elements to the layer below
        var targetLayer = Layers[CurrentLayerIndex - 1];
        var sourceElements = Layers[CurrentLayerIndex].Elements;

        // Clear selection for transferred elements
        foreach (var el in sourceElements)
        {
            if (el.IsSelected)
            {
                el.IsSelected = false;
                SelectedElements.Remove(el);
            }
        }

        // Add all elements to target layer
        targetLayer.Elements.AddRange(sourceElements);

        // Remove the current layer
        Layers.RemoveAt(CurrentLayerIndex);
        CurrentLayerIndex = Math.Min(CurrentLayerIndex, Layers.Count - 1);

        ShowDeleteLayerDialog = false;
    }

    private void DeleteLayerAndContents()
    {
        if (Layers.Count <= 1) return;
        SaveUndoState();

        // Clear selection if any selected elements are in this layer
        var layerElements = Layers[CurrentLayerIndex].Elements;
        foreach (var el in layerElements)
        {
            if (el.IsSelected)
            {
                el.IsSelected = false;
                SelectedElements.Remove(el);
            }
        }

        Layers.RemoveAt(CurrentLayerIndex);
        if (CurrentLayerIndex >= Layers.Count)
            CurrentLayerIndex = Layers.Count - 1;

        ShowDeleteLayerDialog = false;
    }

    private void SelectLayer(int index)
    {
        if (index >= 0 && index < Layers.Count)
            CurrentLayerIndex = index;
    }

    private bool AreAllLayerElementsSelected(int layerIndex)
    {
        if (layerIndex < 0 || layerIndex >= Layers.Count) return false;
        var layer = Layers[layerIndex];
        if (layer.Elements.Count == 0) return false;
        return layer.Elements.All(el => el.IsSelected);
    }

    private void ToggleSelectAllOnLayer(int layerIndex, bool selectAll)
    {
        if (layerIndex < 0 || layerIndex >= Layers.Count) return;
        var layer = Layers[layerIndex];

        if (selectAll)
        {
            // Select all elements on this layer
            foreach (var el in layer.Elements)
            {
                if (!el.IsSelected)
                {
                    el.IsSelected = true;
                    SelectedElements.Add(el);
                }
            }
            InputHint = $"Selected all {layer.Elements.Count} element(s) on {layer.Name}";
        }
        else
        {
            // Deselect all elements on this layer
            foreach (var el in layer.Elements)
            {
                if (el.IsSelected)
                {
                    el.IsSelected = false;
                    SelectedElements.Remove(el);
                }
            }
            InputHint = $"Deselected all elements on {layer.Name}";
        }
        UpdateSelectionHint();
        StateHasChanged();
    }

    private void ToggleLayerVisibility(int index)
    {
        if (index >= 0 && index < Layers.Count)
        {
            SaveUndoState();
            Layers[index].IsVisible = !Layers[index].IsVisible;

            // Deselect elements in hidden layers
            if (!Layers[index].IsVisible)
            {
                foreach (var el in Layers[index].Elements)
                {
                    if (el.IsSelected)
                    {
                        el.IsSelected = false;
                        SelectedElements.Remove(el);
                    }
                }
            }
        }
    }

    private void ToggleLayerLock(int index)
    {
        if (index >= 0 && index < Layers.Count)
        {
            SaveUndoState();
            Layers[index].IsLocked = !Layers[index].IsLocked;
        }
    }

