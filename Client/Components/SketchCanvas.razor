                                        <pre>@TruncateOutput(step.Input, 1000)</pre>
                                    </div>
                                }
                                @if (isExpanded && !string.IsNullOrEmpty(step.Output))
                                {
                                    <div class="step-output">
                                        <label>Output:</label>
                                        <pre>@TruncateOutput(step.Output, 2000)</pre>
                                    </div>
                                }
                                @if (isExpanded && !string.IsNullOrEmpty(step.Error))
                                {
                                    <div class="step-error">
                                        <pre>@step.Error</pre>
                                    </div>
                                }
                            </div>
                        }
                        @if (CascadeTotalMs > 0)
                        {
                            <div class="cascade-total-time">Total: @CascadeTotalMs ms</div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(AiThinking))
                {
                    <div class="ai-thinking">@AiThinking</div>
                }
                @if (!string.IsNullOrEmpty(AiError))
                {
                    <div class="ai-error">@AiError</div>
                }
                @if (AiResult != null)
                {
                    <div class="ai-result">
                        Created @AiResult.ElementsCreated elements
                    </div>
                }
            </div>
        }
    </div>
</div>

