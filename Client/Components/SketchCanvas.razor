    }

    private void AlignCenterV()
    {
        if (SelectedElements.Count < 2) return;
        SaveUndoState();
        var centerY = SelectedElements.Average(e => { var b = e.GetBounds(); return b.Y + b.Height / 2; });
        foreach (var el in SelectedElements)
        {
            var bounds = el.GetBounds();
            var dy = centerY - (bounds.Y + bounds.Height / 2);
