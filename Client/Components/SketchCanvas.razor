    private string GetArcPreviewPath()
    {
        // Calculate bezier control point so curve passes through ArcMidX, ArcMidY
        var ctrlX = 2 * ArcMidX - 0.5 * ArcStartX - 0.5 * ArcEndX;
        var ctrlY = 2 * ArcMidY - 0.5 * ArcStartY - 0.5 * ArcEndY;
        return $"<path d=\"M {ArcStartX:F2} {ArcStartY:F2} Q {ctrlX:F2} {ctrlY:F2} {ArcEndX:F2} {ArcEndY:F2}\" stroke=\"{StrokeColor}\" stroke-width=\"{StrokeWidth}\" fill=\"none\" stroke-dasharray=\"6 4\" opacity=\"0.7\" />";
    }

