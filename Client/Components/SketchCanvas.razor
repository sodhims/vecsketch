    }

    private void AlignBottom()
    {
        if (SelectedElements.Count < 2) return;
        SaveUndoState();
        var maxBottom = SelectedElements.Max(e => { var b = e.GetBounds(); return b.Y + b.Height; });
        foreach (var el in SelectedElements)
        {
            var bounds = el.GetBounds();
            var dy = maxBottom - (bounds.Y + bounds.Height);
            if (Math.Abs(dy) > 0.01) MoveElement(el, 0, dy);
        }
        StateHasChanged();
    }

    private void DistributeH()
    {
        if (SelectedElements.Count < 3) return;
        SaveUndoState();
        var sorted = SelectedElements.OrderBy(e => e.GetBounds().X).ToList();
        var leftmost = sorted.First().GetBounds();
        var rightmost = sorted.Last().GetBounds();
        var totalWidth = (rightmost.X + rightmost.Width) - leftmost.X;
        var elementsWidth = sorted.Sum(e => e.GetBounds().Width);
        var spacing = (totalWidth - elementsWidth) / (sorted.Count - 1);
        var currentX = leftmost.X;
        foreach (var el in sorted)
        {
            var bounds = el.GetBounds();
            var dx = currentX - bounds.X;
            if (Math.Abs(dx) > 0.01) MoveElement(el, dx, 0);
            currentX += bounds.Width + spacing;
        }
        StateHasChanged();
    }

    private void DistributeV()
    {
        if (SelectedElements.Count < 3) return;
        SaveUndoState();
        var sorted = SelectedElements.OrderBy(e => e.GetBounds().Y).ToList();
        var topmost = sorted.First().GetBounds();
        var bottommost = sorted.Last().GetBounds();
        var totalHeight = (bottommost.Y + bottommost.Height) - topmost.Y;
        var elementsHeight = sorted.Sum(e => e.GetBounds().Height);
        var spacing = (totalHeight - elementsHeight) / (sorted.Count - 1);
        var currentY = topmost.Y;
        foreach (var el in sorted)
        {
            var bounds = el.GetBounds();
            var dy = currentY - bounds.Y;
            if (Math.Abs(dy) > 0.01) MoveElement(el, 0, dy);
            currentY += bounds.Height + spacing;
        }
        StateHasChanged();
    }

    private void ArrangeGrid()
    {
        if (SelectedElements.Count < 2) return;
        SaveUndoState();
        var cols = (int)Math.Ceiling(Math.Sqrt(SelectedElements.Count));
        var sorted = SelectedElements.OrderBy(e => e.GetBounds().Y).ThenBy(e => e.GetBounds().X).ToList();
        var maxWidth = sorted.Max(e => e.GetBounds().Width);
        var maxHeight = sorted.Max(e => e.GetBounds().Height);
        var startX = sorted.Min(e => e.GetBounds().X);
        var startY = sorted.Min(e => e.GetBounds().Y);
        var spacing = 20.0;

        for (int i = 0; i < sorted.Count; i++)
        {
            var row = i / cols;
            var col = i % cols;
            var targetX = startX + col * (maxWidth + spacing);
            var targetY = startY + row * (maxHeight + spacing);
            var bounds = sorted[i].GetBounds();
            var dx = targetX - bounds.X;
            var dy = targetY - bounds.Y;
            if (Math.Abs(dx) > 0.01 || Math.Abs(dy) > 0.01)
                MoveElement(sorted[i], dx, dy);
        }
        StateHasChanged();
    }

    private void DuplicateSelected()
    {
        SaveUndoState();
        var newElements = new List<VectorElement>();
        // Map old group IDs to new group IDs for duplicated elements
        var groupIdMap = new Dictionary<string, string>();

        foreach (var el in SelectedElements)
        {
            var clone = CloneElement(el);
            if (clone != null)
            {
                MoveElement(clone, 20, 20); // Offset the duplicate
                // Preserve grouping with new group IDs
                if (!string.IsNullOrEmpty(el.GroupId))
                {
                    if (!groupIdMap.ContainsKey(el.GroupId))
                        groupIdMap[el.GroupId] = Guid.NewGuid().ToString();
                    clone.GroupId = groupIdMap[el.GroupId];
                }
                newElements.Add(clone);
            }
        }
        // Clear selection without message
        foreach (var el in SelectedElements)
            el.IsSelected = false;
        SelectedElements.Clear();

        foreach (var el in newElements)
        {
            CurrentLayer.Elements.Add(el);
            el.IsSelected = true;
            SelectedElements.Add(el);
        }
        UpdateSelectionHint();
    }

    private void GroupSelected()
    {
        if (SelectedElements.Count < 2) return;
        SaveUndoState();

        var groupId = Guid.NewGuid().ToString();
        var elementIds = SelectedElements.Select(e => e.Id).ToList();
        foreach (var el in SelectedElements)
        {
            el.GroupId = groupId;
        }
        RecordAction(ActionType.GroupElements, elementIds: elementIds, groupId: groupId);
        InputHint = $"Grouped {SelectedElements.Count} elements";
        StateHasChanged();
    }

    private void UngroupSelected()
    {
        if (SelectedElements.Count == 0) return;
        SaveUndoState();

        var ungroupedCount = 0;
        var elementIds = new List<string>();
        foreach (var el in SelectedElements)
        {
            if (el.GroupId != null)
            {
                elementIds.Add(el.Id);
                el.GroupId = null;
                ungroupedCount++;
            }
        }
        if (elementIds.Count > 0)
            RecordAction(ActionType.UngroupElements, elementIds: elementIds);
        InputHint = $"Ungrouped {ungroupedCount} elements";
        StateHasChanged();
    }

    private bool HasGroupedSelection()
    {
        return SelectedElements.Any(el => el.GroupId != null);
    }

    private bool HasDecomposableShapes()
    {
        if (SelectedElements.Count < 2) return false;
        // Must have at least 2 decomposable shapes (circles, ellipses, rects, polygons, triangles, svgpaths)
        var decomposable = SelectedElements.Where(e =>
            e is CircleElement || e is EllipseElement ||
            e is RectElement || e is PolygonElement || e is TriangleElement || e is SvgPathElement).ToList();
        return decomposable.Count >= 2;
    }

    private void DecomposeSelected()
    {
        var decomposable = SelectedElements.Where(e =>
            e is CircleElement || e is EllipseElement ||
            e is RectElement || e is PolygonElement || e is TriangleElement || e is SvgPathElement).ToList();

        if (decomposable.Count < 2) return;

        SaveUndoState();

        var regions = ShapeDecomposer.Decompose(decomposable);

        if (regions.Count == 0)
        {
            InputHint = "No overlapping regions found";
            StateHasChanged();
            return;
        }

        // Remove original shapes
        foreach (var el in decomposable)
        {
            el.IsSelected = false;
            CurrentLayer.Elements.Remove(el);
        }

        // Clear selection
        foreach (var el in SelectedElements.ToList())
        {
            if (decomposable.Contains(el))
                SelectedElements.Remove(el);
        }

        // Add decomposed regions as SvgPathElements
        foreach (var region in regions)
        {
            var pathElement = new SvgPathElement
            {
                D = region.PathData,
                Fill = region.Color,
                Stroke = "#333333",
                StrokeWidth = 0.5
            };
            CurrentLayer.Elements.Add(pathElement);
            RecordAction(ActionType.CreateElement, pathElement);
        }

        InputHint = $"Created {regions.Count} regions";
        StateHasChanged();
    }

    private void SelectGroupMembers(VectorElement element)
    {
        if (string.IsNullOrEmpty(element.GroupId)) return;

        // Find all elements in the same group across all layers
        foreach (var layer in Layers)
        {
            foreach (var el in layer.Elements)
            {
                if (el.GroupId == element.GroupId && !el.IsSelected)
                {
                    el.IsSelected = true;
                    SelectedElements.Add(el);
                }
            }
        }
    }

    // =====================================================
    // Recording Methods
    // =====================================================

    private void StartRecording()
    {
        if (IsRecording) return;

        CurrentRecording = new Recording
        {
            Name = RecordingName,
            CanvasWidth = CanvasWidth,
            CanvasHeight = CanvasHeight,
            CanvasFill = _canvasFill
        };
        RecordingStopwatch = System.Diagnostics.Stopwatch.StartNew();
        IsRecording = true;
        InputHint = "Recording started...";
        StateHasChanged();
    }

    private void StopRecording()
    {
        if (!IsRecording || CurrentRecording == null) return;

        RecordingStopwatch?.Stop();
        IsRecording = false;
        InputHint = $"Recording stopped. {CurrentRecording.Actions.Count} actions recorded.";
        StateHasChanged();
    }

    private void SaveRecording()
    {
        if (CurrentRecording == null || CurrentRecording.Actions.Count == 0)
        {
            InputHint = "No recording to save";
            return;
        }

        CurrentRecording.Name = RecordingName;
        SavedRecordings.Add(CurrentRecording);
        _ = JS.InvokeVoidAsync("localStorage.setItem", $"vecsketch-recording-{CurrentRecording.Id}",
            System.Text.Json.JsonSerializer.Serialize(CurrentRecording));

        // Save the list of recording IDs
        var recordingIds = SavedRecordings.Select(r => r.Id).ToList();
        _ = JS.InvokeVoidAsync("localStorage.setItem", "vecsketch-recordings",
            System.Text.Json.JsonSerializer.Serialize(recordingIds));

        InputHint = $"Recording '{CurrentRecording.Name}' saved!";
        CurrentRecording = null; // Clear after saving so UI returns to initial state
        StateHasChanged();
    }

    private async Task LoadSavedRecordings()
    {
        try
        {
            var idsJson = await JS.InvokeAsync<string?>("localStorage.getItem", "vecsketch-recordings");
            if (string.IsNullOrEmpty(idsJson)) return;

            var ids = System.Text.Json.JsonSerializer.Deserialize<List<string>>(idsJson);
            if (ids == null) return;

            SavedRecordings.Clear();
            foreach (var id in ids)
            {
                var recJson = await JS.InvokeAsync<string?>("localStorage.getItem", $"vecsketch-recording-{id}");
                if (!string.IsNullOrEmpty(recJson))
                {
                    var rec = System.Text.Json.JsonSerializer.Deserialize<Recording>(recJson);
                    if (rec != null)
                        SavedRecordings.Add(rec);
                }
            }
        }
        catch { }
    }

    private void RecordAction(ActionType type, VectorElement? element = null,
        double? deltaX = null, double? deltaY = null,
        int? layerIndex = null, string? layerName = null,
        List<string>? elementIds = null, string? groupId = null)
    {
        if (!IsRecording || CurrentRecording == null || RecordingStopwatch == null) return;

        var action = new RecordedAction
        {
            Type = type,
            TimestampMs = RecordingStopwatch.ElapsedMilliseconds,
            ElementId = element?.Id,
            ElementType = element?.GetType().Name,
            DeltaX = deltaX,
            DeltaY = deltaY,
            LayerIndex = layerIndex,
            LayerName = layerName,
            ElementIds = elementIds,
            GroupId = groupId
        };

        // Serialize element if creating/modifying
        if (element != null && (type == ActionType.CreateElement || type == ActionType.ModifyElement))
        {
            action.ElementJson = SerializeElement(element);
        }

        CurrentRecording.Actions.Add(action);
    }

    private string SerializeElement(VectorElement el)
    {
        var options = new System.Text.Json.JsonSerializerOptions { WriteIndented = false };
        return el switch
        {
            LineElement line => System.Text.Json.JsonSerializer.Serialize(new { Type = "Line", line.Id, line.X1, line.Y1, line.X2, line.Y2, line.Stroke, line.StrokeWidth, line.Fill, line.GroupId }, options),
            PathElement path => System.Text.Json.JsonSerializer.Serialize(new { Type = "Path", path.Id, path.Points, path.Stroke, path.StrokeWidth, path.Fill, path.GroupId }, options),
            RectElement rect => System.Text.Json.JsonSerializer.Serialize(new { Type = "Rect", rect.Id, rect.X, rect.Y, rect.Width, rect.Height, rect.Stroke, rect.StrokeWidth, rect.Fill, rect.GroupId }, options),
            CircleElement circle => System.Text.Json.JsonSerializer.Serialize(new { Type = "Circle", circle.Id, circle.Cx, circle.Cy, circle.Radius, circle.Stroke, circle.StrokeWidth, circle.Fill, circle.GroupId }, options),
            EllipseElement ellipse => System.Text.Json.JsonSerializer.Serialize(new { Type = "Ellipse", ellipse.Id, ellipse.Cx, ellipse.Cy, ellipse.Rx, ellipse.Ry, ellipse.Stroke, ellipse.StrokeWidth, ellipse.Fill, ellipse.GroupId }, options),
            TextElement txt => System.Text.Json.JsonSerializer.Serialize(new { Type = "Text", txt.Id, txt.X, txt.Y, txt.Text, txt.FontSize, txt.FontFamily, txt.Stroke, txt.StrokeWidth, txt.Fill, txt.GroupId }, options),
            TriangleElement tri => System.Text.Json.JsonSerializer.Serialize(new { Type = "Triangle", tri.Id, tri.X1, tri.Y1, tri.X2, tri.Y2, tri.X3, tri.Y3, tri.Stroke, tri.StrokeWidth, tri.Fill, tri.GroupId }, options),
            PolygonElement poly => System.Text.Json.JsonSerializer.Serialize(new { Type = "Polygon", poly.Id, poly.Cx, poly.Cy, poly.Radius, poly.Sides, poly.Stroke, poly.StrokeWidth, poly.Fill, poly.GroupId }, options),
            StarElement star => System.Text.Json.JsonSerializer.Serialize(new { Type = "Star", star.Id, star.Cx, star.Cy, star.OuterRadius, star.InnerRadius, star.Points, star.Stroke, star.StrokeWidth, star.Fill, star.GroupId }, options),
            ArrowElement arrow => System.Text.Json.JsonSerializer.Serialize(new { Type = "Arrow", arrow.Id, arrow.X1, arrow.Y1, arrow.X2, arrow.Y2, arrow.HeadSize, arrow.Stroke, arrow.StrokeWidth, arrow.Fill, arrow.GroupId }, options),
            ArcElement arc => System.Text.Json.JsonSerializer.Serialize(new { Type = "Arc", arc.Id, arc.X1, arc.Y1, arc.MidX, arc.MidY, arc.X2, arc.Y2, arc.ShowArrow, arc.HeadSize, arc.Stroke, arc.StrokeWidth, arc.Fill, arc.GroupId }, options),
            SvgPathElement svgPath => System.Text.Json.JsonSerializer.Serialize(new { Type = "SvgPath", svgPath.Id, svgPath.D, svgPath.Stroke, svgPath.StrokeWidth, svgPath.Fill, svgPath.GroupId }, options),
            _ => "{}"
        };
    }

    private async Task StartReplay(Recording recording)
    {
        if (IsReplaying) return;

        // Clear canvas and set up for replay
        SaveUndoState();
        foreach (var layer in Layers) layer.Elements.Clear();
        ClearSelection();
        CanvasWidth = recording.CanvasWidth;
        CanvasHeight = recording.CanvasHeight;
        _canvasFill = recording.CanvasFill ?? "white";

        IsReplaying = true;
        ReplayIndex = 0;
        ReplayCts = new System.Threading.CancellationTokenSource();
        InputHint = $"Replaying '{recording.Name}'...";
        StateHasChanged();

        try
        {
            long lastTimestamp = 0;
            foreach (var action in recording.Actions)
            {
                if (ReplayCts.Token.IsCancellationRequested) break;

                // Wait for the time delta
                var delay = (int)(action.TimestampMs - lastTimestamp);
                if (delay > 0)
                    await Task.Delay(Math.Min(delay, 2000), ReplayCts.Token); // Cap delay at 2s

                await ReplayAction(action);
                lastTimestamp = action.TimestampMs;
                ReplayIndex++;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }

        IsReplaying = false;
        ReplayCts = null;
        InputHint = "Replay complete!";
        StateHasChanged();
    }

    private void StopReplay()
    {
        ReplayCts?.Cancel();
    }

    private async Task ReplayAction(RecordedAction action)
    {
        switch (action.Type)
        {
            case ActionType.CreateElement:
                if (!string.IsNullOrEmpty(action.ElementJson))
                {
                    var element = DeserializeElement(action.ElementJson);
                    if (element != null)
                        CurrentLayer.Elements.Add(element);
                }
                break;

            case ActionType.MoveElement:
                if (action.ElementId != null && action.DeltaX.HasValue && action.DeltaY.HasValue)
                {
                    var el = FindElementById(action.ElementId);
                    if (el != null)
                        MoveElement(el, action.DeltaX.Value, action.DeltaY.Value);
                }
                break;

            case ActionType.DeleteElement:
                if (action.ElementId != null)
                {
                    var el = FindElementById(action.ElementId);
                    if (el != null)
                    {
                        foreach (var layer in Layers)
                            layer.Elements.Remove(el);
                    }
                }
                break;

            case ActionType.AddLayer:
                Layers.Add(new Layer { Name = action.LayerName ?? $"Layer {Layers.Count + 1}" });
                break;

            case ActionType.SelectLayer:
                if (action.LayerIndex.HasValue && action.LayerIndex.Value < Layers.Count)
                    CurrentLayerIndex = action.LayerIndex.Value;
                break;

            case ActionType.GroupElements:
                if (action.ElementIds != null && action.GroupId != null)
                {
                    foreach (var id in action.ElementIds)
                    {
                        var el = FindElementById(id);
                        if (el != null) el.GroupId = action.GroupId;
                    }
                }
                break;

            case ActionType.UngroupElements:
                if (action.ElementIds != null)
                {
                    foreach (var id in action.ElementIds)
                    {
                        var el = FindElementById(id);
                        if (el != null) el.GroupId = null;
                    }
                }
                break;

            case ActionType.Clear:
                foreach (var layer in Layers) layer.Elements.Clear();
                break;
        }

        await Task.CompletedTask;
    }

    private VectorElement? FindElementById(string id)
    {
        foreach (var layer in Layers)
        {
            var el = layer.Elements.FirstOrDefault(e => e.Id == id);
            if (el != null) return el;
        }
        return null;
    }

    private VectorElement? DeserializeElement(string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            var type = root.GetProperty("Type").GetString();

            return type switch
            {
                "Line" => new LineElement
                {
                    Id = root.GetProperty("Id").GetString() ?? Guid.NewGuid().ToString(),
                    X1 = root.GetProperty("X1").GetDouble(),
                    Y1 = root.GetProperty("Y1").GetDouble(),
                    X2 = root.GetProperty("X2").GetDouble(),
                    Y2 = root.GetProperty("Y2").GetDouble(),
                    Stroke = root.GetProperty("Stroke").GetString() ?? "#000000",
                    StrokeWidth = root.GetProperty("StrokeWidth").GetDouble(),
                    Fill = root.GetProperty("Fill").GetString() ?? "none",
                    GroupId = root.TryGetProperty("GroupId", out var gid) ? gid.GetString() : null
                },
                "Path" => DeserializePathElement(root),
                "Rect" => new RectElement
                {
                    Id = root.GetProperty("Id").GetString() ?? Guid.NewGuid().ToString(),
                    X = root.GetProperty("X").GetDouble(),
                    Y = root.GetProperty("Y").GetDouble(),
                    Width = root.GetProperty("Width").GetDouble(),
                    Height = root.GetProperty("Height").GetDouble(),
                    Stroke = root.GetProperty("Stroke").GetString() ?? "#000000",
                    StrokeWidth = root.GetProperty("StrokeWidth").GetDouble(),
