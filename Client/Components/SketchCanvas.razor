            ActionType.AddLayer => $"{svgStart}<rect x=\"2\" y=\"6\" width=\"8\" height=\"6\" rx=\"1\"/><rect x=\"6\" y=\"4\" width=\"8\" height=\"6\" rx=\"1\"/><line x1=\"10\" y1=\"1\" x2=\"10\" y2=\"4\"/><line x1=\"8\" y1=\"2.5\" x2=\"12\" y2=\"2.5\"/>{svgEnd}",
            ActionType.DeleteLayer => $"{svgStart}<rect x=\"2\" y=\"6\" width=\"8\" height=\"6\" rx=\"1\"/><rect x=\"6\" y=\"4\" width=\"8\" height=\"6\" rx=\"1\" stroke-dasharray=\"2\"/>{svgEnd}",
            ActionType.SelectLayer => $"{svgStart}<rect x=\"3\" y=\"5\" width=\"10\" height=\"7\" rx=\"1\"/><line x1=\"3\" y1=\"8\" x2=\"13\" y2=\"8\"/>{svgEnd}",
            ActionType.SetCanvasSize => $"{svgStart}<rect x=\"2\" y=\"2\" width=\"12\" height=\"12\" rx=\"1\" stroke-dasharray=\"2\"/><path d=\"M10 6h4v4\" fill=\"none\"/>{svgEnd}",
            ActionType.SetCanvasFill => $"{svgStart}<rect x=\"2\" y=\"2\" width=\"12\" height=\"12\" rx=\"1\" fill=\"currentColor\" opacity=\"0.3\"/>{svgEnd}",
            ActionType.Clear => $"{svgStart}<rect x=\"2\" y=\"2\" width=\"12\" height=\"12\" rx=\"1\"/><line x1=\"5\" y1=\"5\" x2=\"11\" y2=\"11\"/><line x1=\"11\" y1=\"5\" x2=\"5\" y2=\"11\"/>{svgEnd}",
            _ => $"{svgStart}<circle cx=\"8\" cy=\"8\" r=\"2\" fill=\"currentColor\"/>{svgEnd}"
        };
    }

    private void UpdateActionTime(int index, ChangeEventArgs e)
    {
        if (EditingRecording == null || index < 0 || index >= EditingRecording.Actions.Count) return;
        if (double.TryParse(e.Value?.ToString(), out var seconds))
        {
            EditingRecording.Actions[index].TimestampMs = (long)(seconds * 1000);
            // Re-sort by timestamp
            EditingRecording.Actions = EditingRecording.Actions.OrderBy(a => a.TimestampMs).ToList();
            StateHasChanged();
        }
    }

    private void MoveActionUp(int index)
    {
        if (EditingRecording == null || index <= 0) return;
        var action = EditingRecording.Actions[index];
        var prevAction = EditingRecording.Actions[index - 1];
        // Swap timestamps
        (action.TimestampMs, prevAction.TimestampMs) = (prevAction.TimestampMs, action.TimestampMs);
        // Swap positions
        EditingRecording.Actions[index] = prevAction;
        EditingRecording.Actions[index - 1] = action;
        SelectedActionIndex = index - 1;
        StateHasChanged();
    }

    private void MoveActionDown(int index)
    {
        if (EditingRecording == null || index >= EditingRecording.Actions.Count - 1) return;
        var action = EditingRecording.Actions[index];
        var nextAction = EditingRecording.Actions[index + 1];
        // Swap timestamps
        (action.TimestampMs, nextAction.TimestampMs) = (nextAction.TimestampMs, action.TimestampMs);
        // Swap positions
        EditingRecording.Actions[index] = nextAction;
        EditingRecording.Actions[index + 1] = action;
        SelectedActionIndex = index + 1;
        StateHasChanged();
    }

    private void DeleteAction(int index)
    {
        if (EditingRecording == null || index < 0 || index >= EditingRecording.Actions.Count) return;
        EditingRecording.Actions.RemoveAt(index);
        if (SelectedActionIndex >= EditingRecording.Actions.Count)
            SelectedActionIndex = EditingRecording.Actions.Count - 1;
        StateHasChanged();
    }

    private void NormalizeGaps()
    {
        if (EditingRecording == null || EditingRecording.Actions.Count == 0) return;

        // If checked actions, normalize gaps between them
        if (CheckedActionIndices.Count > 1)
        {
            var checkedIndices = CheckedActionIndices.OrderBy(i => i).ToList();
            var firstTime = EditingRecording.Actions[checkedIndices[0]].TimestampMs;
            var lastTime = EditingRecording.Actions[checkedIndices[^1]].TimestampMs;
            var totalSpan = lastTime - firstTime;
            var gap = totalSpan / (checkedIndices.Count - 1);
            gap = Math.Clamp(gap, 200, 500);

            for (int i = 0; i < checkedIndices.Count; i++)
            {
                EditingRecording.Actions[checkedIndices[i]].TimestampMs = firstTime + (i * gap);
            }
        }
        else
        {
            // Apply to all
            var totalDuration = EditingRecording.DurationMs;
            var avgGap = totalDuration / Math.Max(EditingRecording.Actions.Count, 1);
            var gap = Math.Clamp(avgGap, 200, 500);
            for (int i = 0; i < EditingRecording.Actions.Count; i++)
            {
                EditingRecording.Actions[i].TimestampMs = i * gap;
            }
        }

        // Re-sort and clear selection
        EditingRecording.Actions = EditingRecording.Actions.OrderBy(a => a.TimestampMs).ToList();
        CheckedActionIndices.Clear();
        StateHasChanged();
    }

    private void ScaleTiming(double factor)
    {
        if (EditingRecording == null) return;

        // If no actions are checked, apply to all
        var indicesToScale = CheckedActionIndices.Count > 0
            ? CheckedActionIndices
            : Enumerable.Range(0, EditingRecording.Actions.Count).ToHashSet();

        foreach (var idx in indicesToScale)
        {
            if (idx >= 0 && idx < EditingRecording.Actions.Count)
            {
                EditingRecording.Actions[idx].TimestampMs = (long)(EditingRecording.Actions[idx].TimestampMs * factor);
            }
        }
        // Re-sort by timestamp after scaling
        EditingRecording.Actions = EditingRecording.Actions.OrderBy(a => a.TimestampMs).ToList();
        // Clear checked indices since order may have changed
        CheckedActionIndices.Clear();
        StateHasChanged();
    }

