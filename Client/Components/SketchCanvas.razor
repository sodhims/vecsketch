@namespace VecSketch.Client.Components
@using VecSketch.Client.Models
@using VecSketch.Client.Services
@using VecSketch.Shared
@using DrawingTool = VecSketch.Client.Models.DrawingTool
@using VectorElement = VecSketch.Client.Models.VectorElement
@using Point = VecSketch.Client.Models.Point
@using DrawCommand = VecSketch.Client.Models.DrawCommand
@using CommandResult = VecSketch.Client.Models.CommandResult
@inject IJSRuntime JS
@inject AiDrawingService AiService
@inject CascadeService CascadeService
@implements IDisposable

<div class="sketch-container @CurrentThemeClass" @ref="containerElement" tabindex="0" @onkeydown="OnKeyDown">
    <div class="toolbar">
        <select @bind="CurrentToolIndex" class="tool-select" title="Drawing tool">
            <option value="0">Select</option>
            <option value="1">Line</option>
            <option value="2">Pencil</option>
            <option value="3">Rect</option>
            <option value="4">Circle</option>
            <option value="5">Ellipse</option>
            <option value="6">Triangle</option>
            <option value="7">Polygon</option>
            <option value="8">Star</option>
            <option value="9">Arrow</option>
            <option value="10">Arc</option>
            <option value="11">Text</option>
        </select>

        <button class="btn btn-sm @(ChainMode ? "btn-success" : "btn-outline-secondary")"
                @onclick="ToggleChainMode" title="Chain mode (K)">⛓</button>

        <button class="btn btn-sm @(ArrayMode ? "btn-success" : "btn-outline-secondary")"
                @onclick="() => ArrayMode = !ArrayMode" title="Array mode">▦</button>
        @if (ArrayMode)
        {
            <select @bind="ArrayCount" class="width-select" title="Copies">
                @for (int i = 2; i <= 10; i++) { <option value="@i">@i</option> }
            </select>
            <button class="btn btn-xs @(ArrayHorizontal ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => ArrayHorizontal = true" title="Horizontal">H</button>
            <button class="btn btn-xs @(!ArrayHorizontal ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => ArrayHorizontal = false" title="Vertical">V</button>
            <select @bind="ArraySpacing" class="width-select" title="Spacing">
                @foreach (var sp in new[] {30,50,75,100,150}) { <option value="@sp">@sp</option> }
            </select>
        }

        @if (CurrentTool == DrawingTool.Polygon)
        {
            <select @bind="PolygonSides" class="width-select" title="Sides">
                @foreach (var s in new[] {3,5,6,8,10,12}) { <option value="@s">@s</option> }
            </select>
        }

        @if (CurrentTool == DrawingTool.Star)
        {
            <select @bind="StarPoints" class="width-select" title="Points">
                @foreach (var p in new[] {4,5,6,8}) { <option value="@p">@p</option> }
            </select>
        }

        @if (CurrentTool == DrawingTool.Text)
        {
            <select @bind="FontSizeIndex" class="width-select" title="Font size">
                <option value="0">12</option>
                <option value="1">16</option>
                <option value="2">20</option>
                <option value="3">24</option>
                <option value="4">32</option>
                <option value="5">48</option>
            </select>
        }

        @if (CurrentTool == DrawingTool.Arc)
        {
            <input type="checkbox" @bind="ArcShowArrow" title="Show arrow" />
        }

        <input type="color" @bind="StrokeColor" class="color-picker" title="Stroke color" />

        <select @bind="StrokeWidthIndex" class="width-select" title="Stroke width">
            <option value="0">1</option>
            <option value="1">2</option>
            <option value="2">4</option>
            <option value="3">6</option>
            <option value="4">8</option>
            <option value="5">12</option>
        </select>

        <input type="checkbox" @bind="UseFillToggle" title="Enable fill" />
        <input type="color" @bind="FillColor" class="color-picker" title="Fill color" disabled="@(!UseFillToggle)" />

        <input type="checkbox" checked="@TouchEnabled" @onchange="OnTouchToggleChange" title="Touch enabled" />

        <select @bind="CurrentTheme" class="tool-select" @bind:after="OnThemeChanged" title="Theme">
            <option value="">Theme</option>
            <option value="pinkish">Pink</option>
            <option value="reddish">Red</option>
            <option value="orangish">Orange</option>
            <option value="yellowish">Yellow</option>
            <option value="greenish">Green</option>
            <option value="bluish">Blue</option>
            <option value="purplish">Purple</option>
            <option value="preppy">Preppy</option>
            <option value="darkish">Dark</option>
        </select>

        <span class="release-label" title="Build timestamp">@BuildTimestamp.Substring(11)</span>

        <div class="tool-group actions">
            <button class="btn btn-sm btn-outline-light" @onclick="OnPasteClick" title="Paste">📋</button>
            <button class="btn btn-sm btn-outline-light" @onclick="OnClearClick" title="Clear">🗑</button>
            <button class="btn btn-sm btn-outline-light" @onclick="OnCleanupClick" title="Cleanup">🧹</button>
            <button class="btn btn-sm btn-outline-light" @onclick="OnUndoClick" title="Undo">↩</button>
            <button class="btn btn-sm btn-outline-light" @onclick="OnExportClick" title="Export">💾</button>
            <button class="btn btn-sm btn-outline-light" @onclick="OnImportClick" disabled="@IsImporting" title="Import">📂</button>
            <button class="btn btn-sm @(ShowLayersPanel ? "btn-warning" : "btn-outline-light")" @onclick="ToggleLayersPanel" title="Layers">☰</button>
            <button class="btn btn-sm @(ShowRecordingPanel ? "btn-warning" : "btn-outline-light") @(IsRecording ? "recording-active" : "")" @onclick="ToggleRecordingPanel" title="Record">
                @(IsRecording ? "●" : "⏺")
            </button>
        </div>
    </div>

    <input type="file" @ref="fileInputElement" accept=".ai,.pdf,.png,.jpg,.jpeg,.gif,.webp,.bmp,.svg" style="display: none;" @onchange="OnFileSelected" />

    <div class="canvas-info">
        <span>@Elements.Count/@MaxElements</span>
        <div class="progress" style="width: 80px; height: 8px;">
            <div class="progress-bar" role="progressbar" style="width: @GetProgressPercent()%"></div>
        </div>
        <span class="input-hint">@InputHint</span>
    </div>

    <svg @ref="svgElement"
         width="100%"
         height="100%"
         viewBox="0 0 @CanvasWidth @CanvasHeight"
         preserveAspectRatio="xMidYMid meet"
         class="canvas @(CurrentToolIndex == 0 ? "select-mode" : "")"
         @onpointerdown="OnPointerDown"
         @onpointermove="OnPointerMove"
         @onpointerup="OnPointerUp"
         @onpointerleave="OnPointerUp"
         @onpointercancel="OnPointerUp"
         @oncontextmenu:preventDefault="true">

        <defs>
            <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#eee" stroke-width="0.5"/>
            </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />

        @foreach (var element in Elements)
        {
            @((MarkupString)element.ToSvg())
        }

        @if (IsDrawing && CurrentElement != null)
        {
            @((MarkupString)CurrentElement.ToSvg())
        }

        @* Arc drawing preview with markers *@
        @if (CurrentTool == DrawingTool.Arc && ArcClickPhase > 0)
        {
            @* Start point marker (green) *@
            <circle cx="@ArcStartX" cy="@ArcStartY" r="6" fill="#22c55e" stroke="white" stroke-width="2" />

            @if (ArcClickPhase == 1)
            {
                @* Dotted line to show direction when waiting for end point *@
                <line x1="@ArcStartX" y1="@ArcStartY" x2="@ArcPreviewX" y2="@ArcPreviewY"
                      stroke="@StrokeColor" stroke-width="1" stroke-dasharray="4 4" opacity="0.5" />
                @* Preview end marker (follows mouse) *@
                <circle cx="@ArcPreviewX" cy="@ArcPreviewY" r="5" fill="none" stroke="#ef4444" stroke-width="2" stroke-dasharray="3 3" />
            }

            @if (ArcClickPhase == 2)
            {
                @* End point marker (red) *@
                <circle cx="@ArcEndX" cy="@ArcEndY" r="6" fill="#ef4444" stroke="white" stroke-width="2" />

                @* Preview arc (dotted) *@
                @((MarkupString)GetArcPreviewPath())

                @* Mid point marker (follows mouse, blue dashed) *@
                <circle cx="@ArcMidX" cy="@ArcMidY" r="5" fill="none" stroke="#3b82f6" stroke-width="2" stroke-dasharray="3 3" />
            }
        }

        @if (IsSelecting && SelectionStart != null && SelectionEnd != null)
        {
            var x = Math.Min(SelectionStart.X, SelectionEnd.X);
            var y = Math.Min(SelectionStart.Y, SelectionEnd.Y);
            var w = Math.Abs(SelectionEnd.X - SelectionStart.X);
            var h = Math.Abs(SelectionEnd.Y - SelectionStart.Y);
            <rect x="@x" y="@y" width="@w" height="@h" fill="rgba(0,102,255,0.1)" stroke="#0066ff" stroke-width="1" stroke-dasharray="4 2" />
        }

        @foreach (var el in SelectedElements)
        {
            var b = el.GetBounds();
            <!-- Selection box -->
            <rect x="@(b.X - 4)" y="@(b.Y - 4)" width="@(b.Width + 8)" height="@(b.Height + 8)" fill="none" stroke="#0066ff" stroke-width="1" stroke-dasharray="4 2" />
            <!-- Resize handles (only show for single selection) -->
            @if (SelectedElements.Count == 1)
            {
                var handleSize = 8;
                var hs = handleSize / 2.0;
                <!-- Corner handles -->
                <rect x="@(b.X - 4 - hs)" y="@(b.Y - 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="nw" />
                <rect x="@(b.X + b.Width + 4 - hs)" y="@(b.Y - 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="ne" />
                <rect x="@(b.X - 4 - hs)" y="@(b.Y + b.Height + 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="sw" />
                <rect x="@(b.X + b.Width + 4 - hs)" y="@(b.Y + b.Height + 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="se" />
                <!-- Edge handles -->
                <rect x="@(b.X + b.Width / 2 - hs)" y="@(b.Y - 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="n" />
                <rect x="@(b.X + b.Width / 2 - hs)" y="@(b.Y + b.Height + 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="s" />
                <rect x="@(b.X - 4 - hs)" y="@(b.Y + b.Height / 2 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="w" />
                <rect x="@(b.X + b.Width + 4 - hs)" y="@(b.Y + b.Height / 2 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="e" />
            }
        }

        @* Group selection: orange bounding box and handles when multiple elements selected *@
        @if (SelectedElements.Count > 1)
        {
            var gb = GetGroupBounds();
            var handleSize = 8;
            var hs = handleSize / 2.0;
            var handleColor = "#ff6600";
            <!-- Group bounding box (orange, dashed) -->
            <rect x="@(gb.X - 4)" y="@(gb.Y - 4)" width="@(gb.Width + 8)" height="@(gb.Height + 8)" fill="none" stroke="@handleColor" stroke-width="2" stroke-dasharray="6 3" />
            <!-- Corner handles -->
            <rect x="@(gb.X - 4 - hs)" y="@(gb.Y - 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="@handleColor" stroke-width="1" class="resize-handle" data-handle="nw" />
            <rect x="@(gb.X + gb.Width + 4 - hs)" y="@(gb.Y - 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="@handleColor" stroke-width="1" class="resize-handle" data-handle="ne" />
            <rect x="@(gb.X - 4 - hs)" y="@(gb.Y + gb.Height + 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="@handleColor" stroke-width="1" class="resize-handle" data-handle="sw" />
            <rect x="@(gb.X + gb.Width + 4 - hs)" y="@(gb.Y + gb.Height + 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="@handleColor" stroke-width="1" class="resize-handle" data-handle="se" />
            <!-- Edge handles -->
            <rect x="@(gb.X + gb.Width / 2 - hs)" y="@(gb.Y - 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="@handleColor" stroke-width="1" class="resize-handle" data-handle="n" />
            <rect x="@(gb.X + gb.Width / 2 - hs)" y="@(gb.Y + gb.Height + 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="@handleColor" stroke-width="1" class="resize-handle" data-handle="s" />
            <rect x="@(gb.X - 4 - hs)" y="@(gb.Y + gb.Height / 2 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="@handleColor" stroke-width="1" class="resize-handle" data-handle="w" />
            <rect x="@(gb.X + gb.Width + 4 - hs)" y="@(gb.Y + gb.Height / 2 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="@handleColor" stroke-width="1" class="resize-handle" data-handle="e" />
        }

        @if (ChainMode)
        {
            <!-- Chain mode indicators -->
            @if (ChainStartPoint != null)
            {
                <!-- Start point marker (click here to close) -->
                <circle cx="@ChainStartPoint.X" cy="@ChainStartPoint.Y" r="8" fill="none" stroke="#00cc00" stroke-width="2" stroke-dasharray="3 2" />
                <circle cx="@ChainStartPoint.X" cy="@ChainStartPoint.Y" r="3" fill="#00cc00" />
            }
            @if (ChainLastPoint != null)
            {
                <!-- Last endpoint marker (next shape starts here) -->
                <circle cx="@ChainLastPoint.X" cy="@ChainLastPoint.Y" r="6" fill="@StrokeColor" stroke="#fff" stroke-width="2" />
            }
        }
    </svg>

    @if (ShowTextInput)
    {
        <div class="text-input-overlay" @onclick="CloseTextInput">
            <div class="text-input-modal" @onclick:stopPropagation="true">
                <h3>Enter Text</h3>
                <textarea @bind="TextInputValue"
                          @ref="textInputElement"
                          rows="3"
                          placeholder="Type your text here..."></textarea>
                <div class="text-input-actions">
                    <button class="btn btn-secondary" @onclick="CloseTextInput">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmTextInput">Add Text</button>
                </div>
            </div>
        </div>
    }

    @if (SelectedElements.Count > 0)
    {
        <div class="properties-panel">
            <h4>Properties (@SelectedElements.Count selected)</h4>
            <div class="prop-row">
                <label>Stroke:</label>
                <input type="color" value="@GetSelectedStroke()" @onchange="OnSelectedStrokeChange" />
            </div>
            <div class="prop-row">
                <label>Width:</label>
                <select value="@GetSelectedStrokeWidthIndex()" @onchange="OnSelectedStrokeWidthChange">
                    <option value="0">1px</option>
                    <option value="1">2px</option>
                    <option value="2">4px</option>
                    <option value="3">6px</option>
                    <option value="4">8px</option>
                    <option value="5">12px</option>
                </select>
            </div>
            <div class="prop-row">
                <label>Fill:</label>
                <input type="color" value="@GetSelectedFill()" @onchange="OnSelectedFillChange" />
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelectedFill">None</button>
            </div>
            <div class="prop-row">
                <button class="btn btn-sm btn-outline-primary" @onclick="BringToFront">To Front</button>
                <button class="btn btn-sm btn-outline-primary" @onclick="BringForward">Forward</button>
            </div>
            <div class="prop-row">
                <button class="btn btn-sm btn-outline-primary" @onclick="SendBackward">Backward</button>
                <button class="btn btn-sm btn-outline-primary" @onclick="SendToBack">To Back</button>
            </div>
            <div class="prop-row">
                <button class="btn btn-sm btn-outline-danger" @onclick="DeleteSelected">Delete</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="DuplicateSelected">Duplicate</button>
            </div>
            <div class="prop-row">
                <button class="btn btn-sm btn-outline-info" @onclick="GroupSelected" disabled="@(SelectedElements.Count < 2)">Group</button>
                <button class="btn btn-sm btn-outline-info" @onclick="UngroupSelected" disabled="@(!HasGroupedSelection())">Ungroup</button>
            </div>
            @if (HasDecomposableShapes())
            {
                <div class="prop-section">Decompose</div>
                <div class="prop-row">
                    <button class="btn btn-sm btn-warning" @onclick="DecomposeSelected">Create Regions</button>
                </div>
            }
            @if (SelectedElements.Count >= 2)
            {
                <div class="prop-section">Align</div>
                <div class="prop-row">
                    <button class="btn btn-xs btn-outline-secondary" @onclick="AlignLeft" title="Align Left">⫷</button>
                    <button class="btn btn-xs btn-outline-secondary" @onclick="AlignCenterH" title="Align Center H">⫿</button>
                    <button class="btn btn-xs btn-outline-secondary" @onclick="AlignRight" title="Align Right">⫸</button>
                    <button class="btn btn-xs btn-outline-secondary" @onclick="AlignTop" title="Align Top">⫠</button>
                    <button class="btn btn-xs btn-outline-secondary" @onclick="AlignCenterV" title="Align Center V">⫟</button>
                    <button class="btn btn-xs btn-outline-secondary" @onclick="AlignBottom" title="Align Bottom">⫡</button>
                </div>
                @if (SelectedElements.Count >= 3)
                {
                    <div class="prop-row">
                        <button class="btn btn-xs btn-outline-secondary" @onclick="DistributeH" title="Distribute Horizontally">↔ Dist H</button>
                        <button class="btn btn-xs btn-outline-secondary" @onclick="DistributeV" title="Distribute Vertically">↕ Dist V</button>
                    </div>
                }
                <div class="prop-row">
                    <button class="btn btn-xs btn-outline-secondary" @onclick="ArrangeGrid" title="Arrange in Grid">⊞ Grid</button>
                </div>
            }
        </div>
    }

    @if (ShowLayersPanel)
    {
        <div class="layers-panel" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true">
            <div class="layers-header">
                <span>Layers</span>
                <div class="layers-actions">
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddLayer" title="Add Layer">+</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="ShowDeleteLayerConfirm" title="Delete Layer" disabled="@(Layers.Count <= 1)">-</button>
                </div>
            </div>
            <div class="layers-list">
                @for (int i = Layers.Count - 1; i >= 0; i--)
                {
                    var layer = Layers[i];
                    var layerIndex = i;
                    <div class="layer-item @(layerIndex == CurrentLayerIndex ? "active" : "") @(layer.IsLocked ? "locked" : "")"
                         @onclick="() => SelectLayer(layerIndex)">
                        <button class="layer-visibility" @onclick:stopPropagation="true" @onclick="() => ToggleLayerVisibility(layerIndex)"
                                title="@(layer.IsVisible ? "Hide" : "Show")">
                            @(layer.IsVisible ? "👁" : "○")
                        </button>
                        <button class="layer-lock" @onclick:stopPropagation="true" @onclick="() => ToggleLayerLock(layerIndex)"
                                title="@(layer.IsLocked ? "Unlock" : "Lock")">
                            @(layer.IsLocked ? "🔒" : "🔓")
                        </button>
                        <span class="layer-name">@layer.Name</span>
                        <span class="layer-count">(@layer.Elements.Count)</span>
                        @if (layer.Elements.Count > 0)
                        {
                            <input type="checkbox" class="layer-select-all"
                                   @onclick:stopPropagation="true"
                                   checked="@AreAllLayerElementsSelected(layerIndex)"
                                   @onchange="(e) => ToggleSelectAllOnLayer(layerIndex, (bool)(e.Value ?? false))"
                                   title="Select all objects on this layer" />
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (ShowDeleteLayerDialog)
    {
        <div class="modal-overlay" @onclick="() => ShowDeleteLayerDialog = false">
            <div class="delete-layer-dialog" @onclick:stopPropagation="true">
                <h4>Delete Layer: @CurrentLayer.Name</h4>
                <p>This layer has @CurrentLayer.Elements.Count element(s).</p>
                <div class="delete-options">
                    @if (CurrentLayerIndex > 0)
                    {
                        <button class="btn btn-primary" @onclick="DeleteLayerTransferDown">
                            Transfer to "@Layers[CurrentLayerIndex - 1].Name"
                        </button>
                    }
                    <button class="btn btn-danger" @onclick="DeleteLayerAndContents">
                        Delete All
                    </button>
                    <button class="btn btn-secondary" @onclick="() => ShowDeleteLayerDialog = false">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    }

    @if (ShowCleanupDialog && LastCleanupResult != null)
    {
        <div class="modal-overlay" @onclick="() => ShowCleanupDialog = false">
            <div class="delete-layer-dialog" @onclick:stopPropagation="true" style="min-width: 320px;">
                <h4>Cleanup Complete</h4>
                <div style="text-align: left; margin: 10px 0;">
                    @if (LastCleanupResult.EmptyLayersRemoved > 0)
                    {
                        <p>Empty layers removed: @LastCleanupResult.EmptyLayersRemoved</p>
                    }
                    @if (LastCleanupResult.DegenerateShapesRemoved > 0)
                    {
                        <p>Degenerate shapes removed: @LastCleanupResult.DegenerateShapesRemoved</p>
                    }
                    @if (LastCleanupResult.OffCanvasRemoved > 0)
                    {
                        <p>Off-canvas elements removed: @LastCleanupResult.OffCanvasRemoved</p>
                    }
                    @if (LastCleanupResult.TinyElementsRemoved > 0)
                    {
                        <p>Tiny elements removed: @LastCleanupResult.TinyElementsRemoved</p>
                    }
                    @if (LastCleanupResult.InvisibleRemoved > 0)
                    {
                        <p>Invisible elements removed: @LastCleanupResult.InvisibleRemoved</p>
                    }
                    @if (LastCleanupResult.SinglePointPathsRemoved > 0)
                    {
                        <p>Single-point paths removed: @LastCleanupResult.SinglePointPathsRemoved</p>
                    }
                    @if (LastCleanupResult.OrphanGroupsFixed > 0)
                    {
                        <p>Orphan groups ungrouped: @LastCleanupResult.OrphanGroupsFixed</p>
                    }
                    @if (LastCleanupResult.TotalRemoved == 0 && LastCleanupResult.OrphanGroupsFixed == 0)
                    {
                        <p>Nothing to clean up!</p>
                    }
                </div>
                <button class="btn btn-primary" @onclick="() => ShowCleanupDialog = false">OK</button>
            </div>
        </div>
    }

    @if (ShowRecordingPanel)
    {
        <div class="recording-panel" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true">
            <div class="recording-header">
                <span>Recording</span>
                <button class="btn btn-sm btn-close" @onclick="() => ShowRecordingPanel = false">×</button>
            </div>
            <div class="recording-content">
                <div class="recording-controls">
                    <input type="text" @bind="RecordingName" placeholder="Recording name" class="recording-name-input" />
                    @if (!IsRecording && !IsReplaying && (CurrentRecording == null || CurrentRecording.Actions.Count == 0))
                    {
                        <button class="btn btn-sm btn-danger" @onclick="StartRecording">● Start Recording</button>
                    }
                    else if (IsRecording)
                    {
                        <div class="recording-status">
                            <span class="recording-indicator">● Recording</span>
                            <span class="recording-time">@(RecordingStopwatch?.Elapsed.ToString(@"mm\:ss") ?? "00:00")</span>
                            <span class="recording-actions">@(CurrentRecording?.Actions.Count ?? 0) actions</span>
                        </div>
                        <button class="btn btn-sm btn-secondary" @onclick="StopRecording">■ Stop</button>
                    }
                    else if (!IsRecording && !IsReplaying && CurrentRecording != null && CurrentRecording.Actions.Count > 0)
                    {
                        <div class="recording-status">
                            <span>Recorded:</span>
                            <span class="recording-actions">@CurrentRecording.Actions.Count actions</span>
                        </div>
                        <div style="display: flex; gap: 8px;">
                            <button class="btn btn-sm btn-primary" @onclick="SaveRecording">Save</button>
                            <button class="btn btn-sm btn-secondary" @onclick="DiscardRecording">Discard</button>
                            <button class="btn btn-sm btn-danger" @onclick="StartRecording">New</button>
                        </div>
                    }
                    else if (IsReplaying)
                    {
                        <div class="recording-status">
                            <span class="replay-indicator">▶ Replaying</span>
                            <span>@ReplayIndex / @(CurrentRecording?.Actions.Count ?? 0)</span>
                        </div>
                        <button class="btn btn-sm btn-secondary" @onclick="StopReplay">■ Stop</button>
                    }
                </div>

                <!-- Replay Section -->
                <div class="replay-section">
                    <h5>Replay</h5>
                    @if (SavedRecordings.Count > 0)
                    {
                        <div class="replay-select-row">
                            <select class="replay-select" @bind="SelectedReplayId">
                                <option value="">-- Select recording --</option>
                                @foreach (var rec in SavedRecordings)
                                {
                                    <option value="@rec.Id">@rec.Name (@rec.Actions.Count actions)</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-primary" @onclick="ReplaySelected"
                                    disabled="@(string.IsNullOrEmpty(SelectedReplayId) || IsRecording || IsReplaying)">▶ Play</button>
                        </div>
                    }
                    else
                    {
                        <span class="no-recordings">No saved recordings</span>
                    }
                </div>

                <!-- Saved Recordings Section -->
                <div class="saved-recordings">
                    <div class="saved-recordings-header">
                        <h5>Saved Recordings</h5>
                        <label class="btn btn-xs btn-secondary import-btn">
                            Import JSON
                            <InputFile OnChange="ImportRecordingJson" accept=".json" style="display:none;" />
                        </label>
                    </div>
                    @if (SavedRecordings.Count > 0)
                    {
                        @foreach (var rec in SavedRecordings)
                        {
                            <div class="saved-recording-item">
                                <div class="rec-info-col">
                                    <span class="rec-name">@rec.Name</span>
                                    <span class="rec-info">@rec.Actions.Count actions, @(rec.DurationMs / 1000)s</span>
                                </div>
                                <div class="rec-actions">
                                    <button class="btn btn-xs btn-primary" title="Play" @onclick="() => StartReplay(rec)" disabled="@(IsRecording || IsReplaying)">▶</button>
                                    <button class="btn btn-xs btn-warning" title="Edit" @onclick="() => OpenRecordingEditor(rec)" disabled="@(IsRecording || IsReplaying)">✎</button>
                                    <button class="btn btn-xs btn-secondary" title="Export JSON" @onclick="() => ExportRecordingJson(rec)">↓</button>
                                    <button class="btn btn-xs btn-danger" title="Delete" @onclick="() => DeleteRecording(rec)" disabled="@(IsRecording || IsReplaying)">×</button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <span class="no-recordings">No saved recordings yet</span>
                    }
                </div>
            </div>
        </div>
    }

    @* Recording Editor Side Panel *@
    @if (ShowRecordingEditor && EditingRecording != null)
    {
        <div class="recording-editor-overlay"></div>
        <div class="recording-editor">
            <div class="editor-header">
                <span>Edit Recording: @EditingRecording.Name</span>
                <button class="btn btn-sm btn-close" @onclick="CloseRecordingEditor">×</button>
            </div>
            <div class="editor-content">
                <div class="editor-info">
                    <span>@EditingRecording.Actions.Count actions</span>
                    <span>Duration: @((EditingRecording.DurationMs / 1000.0).ToString("F1"))s</span>
                </div>
                <div class="editor-toolbar">
                    <span class="toolbar-label">@(CheckedActionIndices.Count > 0 ? $"Apply to {CheckedActionIndices.Count} checked:" : "Apply to all:")</span>
                    <button class="btn btn-xs @(CheckedActionIndices.Count > 0 ? "btn-primary" : "btn-secondary")" @onclick="NormalizeGaps" title="Even out timing gaps">Normalize</button>
                    <button class="btn btn-xs @(CheckedActionIndices.Count > 0 ? "btn-primary" : "btn-secondary")" @onclick="() => ScaleTiming(0.25)" title="Quarter speed">0.25×</button>
                    <button class="btn btn-xs @(CheckedActionIndices.Count > 0 ? "btn-primary" : "btn-secondary")" @onclick="() => ScaleTiming(0.5)" title="Half speed">0.5×</button>
                    <button class="btn btn-xs @(CheckedActionIndices.Count > 0 ? "btn-primary" : "btn-secondary")" @onclick="() => ScaleTiming(2.0)" title="Double speed">2×</button>
                    <button class="btn btn-xs @(CheckedActionIndices.Count > 0 ? "btn-primary" : "btn-secondary")" @onclick="() => ScaleTiming(4.0)" title="Quadruple speed">4×</button>
                    <button class="btn btn-xs @(CheckedActionIndices.Count >= 2 ? "btn-primary" : "btn-secondary")" @onclick="ReverseActions" title="Reverse order (needs 2+ checked or reverses all)">Reverse</button>
                </div>
                <div class="editor-toolbar">
                    <button class="btn btn-xs btn-secondary" @onclick="AddDelayAction" title="Add 1s delay after checked/selected">+Delay</button>
                    <button class="btn btn-xs btn-outline-danger" @onclick="DeleteCheckedActions" disabled="@(CheckedActionIndices.Count == 0)" title="Delete checked actions">Delete @(CheckedActionIndices.Count > 0 ? CheckedActionIndices.Count.ToString() : "")</button>
                </div>
                <div class="editor-toolbar">
                    <button class="btn btn-xs btn-primary" @onclick="TestPlayEdited" disabled="@IsReplaying">▶ All</button>
                    <button class="btn btn-xs btn-primary" @onclick="PreviewChecked" disabled="@(IsReplaying || CheckedActionIndices.Count == 0)" title="Preview checked actions only">▶ @(CheckedActionIndices.Count) Checked</button>
                    <button class="btn btn-xs btn-primary" @onclick="PreviewFromSelected" disabled="@(IsReplaying || SelectedActionIndex < 0)" title="Preview from selected action">▶ From #@(SelectedActionIndex + 1)</button>
                </div>
                <div class="editor-actions-list">
                    <div class="action-header">
                        <span class="col-check">
                            <input type="checkbox" @onchange="ToggleAllChecked"
                                   checked="@(CheckedActionIndices.Count == EditingRecording.Actions.Count && EditingRecording.Actions.Count > 0)"
                                   title="Select all" />
                        </span>
                        <span class="col-num">#</span>
                        <span class="col-icon"></span>
                        <span class="col-time">Time</span>
                        <span class="col-gap">Gap</span>
                        <span class="col-type">Action</span>
                        <span class="col-controls"></span>
                    </div>
                    @for (int i = 0; i < EditingRecording.Actions.Count; i++)
                    {
                        var idx = i;
                        var action = EditingRecording.Actions[i];
                        var prevTime = i > 0 ? EditingRecording.Actions[i - 1].TimestampMs : 0;
                        var gap = action.TimestampMs - prevTime;
                        <div class="action-row @(idx == SelectedActionIndex ? "selected" : "") @(CheckedActionIndices.Contains(idx) ? "checked" : "")" @onclick="() => SelectAction(idx)">
                            <span class="col-check" @onclick:stopPropagation="true">
                                <input type="checkbox" checked="@CheckedActionIndices.Contains(idx)"
                                       @onchange="() => ToggleActionChecked(idx)" />
                            </span>
                            <span class="col-num">@(i + 1)</span>
                            <span class="col-icon" title="@(action.ElementType ?? GetActionTypeName(action.Type))">@((MarkupString)GetActionIcon(action))</span>
                            <span class="col-time">
                                <input type="number" step="0.1" min="0"
                                       value="@(action.TimestampMs / 1000.0)"
                                       @onchange="(e) => UpdateActionTime(idx, e)"
                                       class="time-input" />s
                            </span>
                            <span class="col-gap @(gap > 1000 ? "gap-long" : "")">+@((gap / 1000.0).ToString("F1"))s</span>
                            <span class="col-type">@GetActionTypeName(action.Type)</span>
                            <span class="col-controls">
                                <button class="btn btn-xs btn-outline-secondary" @onclick="() => MoveActionUp(idx)" disabled="@(idx == 0)" title="Move up">↑</button>
                                <button class="btn btn-xs btn-outline-secondary" @onclick="() => MoveActionDown(idx)" disabled="@(idx == EditingRecording.Actions.Count - 1)" title="Move down">↓</button>
                                <button class="btn btn-xs btn-outline-primary" @onclick="() => DuplicateAction(idx)" title="Duplicate">⧉</button>
                                <button class="btn btn-xs btn-outline-danger" @onclick="() => DeleteAction(idx)" title="Delete">×</button>
                            </span>
                        </div>
                    }
                </div>
                <div class="editor-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="CloseRecordingEditor">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveEditedRecording">Save Changes</button>
                </div>
            </div>
        </div>
    }

