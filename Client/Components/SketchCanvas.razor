    private string GetActionIcon(RecordedAction action)
    {
        const string svgStart = "<svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">";
