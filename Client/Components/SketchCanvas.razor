    private record CleanupResult(
        int EmptyLayersRemoved,
        int DegenerateShapesRemoved,
        int OffCanvasRemoved,
        int TinyElementsRemoved,
        int InvisibleRemoved,
        int SinglePointPathsRemoved,
        int OrphanGroupsFixed)
    {
        public int TotalRemoved => EmptyLayersRemoved + DegenerateShapesRemoved + OffCanvasRemoved +
                                   TinyElementsRemoved + InvisibleRemoved + SinglePointPathsRemoved;
    }

    private CleanupResult CleanupCanvas()
    {
        SaveUndoState();
        ClearSelection();

        int emptyLayers = 0, degenerateShapes = 0, offCanvas = 0, tinyElements = 0, invisible = 0, singlePointPaths = 0, orphanGroups = 0;
        const double MinSize = 2.0;

        // Remove problematic elements from all layers
        foreach (var layer in Layers)
        {
            var toRemove = new List<VectorElement>();

            foreach (var el in layer.Elements)
            {
                var bounds = el.GetBounds();

                // Check for degenerate shapes (zero or negative dimensions)
                if (bounds.Width <= 0 || bounds.Height <= 0)
                {
                    // Exception: lines can have 0 width OR 0 height (but not both)
                    if (el is LineElement line)
                    {
                        if (Math.Abs(line.X2 - line.X1) < 0.1 && Math.Abs(line.Y2 - line.Y1) < 0.1)
                        {
                            toRemove.Add(el);
                            degenerateShapes++;
                            continue;
                        }
                    }
                    else
                    {
                        toRemove.Add(el);
                        degenerateShapes++;
                        continue;
                    }
                }

                // Check for off-canvas elements (completely outside)
                if (bounds.X + bounds.Width < 0 || bounds.X > CanvasWidth ||
                    bounds.Y + bounds.Height < 0 || bounds.Y > CanvasHeight)
                {
                    toRemove.Add(el);
                    offCanvas++;
                    continue;
                }

                // Check for tiny elements
                if (bounds.Width < MinSize && bounds.Height < MinSize && el is not LineElement)
                {
                    toRemove.Add(el);
                    tinyElements++;
                    continue;
                }

                // Check for invisible elements (both stroke and fill are none/transparent)
                if ((el.Stroke == "none" || el.Stroke == "transparent" || string.IsNullOrEmpty(el.Stroke)) &&
                    (el.Fill == "none" || el.Fill == "transparent" || string.IsNullOrEmpty(el.Fill)))
                {
                    toRemove.Add(el);
                    invisible++;
                    continue;
                }

                // Check for single-point paths
                if (el is PathElement path && path.Points.Count < 2)
                {
                    toRemove.Add(el);
                    singlePointPaths++;
                    continue;
                }
            }

            foreach (var el in toRemove)
                layer.Elements.Remove(el);
        }

        // Fix orphan groups (groups with only 1 member)
        var allElements = Layers.SelectMany(l => l.Elements).ToList();
        var groupCounts = allElements
            .Where(e => !string.IsNullOrEmpty(e.GroupId))
            .GroupBy(e => e.GroupId)
            .ToDictionary(g => g.Key!, g => g.Count());

        foreach (var el in allElements)
        {
            if (!string.IsNullOrEmpty(el.GroupId) && groupCounts.TryGetValue(el.GroupId, out var count) && count == 1)
            {
                el.GroupId = null;
                orphanGroups++;
            }
        }

        // Remove empty layers (keep at least one)
        if (Layers.Count > 1)
        {
            var emptyLayersList = Layers.Where(l => l.Elements.Count == 0).ToList();
            foreach (var layer in emptyLayersList)
            {
                if (Layers.Count > 1)
                {
                    Layers.Remove(layer);
                    emptyLayers++;
                }
            }
            // Ensure CurrentLayerIndex is valid
            if (CurrentLayerIndex >= Layers.Count)
                CurrentLayerIndex = Layers.Count - 1;
        }

        InputHint = $"Cleanup: removed {degenerateShapes + offCanvas + tinyElements + invisible + singlePointPaths} elements, {emptyLayers} layers";
        return new CleanupResult(emptyLayers, degenerateShapes, offCanvas, tinyElements, invisible, singlePointPaths, orphanGroups);
    }

    private void SaveUndoState()
    {
        // Serialize current state to JSON
        var snapshot = SerializeElements();
        UndoStack.Push(snapshot);

        // Limit stack size
        if (UndoStack.Count > MaxUndoSteps)
        {
            var temp = UndoStack.ToArray();
            UndoStack.Clear();
            for (int i = 0; i < MaxUndoSteps; i++)
                UndoStack.Push(temp[MaxUndoSteps - 1 - i]);
        }
    }

    private void Undo()
    {
        if (UndoStack.Count == 0) return;

        var snapshot = UndoStack.Pop();
        DeserializeElements(snapshot);
        ClearSelection();
        StateHasChanged();
    }

    private string SerializeElements()
    {
        var layersData = Layers.Select(layer => new LayerData
        {
            Id = layer.Id,
            Name = layer.Name,
            IsVisible = layer.IsVisible,
            IsLocked = layer.IsLocked,
            Opacity = layer.Opacity,
            Elements = layer.Elements.Select(e => new ElementData
            {
                Type = e.GetType().Name,
                Stroke = e.Stroke,
                StrokeWidth = e.StrokeWidth,
                Fill = e.Fill,
                Json = System.Text.Json.JsonSerializer.Serialize(e, e.GetType())
            }).ToList()
        }).ToList();

        var state = new CanvasState { Layers = layersData, CurrentLayerIndex = CurrentLayerIndex };
        return System.Text.Json.JsonSerializer.Serialize(state);
    }

    private void DeserializeElements(string snapshot)
    {
        var state = System.Text.Json.JsonSerializer.Deserialize<CanvasState>(snapshot);
        if (state?.Layers == null) return;

        Layers.Clear();
        foreach (var layerData in state.Layers)
        {
            var layer = new Layer
            {
                Id = layerData.Id,
                Name = layerData.Name,
                IsVisible = layerData.IsVisible,
                IsLocked = layerData.IsLocked,
                Opacity = layerData.Opacity
            };

            foreach (var item in layerData.Elements)
            {
                VectorElement? el = item.Type switch
                {
                    "LineElement" => System.Text.Json.JsonSerializer.Deserialize<LineElement>(item.Json),
                    "PathElement" => System.Text.Json.JsonSerializer.Deserialize<PathElement>(item.Json),
                    "RectElement" => System.Text.Json.JsonSerializer.Deserialize<RectElement>(item.Json),
                    "CircleElement" => System.Text.Json.JsonSerializer.Deserialize<CircleElement>(item.Json),
                    "EllipseElement" => System.Text.Json.JsonSerializer.Deserialize<EllipseElement>(item.Json),
                    "TriangleElement" => System.Text.Json.JsonSerializer.Deserialize<TriangleElement>(item.Json),
                    "PolygonElement" => System.Text.Json.JsonSerializer.Deserialize<PolygonElement>(item.Json),
                    "StarElement" => System.Text.Json.JsonSerializer.Deserialize<StarElement>(item.Json),
                    "ArrowElement" => System.Text.Json.JsonSerializer.Deserialize<ArrowElement>(item.Json),
                    "ImageElement" => System.Text.Json.JsonSerializer.Deserialize<ImageElement>(item.Json),
                    "TextElement" => System.Text.Json.JsonSerializer.Deserialize<TextElement>(item.Json),
                    "SvgPathElement" => System.Text.Json.JsonSerializer.Deserialize<SvgPathElement>(item.Json),
                    _ => null
                };
                if (el != null)
                    layer.Elements.Add(el);
            }
            Layers.Add(layer);
        }

        CurrentLayerIndex = Math.Min(state.CurrentLayerIndex, Layers.Count - 1);
        if (Layers.Count == 0)
            Layers.Add(new Layer { Name = "Layer 1" });
    }

    private class CanvasState
    {
