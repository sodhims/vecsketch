        {
            StrokeColor = "#ffffff"; // White strokes for dark theme
        }
        else if (StrokeColor == "#ffffff")
        {
            StrokeColor = "#000000"; // Reset to black when switching away from dark theme
        }
        StateHasChanged();
    }

