<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(VecSketch.Client.Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(VecSketch.Client.Layout.MainLayout)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
