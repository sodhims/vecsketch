@using VecSketch.Models
@using VecSketch.Services
@inject IJSRuntime JS
@inject AiDrawingService AiService

<div class="sketch-container" @ref="containerElement" tabindex="0" @onkeydown="OnKeyDown">
    <div class="toolbar">
        <div class="tool-group">
            <label>Tool:</label>
            <select @bind="CurrentToolIndex" class="tool-select">
                <option value="0">Select</option>
                <option value="1">Line</option>
                <option value="2">Pencil</option>
                <option value="3">Rectangle</option>
                <option value="4">Circle</option>
                <option value="5">Ellipse</option>
                <option value="6">Triangle</option>
                <option value="7">Polygon</option>
                <option value="8">Star</option>
                <option value="9">Arrow</option>
                <option value="10">Text</option>
            </select>
        </div>

        @if (CurrentTool == DrawingTool.Polygon)
        {
            <div class="tool-group">
                <label>Sides:</label>
                <select @bind="PolygonSides" class="width-select">
                    <option value="3">3</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                    <option value="8">8</option>
                    <option value="10">10</option>
                    <option value="12">12</option>
                </select>
            </div>
        }

        @if (CurrentTool == DrawingTool.Star)
        {
            <div class="tool-group">
                <label>Points:</label>
                <select @bind="StarPoints" class="width-select">
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                    <option value="8">8</option>
                </select>
            </div>
        }

        @if (CurrentTool == DrawingTool.Text)
        {
            <div class="tool-group">
                <label>Size:</label>
                <select @bind="FontSizeIndex" class="width-select">
                    <option value="0">12px</option>
                    <option value="1">16px</option>
                    <option value="2">20px</option>
                    <option value="3">24px</option>
                    <option value="4">32px</option>
                    <option value="5">48px</option>
                </select>
            </div>
        }

        <div class="tool-group">
            <label>Stroke:</label>
            <input type="color" @bind="StrokeColor" class="color-picker" />
        </div>

        <div class="tool-group">
            <label>Width:</label>
            <select @bind="StrokeWidthIndex" class="width-select">
                <option value="0">1px</option>
                <option value="1">2px</option>
                <option value="2">4px</option>
                <option value="3">6px</option>
                <option value="4">8px</option>
                <option value="5">12px</option>
            </select>
        </div>

        <div class="tool-group">
            <label>Fill:</label>
            <input type="checkbox" @bind="UseFillToggle" />
            <input type="color" @bind="FillColor" class="color-picker" />
        </div>

        <div class="tool-group">
            <label>Touch:</label>
            <input type="checkbox" checked="@TouchEnabled" @onchange="OnTouchToggleChange" title="Uncheck to disable touch for pen drawing" />
        </div>

        <div class="tool-group actions">
            <button class="btn btn-sm btn-outline-light" @onclick="OnPasteClick">Paste</button>
            <button class="btn btn-sm btn-outline-light" @onclick="OnClearClick">Clear</button>
            <button class="btn btn-sm btn-outline-light" @onclick="OnUndoClick">Undo</button>
            <button class="btn btn-sm btn-outline-light" @onclick="OnExportClick">Export</button>
        </div>
    </div>

    <div class="canvas-info">
        <span>Elements: @Elements.Count / @MaxElements</span>
        <div class="progress" style="width: 200px; height: 20px;">
            <div class="progress-bar" role="progressbar" style="width: @GetProgressPercent()%"></div>
        </div>
        <span class="input-hint">@InputHint</span>
    </div>

    <svg @ref="svgElement"
         width="@CanvasWidth"
         height="@CanvasHeight"
         class="canvas"
         @onpointerdown="OnPointerDown"
         @onpointermove="OnPointerMove"
         @onpointerup="OnPointerUp"
         @onpointerleave="OnPointerUp"
         @onpointercancel="OnPointerUp"
         @oncontextmenu:preventDefault="true">

        <defs>
            <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#eee" stroke-width="0.5"/>
            </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />

        @foreach (var element in Elements)
        {
            @((MarkupString)element.ToSvg())
        }

        @if (IsDrawing && CurrentElement != null)
        {
            @((MarkupString)CurrentElement.ToSvg())
        }

        @if (IsSelecting && SelectionStart != null && SelectionEnd != null)
        {
            var x = Math.Min(SelectionStart.X, SelectionEnd.X);
            var y = Math.Min(SelectionStart.Y, SelectionEnd.Y);
            var w = Math.Abs(SelectionEnd.X - SelectionStart.X);
            var h = Math.Abs(SelectionEnd.Y - SelectionStart.Y);
            <rect x="@x" y="@y" width="@w" height="@h" fill="rgba(0,102,255,0.1)" stroke="#0066ff" stroke-width="1" stroke-dasharray="4 2" />
        }

        @foreach (var el in SelectedElements)
        {
            var b = el.GetBounds();
            <!-- Selection box -->
            <rect x="@(b.X - 4)" y="@(b.Y - 4)" width="@(b.Width + 8)" height="@(b.Height + 8)" fill="none" stroke="#0066ff" stroke-width="1" stroke-dasharray="4 2" />
            <!-- Resize handles (only show for single selection) -->
            @if (SelectedElements.Count == 1)
            {
                var handleSize = 8;
                var hs = handleSize / 2.0;
                <!-- Corner handles -->
                <rect x="@(b.X - 4 - hs)" y="@(b.Y - 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="nw" />
                <rect x="@(b.X + b.Width + 4 - hs)" y="@(b.Y - 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="ne" />
                <rect x="@(b.X - 4 - hs)" y="@(b.Y + b.Height + 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="sw" />
                <rect x="@(b.X + b.Width + 4 - hs)" y="@(b.Y + b.Height + 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="se" />
                <!-- Edge handles -->
                <rect x="@(b.X + b.Width / 2 - hs)" y="@(b.Y - 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="n" />
                <rect x="@(b.X + b.Width / 2 - hs)" y="@(b.Y + b.Height + 4 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="s" />
                <rect x="@(b.X - 4 - hs)" y="@(b.Y + b.Height / 2 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="w" />
                <rect x="@(b.X + b.Width + 4 - hs)" y="@(b.Y + b.Height / 2 - hs)" width="@handleSize" height="@handleSize" fill="#fff" stroke="#0066ff" stroke-width="1" class="resize-handle" data-handle="e" />
            }
        }
    </svg>

    @if (ShowTextInput)
    {
        <div class="text-input-overlay" @onclick="CloseTextInput">
            <div class="text-input-modal" @onclick:stopPropagation="true">
                <h3>Enter Text</h3>
                <textarea @bind="TextInputValue"
                          @ref="textInputElement"
                          rows="3"
                          placeholder="Type your text here..."></textarea>
                <div class="text-input-actions">
                    <button class="btn btn-secondary" @onclick="CloseTextInput">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmTextInput">Add Text</button>
                </div>
            </div>
        </div>
    }

    @if (SelectedElements.Count > 0)
    {
        <div class="properties-panel">
            <h4>Properties (@SelectedElements.Count selected)</h4>
            <div class="prop-row">
                <label>Stroke:</label>
                <input type="color" value="@GetSelectedStroke()" @onchange="OnSelectedStrokeChange" />
            </div>
            <div class="prop-row">
                <label>Width:</label>
                <select value="@GetSelectedStrokeWidthIndex()" @onchange="OnSelectedStrokeWidthChange">
                    <option value="0">1px</option>
                    <option value="1">2px</option>
                    <option value="2">4px</option>
                    <option value="3">6px</option>
                    <option value="4">8px</option>
                    <option value="5">12px</option>
                </select>
            </div>
            <div class="prop-row">
                <label>Fill:</label>
                <input type="color" value="@GetSelectedFill()" @onchange="OnSelectedFillChange" />
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelectedFill">None</button>
            </div>
            <div class="prop-row">
                <button class="btn btn-sm btn-outline-primary" @onclick="BringToFront">To Front</button>
                <button class="btn btn-sm btn-outline-primary" @onclick="SendToBack">To Back</button>
            </div>
            <div class="prop-row">
                <button class="btn btn-sm btn-outline-danger" @onclick="DeleteSelected">Delete</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="DuplicateSelected">Duplicate</button>
            </div>
        </div>
    }

    <div class="ai-panel" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @onkeydown:stopPropagation="true">
        <div class="ai-header" @onclick="ToggleAiPanel">
            <span>AI Draw</span>
            <span class="ai-toggle">@(ShowAiPanel ? "▼" : "▶")</span>
        </div>
        @if (ShowAiPanel)
        {
            <div class="ai-content">
                <div class="ai-provider-section">
                    <label>Provider:</label>
                    <select @bind="SelectedProvider" class="provider-select">
                        <option value="Ollama">Ollama (Local)</option>
                        <option value="Anthropic">Anthropic (Claude)</option>
                    </select>
                </div>

                @if (AiService.Provider == AiProvider.Ollama)
                {
                    <div class="ai-key-section">
                        <label>Ollama Endpoint:</label>
                        <input type="text" @bind="AiService.OllamaEndpoint" @bind:event="oninput" placeholder="http://10.10.48.219:11434" />
                        <label style="margin-top: 8px;">Model:</label>
                        <input type="text" @bind="AiService.OllamaModel" @bind:event="oninput" placeholder="deepseek-r1:14b" />
                    </div>
                }
                else
                {
                    <div class="ai-key-section">
                        <label>API Key:</label>
                        <div class="api-key-row">
                            <input type="text" @bind="ApiKeyInput" @bind:event="oninput" placeholder="Paste Anthropic API key here..." disabled="@ApiKeyTesting" />
                            <button class="btn btn-sm btn-primary" @onclick="SaveApiKey" disabled="@ApiKeyTesting">
                                @(ApiKeyTesting ? "Testing..." : "Set Key")
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(ApiKeyStatus))
                        {
                            <span class="key-status @(ApiKeyStatus == "Key valid!" ? "key-valid" : ApiKeyStatus == "Testing key..." ? "key-testing" : "key-error")">@ApiKeyStatus</span>
                        }
                        else if (!string.IsNullOrEmpty(AiService.ApiKey))
                        {
                            <span class="key-status key-valid">Key saved</span>
                        }
                    </div>
                }

                <div class="ai-prompt-section">
                    <label>Prompt:</label>
                    <textarea @bind="AiPrompt" @bind:event="oninput" placeholder="Describe what to draw...&#10;e.g., 'a red house with a blue roof and green grass'" rows="4"></textarea>

                    <div class="ai-options">
                        <label><input type="checkbox" @bind="AiClearBeforeGenerate" /> Clear canvas first</label>
                    </div>

                    <button class="btn btn-primary ai-generate-btn" @onclick="GenerateFromAi" disabled="@(AiGenerating || (AiService.Provider == AiProvider.Anthropic && string.IsNullOrEmpty(AiService.ApiKey)))">
                        @(AiGenerating ? "Generating..." : "Generate Drawing")
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(AiThinking))
                {
                    <div class="ai-thinking">@AiThinking</div>
                }
                @if (!string.IsNullOrEmpty(AiError))
                {
                    <div class="ai-error">@AiError</div>
                }
                @if (AiResult != null)
                {
                    <div class="ai-result">
                        Created @AiResult.ElementsCreated elements
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private ElementReference svgElement;
    private ElementReference containerElement;
    private ElementReference textInputElement;
    private List<VectorElement> Elements = new();
    private VectorElement? CurrentElement;
    private bool IsDrawing;
    private Point? StartPoint;

    // Fill toggle state
    private bool UseFillToggle = false;

    private int CurrentToolIndex = 2; // Pencil default
    private int StrokeWidthIndex = 1; // 2px default
    private int FontSizeIndex = 1; // 16px default
    private int PolygonSides = 6;
    private int StarPoints = 5;
    private string StrokeColor = "#000000";
    private string FillColor = "#3498db";
    private int CanvasWidth = 1400;
    private int CanvasHeight = 900;
    private const int MaxElements = 500;
    private bool TouchEnabled = true;

    // Text input modal
    private bool ShowTextInput = false;
    private string TextInputValue = "";
    private Point? TextPosition;

    // Input detection
    private string InputHint = "Mouse ready [V=Select, P=Pencil, L=Line, R=Rect, C=Circle, E=Ellipse, T=Triangle, G=Polygon, S=Star, A=Arrow, X=Text]";
    private double CurrentPressure = 1.0;

    // Selection state
    private List<VectorElement> SelectedElements = new();
    private bool IsSelecting = false;
    private Point? SelectionStart;
    private Point? SelectionEnd;

    // Move/Resize state
    private bool IsMoving = false;
    private bool IsResizing = false;
    private Point? DragStart;
    private string? ResizeHandle; // "nw", "ne", "sw", "se", "n", "s", "e", "w"
    private BoundingBox? OriginalBounds;

    // AI Drawing state
    private bool ShowAiPanel = false;
    private string ApiKeyInput = "";
    private string AiPrompt = "";
    private bool AiGenerating = false;
    private bool AiClearBeforeGenerate = true;
    private string? AiThinking;
    private string? AiError;
    private CommandResult? AiResult;

    private string SelectedProvider
    {
        get => AiService.Provider.ToString();
        set => AiService.Provider = Enum.Parse<AiProvider>(value);
    }

    private DrawingTool CurrentTool => CurrentToolIndex switch
    {
        0 => DrawingTool.Select,
        1 => DrawingTool.Line,
        2 => DrawingTool.Pencil,
        3 => DrawingTool.Rectangle,
        4 => DrawingTool.Circle,
        5 => DrawingTool.Ellipse,
        6 => DrawingTool.Triangle,
        7 => DrawingTool.Polygon,
        8 => DrawingTool.Star,
        9 => DrawingTool.Arrow,
        10 => DrawingTool.Text,
        _ => DrawingTool.Pencil
    };

    private double StrokeWidth => StrokeWidthIndex switch
    {
        0 => 1,
        1 => 2,
        2 => 4,
        3 => 6,
        4 => 8,
        5 => 12,
        _ => 2
    };

    private double FontSize => FontSizeIndex switch
    {
        0 => 12,
        1 => 16,
        2 => 20,
        3 => 24,
        4 => 32,
        5 => 48,
        _ => 16
    };

    private bool UseFill => UseFillToggle;

    private int GetProgressPercent() => (int)((double)Elements.Count / MaxElements * 100);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("setupPasteHandler", DotNetObjectReference.Create(this));
            StateHasChanged();
        }
    }

    private string GetFill() => UseFill ? FillColor : "none";

    private void OnPasteClick() => _ = JS.InvokeVoidAsync("pasteFromClipboard");
    private void OnClearClick() { Elements.Clear(); }
    private void OnUndoClick() { if (Elements.Count > 0) Elements.RemoveAt(Elements.Count - 1); }

    private async Task OnTouchToggleChange(ChangeEventArgs e)
    {
        TouchEnabled = (bool)(e.Value ?? true);
        // Tell JavaScript to block/unblock touch events
        await JS.InvokeVoidAsync("setTouchBlocking", !TouchEnabled);
    }
    private async Task OnExportClick()
    {
        var svg = $@"<svg xmlns=""http://www.w3.org/2000/svg"" xmlns:xlink=""http://www.w3.org/1999/xlink"" width=""{CanvasWidth}"" height=""{CanvasHeight}"" viewBox=""0 0 {CanvasWidth} {CanvasHeight}"">
{string.Join("\n", Elements.Select(e => "  " + e.ToSvg()))}
</svg>";
        await JS.InvokeVoidAsync("downloadSvg", svg, "sketch.svg");
    }

    private string GetPointerType(PointerEventArgs e)
    {
        return e.PointerType switch
        {
            "pen" => "Pen",
            "touch" => "Touch",
            "mouse" => "Mouse",
            _ => "Input"
        };
    }


    [JSInvokable]
    public void HandlePastedImage(string dataUrl, int width, int height)
    {
        // Scale image to fit canvas if too large
        var scale = 1.0;
        if (width > CanvasWidth * 0.8)
            scale = (CanvasWidth * 0.8) / width;
        if (height * scale > CanvasHeight * 0.8)
            scale = (CanvasHeight * 0.8) / height;

        var scaledWidth = width * scale;
        var scaledHeight = height * scale;

        var imageElement = new ImageElement
        {
            X = (CanvasWidth - scaledWidth) / 2,
            Y = (CanvasHeight - scaledHeight) / 2,
            Width = scaledWidth,
            Height = scaledHeight,
            DataUrl = dataUrl
        };

        Elements.Add(imageElement);
        StateHasChanged();
    }

    [JSInvokable]
    public void HandlePastedText(string text)
    {
        TextInputValue = text;
        TextPosition = new Point(50, 50);
        ShowTextInput = true;
        StateHasChanged();
    }

    private void OnPointerDown(PointerEventArgs e)
    {
        // Update input hint based on pointer type
        InputHint = $"{GetPointerType(e)} active";
        CurrentPressure = e.Pressure > 0 ? e.Pressure : 1.0;

        // Handle selection tool
        if (CurrentTool == DrawingTool.Select)
        {
            var clickX = e.OffsetX;
            var clickY = e.OffsetY;

            // Check if clicking on a resize handle (single selection only)
            if (SelectedElements.Count == 1)
            {
                var handle = GetResizeHandleAt(clickX, clickY);
                if (handle != null)
                {
                    IsResizing = true;
                    ResizeHandle = handle;
                    DragStart = new Point(clickX, clickY);
                    OriginalBounds = SelectedElements[0].GetBounds();
                    return;
                }
            }

            // Check if clicking on an already-selected element (for moving)
            if (SelectedElements.Count > 0)
            {
                foreach (var sel in SelectedElements)
                {
                    if (sel.HitTest(clickX, clickY))
                    {
                        // Start moving
                        IsMoving = true;
                        DragStart = new Point(clickX, clickY);
                        return;
                    }
                }
            }

            // Try to hit-test an element (reverse order for top-most first)
            VectorElement? hitElement = null;
            for (int i = Elements.Count - 1; i >= 0; i--)
            {
                if (Elements[i].HitTest(clickX, clickY))
                {
                    hitElement = Elements[i];
                    break;
                }
            }

            if (hitElement != null)
            {
                // If not holding shift, clear previous selection
                if (!e.ShiftKey)
                    ClearSelection();

                hitElement.IsSelected = !hitElement.IsSelected;
                if (hitElement.IsSelected)
                    SelectedElements.Add(hitElement);
                else
                    SelectedElements.Remove(hitElement);

                // Start moving immediately after selecting
                if (hitElement.IsSelected)
                {
                    IsMoving = true;
                    DragStart = new Point(clickX, clickY);
                }
            }
            else
            {
                // Start area selection
                if (!e.ShiftKey)
                    ClearSelection();
                IsSelecting = true;
                SelectionStart = new Point(clickX, clickY);
                SelectionEnd = SelectionStart;
            }
            return;
        }

        // Handle text tool - show input modal
        if (CurrentTool == DrawingTool.Text)
        {
            TextPosition = new Point(e.OffsetX, e.OffsetY);
            TextInputValue = "";
            ShowTextInput = true;
            return;
        }

        IsDrawing = true;
        StartPoint = new Point(e.OffsetX, e.OffsetY);

        CurrentElement = CurrentTool switch
        {
            DrawingTool.Line => new LineElement
            {
                X1 = e.OffsetX, Y1 = e.OffsetY,
                X2 = e.OffsetX, Y2 = e.OffsetY,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth
            },
            DrawingTool.Pencil => new PathElement
            {
                Points = new List<Point> { StartPoint },
                Stroke = StrokeColor, 
                StrokeWidth = StrokeWidth * CurrentPressure, // Apply pressure
                Pressure = CurrentPressure
            },
            DrawingTool.Rectangle => new RectElement
            {
                X = e.OffsetX, Y = e.OffsetY,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth, Fill = GetFill()
            },
            DrawingTool.Circle => new CircleElement
            {
                Cx = e.OffsetX, Cy = e.OffsetY,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth, Fill = GetFill()
            },
            DrawingTool.Ellipse => new EllipseElement
            {
                Cx = e.OffsetX, Cy = e.OffsetY,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth, Fill = GetFill()
            },
            DrawingTool.Triangle => new TriangleElement
            {
                X1 = e.OffsetX, Y1 = e.OffsetY,
                X2 = e.OffsetX, Y2 = e.OffsetY,
                X3 = e.OffsetX, Y3 = e.OffsetY,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth, Fill = GetFill()
            },
            DrawingTool.Polygon => new PolygonElement
            {
                Cx = e.OffsetX, Cy = e.OffsetY,
                Sides = PolygonSides,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth, Fill = GetFill()
            },
            DrawingTool.Star => new StarElement
            {
                Cx = e.OffsetX, Cy = e.OffsetY,
                Points = StarPoints,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth, Fill = GetFill()
            },
            DrawingTool.Arrow => new ArrowElement
            {
                X1 = e.OffsetX, Y1 = e.OffsetY,
                X2 = e.OffsetX, Y2 = e.OffsetY,
                Stroke = StrokeColor, StrokeWidth = StrokeWidth
            },
            _ => null
        };
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        // Handle moving selected elements
        if (IsMoving && DragStart != null)
        {
            var dx = e.OffsetX - DragStart.X;
            var dy = e.OffsetY - DragStart.Y;
            foreach (var el in SelectedElements)
                MoveElement(el, dx, dy);
            DragStart = new Point(e.OffsetX, e.OffsetY);
            return;
        }

        // Handle resizing
        if (IsResizing && DragStart != null && OriginalBounds != null && SelectedElements.Count == 1)
        {
            ResizeElement(SelectedElements[0], e.OffsetX, e.OffsetY);
            return;
        }

        // Handle area selection
        if (IsSelecting && SelectionStart != null)
        {
            SelectionEnd = new Point(e.OffsetX, e.OffsetY);
            return;
        }

        if (!IsDrawing || CurrentElement == null || StartPoint == null) return;

        // Update pressure for pen input
        if (e.Pressure > 0)
            CurrentPressure = e.Pressure;

        switch (CurrentElement)
        {
            case LineElement line:
                line.X2 = e.OffsetX;
                line.Y2 = e.OffsetY;
                break;
            case PathElement path:
                path.Points.Add(new Point(e.OffsetX, e.OffsetY));
                // Optionally adjust stroke width based on pressure for pen
                if (e.PointerType == "pen" && e.Pressure > 0)
                {
                    path.StrokeWidth = StrokeWidth * e.Pressure;
                }
                break;
            case RectElement rect:
                rect.X = Math.Min(StartPoint.X, e.OffsetX);
                rect.Y = Math.Min(StartPoint.Y, e.OffsetY);
                rect.Width = Math.Abs(e.OffsetX - StartPoint.X);
                rect.Height = Math.Abs(e.OffsetY - StartPoint.Y);
                break;
            case CircleElement circle:
                var dx = e.OffsetX - StartPoint.X;
                var dy = e.OffsetY - StartPoint.Y;
                circle.Radius = Math.Sqrt(dx * dx + dy * dy);
                break;
            case EllipseElement ellipse:
                ellipse.Cx = (StartPoint.X + e.OffsetX) / 2;
                ellipse.Cy = (StartPoint.Y + e.OffsetY) / 2;
                ellipse.Rx = Math.Abs(e.OffsetX - StartPoint.X) / 2;
                ellipse.Ry = Math.Abs(e.OffsetY - StartPoint.Y) / 2;
                break;
            case TriangleElement triangle:
                // Isoceles triangle: base at bottom, apex at top center
                var midX = (StartPoint.X + e.OffsetX) / 2;
                triangle.X1 = midX; // Top apex
                triangle.Y1 = Math.Min(StartPoint.Y, e.OffsetY);
                triangle.X2 = StartPoint.X; // Bottom left
                triangle.Y2 = Math.Max(StartPoint.Y, e.OffsetY);
                triangle.X3 = e.OffsetX; // Bottom right
                triangle.Y3 = Math.Max(StartPoint.Y, e.OffsetY);
                break;
            case PolygonElement polygon:
                var pdx = e.OffsetX - StartPoint.X;
                var pdy = e.OffsetY - StartPoint.Y;
                polygon.Radius = Math.Sqrt(pdx * pdx + pdy * pdy);
                break;
            case StarElement star:
                var sdx = e.OffsetX - StartPoint.X;
                var sdy = e.OffsetY - StartPoint.Y;
                star.OuterRadius = Math.Sqrt(sdx * sdx + sdy * sdy);
                star.InnerRadius = star.OuterRadius * 0.4;
                break;
            case ArrowElement arrow:
                arrow.X2 = e.OffsetX;
                arrow.Y2 = e.OffsetY;
                var length = Math.Sqrt(Math.Pow(arrow.X2 - arrow.X1, 2) + Math.Pow(arrow.Y2 - arrow.Y1, 2));
                arrow.HeadSize = Math.Max(10, Math.Min(25, length * 0.15));
                break;
        }
    }

    private void OnPointerUp(PointerEventArgs e)
    {
        InputHint = $"{GetPointerType(e)} ready";

        // Finish moving
        if (IsMoving)
        {
            IsMoving = false;
            DragStart = null;
            return;
        }

        // Finish resizing
        if (IsResizing)
        {
            IsResizing = false;
            DragStart = null;
            ResizeHandle = null;
            OriginalBounds = null;
            return;
        }

        // Finish area selection
        if (IsSelecting && SelectionStart != null && SelectionEnd != null)
        {
            var x = Math.Min(SelectionStart.X, SelectionEnd.X);
            var y = Math.Min(SelectionStart.Y, SelectionEnd.Y);
            var w = Math.Abs(SelectionEnd.X - SelectionStart.X);
            var h = Math.Abs(SelectionEnd.Y - SelectionStart.Y);

            foreach (var el in Elements)
            {
                if (el.IntersectsRect(x, y, w, h))
                {
                    el.IsSelected = true;
                    if (!SelectedElements.Contains(el))
                        SelectedElements.Add(el);
                }
            }
            IsSelecting = false;
            SelectionStart = null;
            SelectionEnd = null;
            return;
        }

        if (IsDrawing && CurrentElement != null)
        {
            Elements.Add(CurrentElement);
            CurrentElement = null;
        }
        IsDrawing = false;
        StartPoint = null;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        // Don't handle shortcuts if in text input
        if (ShowTextInput) return;

        // Handle Ctrl shortcuts
        if (e.CtrlKey)
        {
            switch (e.Key.ToLower())
            {
                case "v": _ = JS.InvokeVoidAsync("pasteFromClipboard"); break;
                case "z": OnUndoClick(); StateHasChanged(); break;
                case "a": SelectAll(); break; // Ctrl+A = select all
            }
            return;
        }

        // Tool shortcuts (single key)
        switch (e.Key.ToLower())
        {
            case "v": CurrentToolIndex = 0; break; // Select
            case "l": CurrentToolIndex = 1; break; // Line
            case "p": CurrentToolIndex = 2; break; // Pencil
            case "r": CurrentToolIndex = 3; break; // Rectangle
            case "c": CurrentToolIndex = 4; break; // Circle
            case "e": CurrentToolIndex = 5; break; // Ellipse
            case "t": CurrentToolIndex = 6; break; // Triangle
            case "g": CurrentToolIndex = 7; break; // polyGon
            case "s": CurrentToolIndex = 8; break; // Star
            case "a": CurrentToolIndex = 9; break; // Arrow
            case "x": CurrentToolIndex = 10; break; // teXt
            case "delete":
            case "backspace":
                DeleteSelected();
                break;
            case "escape":
                ClearSelection();
                break;
        }
        StateHasChanged();
    }

    private void SelectAll()
    {
        ClearSelection();
        foreach (var el in Elements)
        {
            el.IsSelected = true;
            SelectedElements.Add(el);
        }
    }

    private void ClearSelection()
    {
        foreach (var el in SelectedElements)
            el.IsSelected = false;
        SelectedElements.Clear();
    }

    private void DeleteSelected()
    {
        foreach (var el in SelectedElements)
            Elements.Remove(el);
        SelectedElements.Clear();
    }

    private void CloseTextInput()
    {
        ShowTextInput = false;
        TextInputValue = "";
        TextPosition = null;
    }

    private void ConfirmTextInput()
    {
        if (!string.IsNullOrWhiteSpace(TextInputValue) && TextPosition != null)
        {
            var textElement = new TextElement
            {
                X = TextPosition.X,
                Y = TextPosition.Y,
                Text = TextInputValue,
                FontSize = FontSize,
                Fill = UseFill ? FillColor : StrokeColor,
                Stroke = StrokeColor,
                StrokeWidth = StrokeWidth > 2 ? 0.5 : 0
            };
            Elements.Add(textElement);
        }
        CloseTextInput();
    }

    // Helper to check if point is on a resize handle
    private string? GetResizeHandleAt(double x, double y)
    {
        if (SelectedElements.Count != 1) return null;
        var b = SelectedElements[0].GetBounds();
        var handleSize = 12; // Slightly larger hit area
        var hs = handleSize / 2.0;

        // Check corners
        if (IsInRect(x, y, b.X - 4 - hs, b.Y - 4 - hs, handleSize, handleSize)) return "nw";
        if (IsInRect(x, y, b.X + b.Width + 4 - hs, b.Y - 4 - hs, handleSize, handleSize)) return "ne";
        if (IsInRect(x, y, b.X - 4 - hs, b.Y + b.Height + 4 - hs, handleSize, handleSize)) return "sw";
        if (IsInRect(x, y, b.X + b.Width + 4 - hs, b.Y + b.Height + 4 - hs, handleSize, handleSize)) return "se";
        // Check edges
        if (IsInRect(x, y, b.X + b.Width / 2 - hs, b.Y - 4 - hs, handleSize, handleSize)) return "n";
        if (IsInRect(x, y, b.X + b.Width / 2 - hs, b.Y + b.Height + 4 - hs, handleSize, handleSize)) return "s";
        if (IsInRect(x, y, b.X - 4 - hs, b.Y + b.Height / 2 - hs, handleSize, handleSize)) return "w";
        if (IsInRect(x, y, b.X + b.Width + 4 - hs, b.Y + b.Height / 2 - hs, handleSize, handleSize)) return "e";
        return null;
    }

    private bool IsInRect(double px, double py, double rx, double ry, double rw, double rh) =>
        px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;

    // Move element by delta
    private void MoveElement(VectorElement el, double dx, double dy)
    {
        switch (el)
        {
            case LineElement line:
                line.X1 += dx; line.Y1 += dy;
                line.X2 += dx; line.Y2 += dy;
                break;
            case PathElement path:
                path.Points = path.Points.Select(p => new Point(p.X + dx, p.Y + dy)).ToList();
                break;
            case RectElement rect:
                rect.X += dx; rect.Y += dy;
                break;
            case CircleElement circle:
                circle.Cx += dx; circle.Cy += dy;
                break;
            case EllipseElement ellipse:
                ellipse.Cx += dx; ellipse.Cy += dy;
                break;
            case TriangleElement tri:
                tri.X1 += dx; tri.Y1 += dy;
                tri.X2 += dx; tri.Y2 += dy;
                tri.X3 += dx; tri.Y3 += dy;
                break;
            case PolygonElement poly:
                poly.Cx += dx; poly.Cy += dy;
                break;
            case StarElement star:
                star.Cx += dx; star.Cy += dy;
                break;
            case ArrowElement arrow:
                arrow.X1 += dx; arrow.Y1 += dy;
                arrow.X2 += dx; arrow.Y2 += dy;
                break;
            case ImageElement img:
                img.X += dx; img.Y += dy;
                break;
            case TextElement txt:
                txt.X += dx; txt.Y += dy;
                break;
        }
    }

    // Resize element based on handle being dragged
    private void ResizeElement(VectorElement el, double mouseX, double mouseY)
    {
        if (DragStart == null || OriginalBounds == null || ResizeHandle == null) return;

        var ob = OriginalBounds;
        var dx = mouseX - DragStart.X;
        var dy = mouseY - DragStart.Y;

        double newX = ob.X, newY = ob.Y, newW = ob.Width, newH = ob.Height;

        // Calculate new bounds based on handle
        switch (ResizeHandle)
        {
            case "nw": newX = ob.X + dx; newY = ob.Y + dy; newW = ob.Width - dx; newH = ob.Height - dy; break;
            case "ne": newY = ob.Y + dy; newW = ob.Width + dx; newH = ob.Height - dy; break;
            case "sw": newX = ob.X + dx; newW = ob.Width - dx; newH = ob.Height + dy; break;
            case "se": newW = ob.Width + dx; newH = ob.Height + dy; break;
            case "n": newY = ob.Y + dy; newH = ob.Height - dy; break;
            case "s": newH = ob.Height + dy; break;
            case "w": newX = ob.X + dx; newW = ob.Width - dx; break;
            case "e": newW = ob.Width + dx; break;
        }

        // Ensure minimum size
        if (newW < 10) { newW = 10; newX = ob.X + ob.Width - 10; }
        if (newH < 10) { newH = 10; newY = ob.Y + ob.Height - 10; }

        // Apply resize based on element type
        switch (el)
        {
            case RectElement rect:
                rect.X = newX; rect.Y = newY; rect.Width = newW; rect.Height = newH;
                break;
            case CircleElement circle:
                circle.Cx = newX + newW / 2; circle.Cy = newY + newH / 2;
                circle.Radius = Math.Min(newW, newH) / 2;
                break;
            case EllipseElement ellipse:
                ellipse.Cx = newX + newW / 2; ellipse.Cy = newY + newH / 2;
                ellipse.Rx = newW / 2; ellipse.Ry = newH / 2;
                break;
            case PolygonElement poly:
                poly.Cx = newX + newW / 2; poly.Cy = newY + newH / 2;
                poly.Radius = Math.Min(newW, newH) / 2;
                break;
            case StarElement star:
                star.Cx = newX + newW / 2; star.Cy = newY + newH / 2;
                star.OuterRadius = Math.Min(newW, newH) / 2;
                star.InnerRadius = star.OuterRadius * 0.4;
                break;
            case ImageElement img:
                img.X = newX; img.Y = newY; img.Width = newW; img.Height = newH;
                break;
            case LineElement line:
                // Scale line endpoints
                var scaleX = newW / Math.Max(ob.Width, 1);
                var scaleY = newH / Math.Max(ob.Height, 1);
                line.X1 = newX + (line.X1 - ob.X) * scaleX;
                line.Y1 = newY + (line.Y1 - ob.Y) * scaleY;
                line.X2 = newX + (line.X2 - ob.X) * scaleX;
                line.Y2 = newY + (line.Y2 - ob.Y) * scaleY;
                break;
            case ArrowElement arrow:
                var aScaleX = newW / Math.Max(ob.Width, 1);
                var aScaleY = newH / Math.Max(ob.Height, 1);
                arrow.X1 = newX + (arrow.X1 - ob.X) * aScaleX;
                arrow.Y1 = newY + (arrow.Y1 - ob.Y) * aScaleY;
                arrow.X2 = newX + (arrow.X2 - ob.X) * aScaleX;
                arrow.Y2 = newY + (arrow.Y2 - ob.Y) * aScaleY;
                break;
            case TriangleElement tri:
                var tScaleX = newW / Math.Max(ob.Width, 1);
                var tScaleY = newH / Math.Max(ob.Height, 1);
                tri.X1 = newX + (tri.X1 - ob.X) * tScaleX;
                tri.Y1 = newY + (tri.Y1 - ob.Y) * tScaleY;
                tri.X2 = newX + (tri.X2 - ob.X) * tScaleX;
                tri.Y2 = newY + (tri.Y2 - ob.Y) * tScaleY;
                tri.X3 = newX + (tri.X3 - ob.X) * tScaleX;
                tri.Y3 = newY + (tri.Y3 - ob.Y) * tScaleY;
                break;
            case PathElement path:
                var pScaleX = newW / Math.Max(ob.Width, 1);
                var pScaleY = newH / Math.Max(ob.Height, 1);
                path.Points = path.Points.Select(p => new Point(
                    newX + (p.X - ob.X) * pScaleX,
                    newY + (p.Y - ob.Y) * pScaleY
                )).ToList();
                break;
            case TextElement txt:
                txt.X = newX; txt.Y = newY + newH; // Text baseline
                txt.FontSize = Math.Max(8, newH * 0.8);
                break;
        }
    }

    // Property panel helpers
    private string GetSelectedStroke() => SelectedElements.FirstOrDefault()?.Stroke ?? "#000000";
    private string GetSelectedFill()
    {
        var fill = SelectedElements.FirstOrDefault()?.Fill ?? "none";
        return fill == "none" ? "#ffffff" : fill;
    }
    private int GetSelectedStrokeWidthIndex()
    {
        var sw = SelectedElements.FirstOrDefault()?.StrokeWidth ?? 2;
        return sw switch { 1 => 0, 2 => 1, 4 => 2, 6 => 3, 8 => 4, 12 => 5, _ => 1 };
    }

    private void OnSelectedStrokeChange(ChangeEventArgs e)
    {
        var color = e.Value?.ToString() ?? "#000000";
        foreach (var el in SelectedElements)
            el.Stroke = color;
    }

    private void OnSelectedStrokeWidthChange(ChangeEventArgs e)
    {
        var index = int.Parse(e.Value?.ToString() ?? "1");
        var width = index switch { 0 => 1.0, 1 => 2.0, 2 => 4.0, 3 => 6.0, 4 => 8.0, 5 => 12.0, _ => 2.0 };
        foreach (var el in SelectedElements)
            el.StrokeWidth = width;
    }

    private void OnSelectedFillChange(ChangeEventArgs e)
    {
        var color = e.Value?.ToString() ?? "#ffffff";
        foreach (var el in SelectedElements)
            el.Fill = color;
    }

    private void ClearSelectedFill()
    {
        foreach (var el in SelectedElements)
            el.Fill = "none";
    }

    private void BringToFront()
    {
        foreach (var el in SelectedElements)
        {
            Elements.Remove(el);
            Elements.Add(el);
        }
    }

    private void SendToBack()
    {
        var toMove = SelectedElements.ToList();
        foreach (var el in toMove)
            Elements.Remove(el);
        Elements.InsertRange(0, toMove);
    }

    private void DuplicateSelected()
    {
        var newElements = new List<VectorElement>();
        foreach (var el in SelectedElements)
        {
            var clone = CloneElement(el);
            if (clone != null)
            {
                MoveElement(clone, 20, 20); // Offset the duplicate
                newElements.Add(clone);
            }
        }
        ClearSelection();
        foreach (var el in newElements)
        {
            Elements.Add(el);
            el.IsSelected = true;
            SelectedElements.Add(el);
        }
    }

    private VectorElement? CloneElement(VectorElement el)
    {
        return el switch
        {
            LineElement line => new LineElement { X1 = line.X1, Y1 = line.Y1, X2 = line.X2, Y2 = line.Y2, Stroke = line.Stroke, StrokeWidth = line.StrokeWidth, Fill = line.Fill },
            PathElement path => new PathElement { Points = path.Points.ToList(), Stroke = path.Stroke, StrokeWidth = path.StrokeWidth, Fill = path.Fill, Pressure = path.Pressure },
            RectElement rect => new RectElement { X = rect.X, Y = rect.Y, Width = rect.Width, Height = rect.Height, Stroke = rect.Stroke, StrokeWidth = rect.StrokeWidth, Fill = rect.Fill },
            CircleElement circle => new CircleElement { Cx = circle.Cx, Cy = circle.Cy, Radius = circle.Radius, Stroke = circle.Stroke, StrokeWidth = circle.StrokeWidth, Fill = circle.Fill },
            EllipseElement ellipse => new EllipseElement { Cx = ellipse.Cx, Cy = ellipse.Cy, Rx = ellipse.Rx, Ry = ellipse.Ry, Stroke = ellipse.Stroke, StrokeWidth = ellipse.StrokeWidth, Fill = ellipse.Fill },
            TriangleElement tri => new TriangleElement { X1 = tri.X1, Y1 = tri.Y1, X2 = tri.X2, Y2 = tri.Y2, X3 = tri.X3, Y3 = tri.Y3, Stroke = tri.Stroke, StrokeWidth = tri.StrokeWidth, Fill = tri.Fill },
            PolygonElement poly => new PolygonElement { Cx = poly.Cx, Cy = poly.Cy, Radius = poly.Radius, Sides = poly.Sides, Stroke = poly.Stroke, StrokeWidth = poly.StrokeWidth, Fill = poly.Fill },
            StarElement star => new StarElement { Cx = star.Cx, Cy = star.Cy, OuterRadius = star.OuterRadius, InnerRadius = star.InnerRadius, Points = star.Points, Stroke = star.Stroke, StrokeWidth = star.StrokeWidth, Fill = star.Fill },
            ArrowElement arrow => new ArrowElement { X1 = arrow.X1, Y1 = arrow.Y1, X2 = arrow.X2, Y2 = arrow.Y2, HeadSize = arrow.HeadSize, Stroke = arrow.Stroke, StrokeWidth = arrow.StrokeWidth, Fill = arrow.Fill },
            ImageElement img => new ImageElement { X = img.X, Y = img.Y, Width = img.Width, Height = img.Height, DataUrl = img.DataUrl, Stroke = img.Stroke, StrokeWidth = img.StrokeWidth, Fill = img.Fill },
            TextElement txt => new TextElement { X = txt.X, Y = txt.Y, Text = txt.Text, FontSize = txt.FontSize, FontFamily = txt.FontFamily, Stroke = txt.Stroke, StrokeWidth = txt.StrokeWidth, Fill = txt.Fill },
            SvgPathElement svgPath => new SvgPathElement { D = svgPath.D, Stroke = svgPath.Stroke, StrokeWidth = svgPath.StrokeWidth, Fill = svgPath.Fill },
            _ => null
        };
    }

    // =====================================================
    // AI Drawing Methods
    // =====================================================
    private void ToggleAiPanel() => ShowAiPanel = !ShowAiPanel;

    private bool ApiKeyTesting = false;
    private string? ApiKeyStatus = null;

    private async Task SaveApiKey()
    {
        if (string.IsNullOrWhiteSpace(ApiKeyInput)) return;

        var key = ApiKeyInput.Trim();
        ApiKeyTesting = true;
        ApiKeyStatus = "Testing key...";
        StateHasChanged();

        var result = await AiService.TestApiKeyAsync(key);

        if (result.Success)
        {
            AiService.ApiKey = key;
            ApiKeyInput = "";
            ApiKeyStatus = "Key valid!";
        }
        else
        {
            ApiKeyStatus = result.Error ?? "Invalid key";
        }

        ApiKeyTesting = false;
        StateHasChanged();

        // Clear success status after 3 seconds
        if (result.Success)
        {
            await Task.Delay(3000);
            if (ApiKeyStatus == "Key valid!")
            {
                ApiKeyStatus = null;
                StateHasChanged();
            }
        }
    }

    private void ClearApiKey()
    {
        AiService.ApiKey = null;
        AiError = null;
        AiThinking = null;
        AiResult = null;
    }

    private async Task GenerateFromAi()
    {
        if (string.IsNullOrWhiteSpace(AiPrompt) || AiGenerating) return;

        // Only require API key for Anthropic
        if (AiService.Provider == AiProvider.Anthropic && string.IsNullOrEmpty(AiService.ApiKey)) return;

        AiGenerating = true;
        AiError = null;
        AiThinking = null;
        AiResult = null;
        StateHasChanged();

        try
        {
            // Clear canvas if option is checked
            if (AiClearBeforeGenerate)
            {
                Elements.Clear();
                ClearSelection();
            }

            var result = await AiService.GenerateAsync(AiPrompt);

            if (!result.Success)
            {
                AiError = result.Error;
                return;
            }

            AiThinking = result.Thinking;

            if (result.Response?.Commands != null && result.Response.Commands.Count > 0)
            {
                AiResult = ExecuteCommands(result.Response.Commands);
                if (!AiResult.Success)
                {
                    AiError = AiResult.Error;
                }
            }
            else
            {
                AiError = "No drawing commands returned";
            }
        }
        catch (Exception ex)
        {
            AiError = $"Error: {ex.Message}";
        }
        finally
        {
            AiGenerating = false;
            StateHasChanged();
        }
    }

    // =====================================================
    // Command Execution API
    // =====================================================
    private readonly CommandExecutor _commandExecutor = new();
    private string _canvasFill = "white";

    /// <summary>
    /// Execute a list of draw commands programmatically.
    /// </summary>
    public CommandResult ExecuteCommands(List<DrawCommand> commands)
    {
        var width = (double)CanvasWidth;
        var height = (double)CanvasHeight;
        var result = _commandExecutor.Execute(commands, Elements, ref width, ref height, ref _canvasFill);
        CanvasWidth = (int)width;
        CanvasHeight = (int)height;
        StateHasChanged();
        return result;
    }

    /// <summary>
    /// Execute a JSON drawing response string.
    /// </summary>
    public CommandResult ExecuteJson(string json)
    {
        var width = (double)CanvasWidth;
        var height = (double)CanvasHeight;
        var result = _commandExecutor.ExecuteJson(json, Elements, ref width, ref height, ref _canvasFill);
        CanvasWidth = (int)width;
        CanvasHeight = (int)height;
        StateHasChanged();
        return result;
    }

    /// <summary>
    /// Execute a single draw command.
    /// </summary>
    public CommandResult ExecuteCommand(DrawCommand command)
    {
        return ExecuteCommands(new List<DrawCommand> { command });
    }

    /// <summary>
    /// Get current canvas state as a list of elements for serialization.
    /// </summary>
    public IReadOnlyList<VectorElement> GetElements() => Elements.AsReadOnly();

    /// <summary>
    /// Get canvas dimensions.
    /// </summary>
    public (int Width, int Height) GetCanvasSize() => (CanvasWidth, CanvasHeight);

    /// <summary>
    /// Get element by ID.
    /// </summary>
    public VectorElement? GetElementById(string id) => Elements.FirstOrDefault(e => e.Id == id);
}
